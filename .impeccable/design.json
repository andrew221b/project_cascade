  "components": [
    {
      "name": "Drop / Deliver",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Reference-size uGUI panel translation. State fills resolve the native ColorBlock multiplication; the native selected state has no custom focus ring.",
      "html": "<button class=\"ds-drop\">Drop</button>",
      "css": ".ds-drop{font-family:'Balsamiq Sans',sans-serif;font-size:18px;font-weight:700;color:rgb(16% 28% 29%);background:rgb(98% 74% 32%);border:0;border-radius:13px;padding:2px 3px;min-height:48px;min-width:96px;cursor:pointer;} .ds-drop:hover{background:rgb(98% 69.56% 24.96%);} .ds-drop:focus-visible{background:rgb(98% 74% 32%);outline:none;} .ds-drop:active{background:rgb(80.36% 65.12% 25.92%);} .ds-drop:disabled{background:rgb(86.24% 66.6% 26.88% / 70%);cursor:default;}"
    },
    {
      "name": "Utility action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Reference-size uGUI panel translation. State fills resolve the native ColorBlock multiplication; the native selected state has no custom focus ring.",
      "html": "<button class=\"ds-utility\">Hint</button>",
      "css": ".ds-utility{font-family:'Balsamiq Sans',sans-serif;font-size:18px;font-weight:700;color:rgb(16% 28% 29%);background:rgb(100% 96% 84%);border:0;border-radius:13px;padding:2px 3px;min-height:48px;min-width:96px;cursor:pointer;} .ds-utility:hover{background:rgb(100% 90.24% 65.52%);} .ds-utility:focus-visible{background:rgb(100% 96% 84%);outline:none;} .ds-utility:active{background:rgb(82% 84.48% 68.04%);} .ds-utility:disabled{background:rgb(88% 86.4% 70.56% / 70%);cursor:default;}"
    },
    {
      "name": "Precision focus direction",
      "kind": "button",
      "refersTo": "button-direction",
      "description": "Authored ChevronGraphic polygon; mirror the path for previous focus. This is geometry, not a font glyph.",
      "html": "<button class=\"ds-direction\" aria-label=\"Focus next\"><svg viewBox=\"0 0 100 100\" aria-hidden=\"true\"><path d=\"M34 24 L42 17 L72 50 L42 83 L34 76 L58 50 Z\"/></svg></button>",
      "css": ".ds-direction{background:rgb(100% 96% 84%);border:0;border-radius:13px;width:58px;height:48px;padding:0;color:rgb(16% 28% 29%);cursor:pointer;} .ds-direction svg{width:44%;height:60%;fill:currentColor;} .ds-direction:hover{background:rgb(100% 90.24% 65.52%);} .ds-direction:focus-visible{background:rgb(100% 96% 84%);outline:none;} .ds-direction:active{background:rgb(82% 84.48% 68.04%);}"
    },
    {
      "name": "Letter token and selected face",
      "kind": "custom",
      "refersTo": "letter-token",
      "description": "Flat diagram of the shared ivory tile and live Bold letter. The selected example places its body and glyph together inside a gold frame; native meshes supply the bevel.",
      "html": "<div class=\"ds-letter-set\"><span class=\"ds-letter\">A</span><span class=\"ds-letter-selected\"><span class=\"ds-letter\">A</span></span></div>",
      "css": ".ds-letter-set{display:flex;align-items:end;gap:18px;height:62px;} .ds-letter{font-family:'Balsamiq Sans',sans-serif;font-size:28px;font-weight:700;color:rgb(16% 28% 29%);display:flex;align-items:center;justify-content:center;background:#FFF0CC;width:48px;height:48px;border-radius:8.64px;} .ds-letter-selected{display:block;background:#EFB953;padding:4px;border-radius:10px;transform:translateY(-5px);}"
    },
    {
      "name": "Shape identity",
      "kind": "custom",
      "refersTo": "shape-token",
      "description": "Flat front-face sample of the actual rounded-triangle contour and its material input. The Unity extrusion and lighting are intentionally not simulated by new CSS effects.",
      "html": "<svg class=\"ds-shape\" viewBox=\"0 0 100 100\" role=\"img\" aria-label=\"Yellow triangle\"><path d=\"M56.480 15.360 L54.320 12.093 L52.160 10.133 L50.000 9.480 L47.840 10.133 L45.680 12.093 L43.520 15.360 L13.280 70.240 L11.660 73.833 L11.120 76.773 L11.660 79.060 L13.280 80.693 L15.980 81.673 L19.760 82.000 L80.240 82.000 L84.020 81.673 L86.720 80.693 L88.340 79.060 L88.880 76.773 L88.340 73.833 L86.720 70.240 Z\"/></svg>",
      "css": ".ds-shape{display:block;width:72px;height:72px;fill:#FFC856;}"
    },
    {
      "name": "Compact mint platform",
      "kind": "custom",
      "refersTo": "platform",
      "description": "Flat assembly diagram: thin mint support, ivory top edge and gold end caps. Native meshes provide depth and contact shading.",
      "html": "<div class=\"ds-platform\"><span class=\"ds-platform-rail\"></span><span class=\"ds-platform-cap ds-platform-cap-left\"></span><span class=\"ds-platform-cap ds-platform-cap-right\"></span></div>",
      "css": ".ds-platform{position:relative;width:220px;height:19px;background:#53AE9E;border-radius:6px;} .ds-platform-rail{position:absolute;left:3%;right:3%;top:0;height:4.5px;background:#FFF0CC;border-radius:2px;} .ds-platform-cap{position:absolute;width:10px;height:10px;top:4px;border-radius:50%;background:#EFB953;} .ds-platform-cap-left{left:1%;} .ds-platform-cap-right{right:1%;}"
    },
    {
      "name": "Stable receiving cradle",
      "kind": "custom",
      "refersTo": "receiver",
      "description": "Flat diagram of the gold rim, ivory inset, sockets and shared symbols. Three symbols are shown only as a component sample; the native layout fits the complete target.",
      "html": "<div class=\"ds-receiver-wrap\"><div class=\"ds-receiver-label\">Deliver this order</div><div class=\"ds-receiver\"><svg viewBox=\"0 0 100 100\" role=\"img\" aria-label=\"Triangle\"><path d=\"M56.480 15.360 L54.320 12.093 L52.160 10.133 L50.000 9.480 L47.840 10.133 L45.680 12.093 L43.520 15.360 L13.280 70.240 L11.660 73.833 L11.120 76.773 L11.660 79.060 L13.280 80.693 L15.980 81.673 L19.760 82.000 L80.240 82.000 L84.020 81.673 L86.720 80.693 L88.340 79.060 L88.880 76.773 L88.340 73.833 L86.720 70.240 Z\" fill=\"#FFC856\"/></svg><svg viewBox=\"0 0 100 100\" role=\"img\" aria-label=\"Circle\"><circle cx=\"50\" cy=\"50\" r=\"35\" fill=\"#59CAB1\"/></svg><span class=\"ds-receiver-letter\">A</span></div></div>",
      "css": ".ds-receiver-wrap{width:250px;} .ds-receiver-label{font-family:'Balsamiq Sans',sans-serif;font-size:16px;font-weight:700;text-align:center;color:rgb(16% 28% 29%);margin-bottom:4px;} .ds-receiver{display:flex;justify-content:center;gap:3px;background:#FBE2A3;border:8px solid #EFB953;border-radius:18px;padding:8px;} .ds-receiver svg,.ds-receiver-letter{width:50px;height:50px;background:#EFB953;border-radius:9px;} .ds-receiver-letter{font-family:'Balsamiq Sans',sans-serif;font-size:24px;font-weight:700;color:rgb(16% 28% 29%);display:flex;align-items:center;justify-content:center;background:#FFF0CC;border:3px solid #EFB953;}"
    },
    {
      "name": "Exact-order magnifier",
      "kind": "custom",
      "refersTo": "target-zoom",
      "description": "Static preview of the implemented inspection surface. Native symbols occupy a four-column grid with position numbers; the close control returns to play.",
      "html": "<div class=\"ds-zoom\"><p class=\"ds-zoom-title\">Deliver this exact order</p><div class=\"ds-zoom-row\"><div><strong>P</strong><small>1</small></div><div><strong>L</strong><small>2</small></div><div><strong>A</strong><small>3</small></div><div><strong>N</strong><small>4</small></div></div><button class=\"ds-zoom-close\">Close target</button></div>",
