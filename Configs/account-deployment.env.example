# Deployment computer only. Never include these credentials in Unity Resources or a player build.
# Create a Unity service account with permission to deploy this project's Cloud Code modules.
UGS_CLI_SERVICE_KEY_ID=
UGS_CLI_SERVICE_SECRET_KEY=
# Optional paths if these executables are not on PATH:
CASCADE_DOTNET=
CASCADE_UGS=
# Receipt-verifier secrets are configured separately in Unity Secret Manager:
# CASCADE_RECEIPT_VERIFIER_URL
# CASCADE_RECEIPT_VERIFIER_TOKEN
# Apple private key and Google service-account JSON stay on Backend/ReceiptVerifier's server.
