    m_Key: From stop {0} to stop {1}
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626537
    m_Key: Travel bag
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626538
    m_Key: Mend a board, then bring the row home.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626539
    m_Key: Use a bridge and finish two different puzzles.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626540
    m_Key: Bring home stamps from three different puzzles.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626541
    m_Key: A friend's request
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626542
    m_Key: Thank you! You helped.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626543
    m_Key: 'Done: {0} / {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626544
    m_Key: Try a puzzle
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626545
    m_Key: A little piece of home
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626546
    m_Key: A parcel for Mika
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626547
    m_Key: 'Inside: a part for {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626548
    m_Key: Your gift is ready!
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626549
    m_Key: You earned this with three new lights.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626550
    m_Key: Keep going
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626551
