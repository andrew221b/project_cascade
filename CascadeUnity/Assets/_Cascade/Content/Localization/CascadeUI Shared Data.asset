    m_Key: You made it!
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626526
    m_Key: 'Parts found: {0} / 3'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626527
    m_Key: A little keepsake for Mika.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626528
    m_Key: Three parts make this gift.
    m_Metadata:
      m_Items: []
