    m_Metadata:
      m_Items: []
  - m_Id: 24216299626552
    m_Key: Stamp trail {0}
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626553
    m_Key: Bring the row home with its stamp.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626554
    m_Key: This is an extra challenge. Your path stays open.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626555
    m_Key: Try this trail
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626556
    m_Key: Your own best paths.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626557
    m_Key: Finish a puzzle to leave a note here.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626558
    m_Key: A note from an earlier journey.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626559
