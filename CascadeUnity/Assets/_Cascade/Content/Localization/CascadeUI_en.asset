    m_Localized: The small row shows how the next board moves your pieces.
    m_Metadata:
      m_Items: []
  - m_Id: 510273457741824
    m_Localized: Tools
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936128
    m_Localized: My tools
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936129
    m_Localized: Wayfinder scroll
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936130
    m_Localized: Undo spool
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936131
    m_Localized: Return hourglass
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936132
    m_Localized: Hints one move per stage.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936133
    m_Localized: Extra undo on this board after 2 free ones.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936134
    m_Localized: Restores last broken board once per stage.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936135
    m_Localized: Pick up to two tools per stage. Each works once.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936136
    m_Localized: Wear it on the map. Earn it in parcels too.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936137
    m_Localized: 'Bag: {0} / {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936138
    m_Localized: Already yours
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936139
    m_Localized: Yours forever. No gameplay advantage.
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936140
    m_Localized: "Checking the route\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936141
    m_Localized: Use one
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936142
    m_Localized: 'Buy: {0} coins'
    m_Metadata:
      m_Items: []
  - m_Id: 510273461936143
    m_Localized: Need {0} more coins
    m_Metadata:
      m_Items: []
