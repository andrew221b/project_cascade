    m_Metadata:
      m_Items: []
  - m_Id: 24216299626517
    m_Localized: 'Visits: {0} / 7

      Come back when you like.'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626518
    m_Localized: Every trophy part is found!
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626519
    m_Localized: 'New lights for a parcel: {0} / 3'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626520
    m_Localized: Open parcel
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626521
