    m_Metadata:
      m_Items: []
  - m_Id: 542516125360135
    m_Localized: Watch to the end for 40 coins.
    m_Metadata:
      m_Items: []
  - m_Id: 542516125360136
    m_Localized: A short break between levels.
    m_Metadata:
      m_Items: []
  - m_Id: 542516125360137
    m_Localized: Collect coins
    m_Metadata:
      m_Items: []
  - m_Id: 542516125360138
