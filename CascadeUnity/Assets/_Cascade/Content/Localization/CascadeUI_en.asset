    m_Metadata:
      m_Items: []
  - m_Id: 542516125360139
    m_Localized: '{0} seconds'
    m_Metadata:
      m_Items: []
  - m_Id: 542516125360140
    m_Localized: 40 coins added
    m_Metadata:
      m_Items: []
