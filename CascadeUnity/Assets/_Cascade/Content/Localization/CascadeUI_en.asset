    m_Metadata:
      m_Items: []
  - m_Id: 24216299626509
    m_Localized: Restore three lights to open your journal.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626510
    m_Localized: Small things for a long road.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626511
