  - m_Id: 24216299626525
    m_Localized: You made it!
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626526
    m_Localized: 'Parts found: {0} / 3'
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626527
    m_Localized: A little trophy for Rin.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626528
    m_Localized: Three parts make this trophy.
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626529
    m_Localized: With Rin
    m_Metadata:
      m_Items: []
  - m_Id: 24216299626530
