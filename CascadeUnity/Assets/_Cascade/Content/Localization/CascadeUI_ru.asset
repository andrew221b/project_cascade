  - m_Id: 472899696
    m_Localized: "\u0410\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 472899697
    m_Localized: "\u0420\u0443\u0441\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 472899698
    m_Localized: "\u0423\u043A\u0440\u0430\u0438\u043D\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 472899699
    m_Localized: "\u042F\u0437\u044B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 472899700
    m_Localized: "\u042F\u0437\u044B\u043A \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 472899701
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u0432 \u043D\u043E\u0432\u044B\u0445
      \u0437\u0430\u0434\u0430\u0447\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 472899702
    m_Localized: "\u0421\u043C\u0435\u043D\u0438\u0442\u044C \u044F\u0437\u044B\u043A
      \u0441\u043B\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 472899703
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438:
      {0}. \u042D\u0442\u043E\u0442 \u0440\u044F\u0434 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 472899704
    m_Localized: "\u0414\u043B\u044F \u043D\u043E\u0432\u044B\u0445 \u0437\u0430\u0434\u0430\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 472899705
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043A
      \u0431\u044B\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 472899706
    m_Localized: "\u0423\u0440\u043E\u043A \u0441 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 472899707
    m_Localized: "26 \u2014 \u0443\u0440\u043E\u043A \u0441 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438.\n\u0421\u043E
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 472899708
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043E\u0431\u043C\u0435\u043D\u0430
      \u0434\u043E\u0441\u043A\u0430 \u0441\u043B\u0430\u0431\u0435\u0435\u0442.
      \u041D\u0430 \u043D\u0443\u043B\u0435 \u043E\u043D\u0430 \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F.
      \u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u0412\u043D\u0438\u0437\xBB \u043E\u043F\u0443\u0441\u0442\u0438\u0442
      \u0440\u044F\u0434 \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899709
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435 \u0440\u043E\u043B\u0438\u043A\u0438
      \u0441\u0434\u0432\u0438\u043D\u0443\u0442 \u0432\u0435\u0441\u044C \u0440\u044F\u0434.
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899710
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043D\u0430 \u0431\u043E\u043C\u0431\u0443
      \u2014 \u043E\u043D\u0430 \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
      \u0447\u0438\u0441\u043B\u043E. \u041D\u0430 \u043D\u0443\u043B\u0435 \u0431\u043E\u043C\u0431\u0430
      \u0441\u043B\u043E\u043C\u0430\u0435\u0442 \u0434\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899711
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043D\u0430 \u043A\u043B\u044E\u0447.
      \u041F\u0440\u043E\u0445\u043E\u0434 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C \u0444\u0438\u0433\u0443\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472899712
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0443.
      \u041E\u043D\u0430 \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u043E\u0447\u0438\u043D\u0438\u0442
      \u0434\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899713
    m_Localized: "\u0423 \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0434\u043E\u0441\u043A\u0430
      \u0441\u043B\u0430\u0431\u0435\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C \u0447\u0438\u0441\u043B\u043E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899714
    m_Localized: "\u0414\u0432\u0435 \u043F\u0430\u0440\u044B \u0441\u0432\u044F\u0437\u0430\u043D\u044B.
      \u041F\u043E\u043C\u0435\u043D\u044F\u0439 \u043E\u0434\u043D\u0443 \u043F\u0430\u0440\u0443
      \u2014 \u0432\u0442\u043E\u0440\u0430\u044F \u0442\u043E\u0436\u0435 \u043F\u043E\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 472899715
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u043C\u043E\u0441\u0442 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C \u0444\u0438\u0433\u0443\u0440\u043A\u0438
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437. \u041F\u043E\u0442\u043E\u043C
      \u043E\u043D \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 472899716
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043D\u0430 \u043C\u0430\u0440\u043A\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0435\u0451.
      \u0414\u043E \u0446\u0435\u043B\u0438 \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0439\u0442\u0438
      \u0438 \u0431\u0435\u0437 \u043C\u0430\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472899717
    m_Localized: "\u041E\u043D\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0434\u0440\u0443\u0433\u0443\u044E
      \u043F\u0430\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899718
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u043E. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0438\u043B\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 472899719
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043A \u043A\u043B\u044E\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899720
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043A \u0431\u043E\u043C\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899721
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043A \u043A\u043B\u044E\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899722
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u0434\u0435\u0442\u0430\u043B\u044C \u043A \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899723
    m_Localized: "\u042D\u0442\u0438 \u0434\u0432\u0435 \u043F\u0430\u0440\u044B
      \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899724
    m_Localized: "\u041C\u043E\u0441\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0442\u0438
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 472899725
    m_Localized: "\u0421\u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0435\u0449\u0451 \u0438 \u043C\u0430\u0440\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 472899726
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E! \u0423
      \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0434\u043E\u0441\u043A\u0430 \u0441\u043B\u0430\u0431\u0435\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899727
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0434\u043E\u0441\u043A\u0430
      \u0441\u0434\u0432\u0438\u043D\u0435\u0442 \u0440\u044F\u0434. \u0421\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899728
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \xAB\u0412\u043D\u0438\u0437\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 472899729
    m_Localized: "\u041D\u0430 \u043D\u0443\u043B\u0435 \u0434\u043E\u0441\u043A\u0430
      \u0441\u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F, \u0438 \u0440\u044F\u0434
      \u0443\u043F\u0430\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 472899730
    m_Localized: "\u0422\u044F\u043D\u0438 \u0434\u0435\u0442\u0430\u043B\u044C \u043A
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 472899731
    m_Localized: "\u0420\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 472899732
    m_Localized: "\u0411\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 472899733
    m_Localized: "\u0420\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899734
    m_Localized: "\u0412\u0435\u0442\u0440\u044F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 472899735
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0411\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899736
    m_Localized: "\u0421\u0430\u0434 \u0420\u043E\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 472899737
    m_Localized: "\u0417\u0430\u0436\u0435\u0447\u044C \u043F\u0435\u0440\u0432\u044B\u0439
      \u043D\u0438\u0436\u043D\u0438\u0439 \u0444\u043E\u043D\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 472899738
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0432\u0435\u0442
      \u0432\u0435\u0442\u0440\u043E\u0432\u044B\u043C \u0432\u043E\u0440\u043E\u0442\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 472899739
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0435\u043B\u0435
      \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899740
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0438 \u0411\u0435\u043D\u0443 \u0441
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 472899741
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u043E\u0434\u0443
      \u0432 \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u0440\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 472899742
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443
      \u0434\u043B\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u043B\u043E\u0434\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 472899743
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u043E\u0433\u043D\u0438 \u0432
      \u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 472899744
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439 \u043F\u0443\u0442\u044C \u043A
      \u043C\u0430\u044F\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 472899745
    m_Localized: "\u0411\u0443\u0440\u044F \u0443\u043D\u0435\u0441\u043B\u0430 \u043D\u0430\u0448\u0438
      \u043E\u0433\u043D\u0438. \u042F \u043E\u0442\u043D\u0435\u0441\u0443 \u043D\u043E\u0432\u044B\u0439
      \u043E\u0433\u043E\u043D\u0451\u043A \u043A \u043C\u0430\u044F\u043A\u0443
      \u0410\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 472899746
    m_Localized: "\u041A\u0430\u043A\u043E\u0439 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043C\u043E\u0441\u0442... \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0448\u0430\u0433, \u0420\u0438\u043D. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043E\u0431\u0435\u0440\u0451\u043C \u0435\u0433\u043E \u0443\u0437\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 472899747
    m_Localized: "\u041E\u0434\u0438\u043D \u043E\u0433\u043E\u043D\u0451\u043A \u0443\u0436\u0435
      \u0433\u043E\u0440\u0438\u0442! \u0422\u0435\u043F\u0435\u0440\u044C \u044F
      \u0432\u0438\u0436\u0443 \u0432\u0435\u0442\u0440\u043E\u0432\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 472899748
    m_Localized: "\u042D\u0442\u0438 \u0434\u043E\u0441\u043A\u0438 \u0441\u0434\u0432\u0438\u0433\u0430\u044E\u0442
      \u0440\u044F\u0434 \u043F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E,
      \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u044B\u0433\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899749
    m_Localized: "\u041C\u043E\u0439 \u0448\u0430\u0440\u0444 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0441\u044F
      \u0438 \u043F\u043E\u0440\u0432\u0430\u043B\u0441\u044F. \u041D\u0438\u0447\u0435\u0433\u043E,
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899750
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u043E\u043C\u0443 \u043B\u0438\u0444\u0442\u0443
      \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0430.
      \u041F\u043E\u0447\u0438\u043D\u0438\u043C \u0435\u0433\u043E \u0438 \u0434\u043E\u0431\u0435\u0440\u0451\u043C\u0441\u044F
      \u0434\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 472899751
    m_Localized: "\u042F \u0411\u0435\u043D. \u041C\u043E\u044F \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0432\u0441\u0442\u0430\u043B\u0430, \u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u043D\u0443\u0436\u043D\u0430 \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 472899752
    m_Localized: "\u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u0435\u0451 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C?
      \u0412\u043C\u0435\u0441\u0442\u0435 \u043C\u044B \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 472899753
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F!
      \u0421\u043B\u044B\u0448\u0438\u0448\u044C, \u043A\u0430\u043A \u0442\u0435\u0447\u0451\u0442
      \u0432\u043E\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 472899754
    m_Localized: "\u041D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0434\u043E\u0441\u043A\u0430\u0445 \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u0415\u0441\u043B\u0438 \u043C\u043E\u0436\u0435\u0448\u044C, \u0432\u044B\u0431\u0438\u0440\u0430\u0439
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 472899755
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043F\u043B\u044B\u0432\u0451\u0442. \u0423
      \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u043E
      \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0439 \u0431\u0430\u0431\u0443\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472899756
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438 \u0435\u0433\u043E. \u0411\u0430\u0431\u0443\u0448\u043A\u0430
      \u043E\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
      \u0443 \u043D\u0430\u0441 \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 472899757
    m_Localized: "\u042F \u0420\u043E\u0437\u0430. \u0412 \u043C\u043E\u0451\u043C
      \u0441\u0430\u0434\u0443 \u0440\u0430\u0441\u0442\u0443\u0442 \u043F\u043B\u043E\u0434\u044B-\u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0438.
      \u041D\u043E\u0447\u044C\u044E \u043E\u043D\u0438 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 472899758
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0438 \u0437\u0430\u0436\u0435\u0447\u044C
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F. \u0410 \u043F\u043E \u043F\u0443\u0442\u0438
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043D\u0430\u0439\u0442\u0438
      \u043C\u0430\u0440\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899759
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u0420\u0438\u043D. \u041C\u0430\u044F\u043A
      \u0437\u0430 \u0442\u0435\u043C\u0438 \u043E\u0431\u043B\u0430\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472899760
    m_Localized: "\u0422\u044B \u043F\u043E\u043C\u043E\u0433 \u043D\u0430\u043C
      \u0441\u043D\u043E\u0432\u0430 \u0431\u044B\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u043F\u043E\u043C\u043E\u0436\u0435\u043C
      \u0442\u0435\u0431\u0435 \u0434\u043E\u0439\u0442\u0438 \u0434\u043E \u043C\u0430\u044F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4696902197248
    m_Localized: "\u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12135563255808
    m_Localized: "\u0422\u0432\u043E\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450112
    m_Localized: "\u041C\u044B \u043D\u0430\u0448\u043B\u0438 \u043A\u043E\u043F\u0438\u044E
      \u043F\u0443\u0442\u0438. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0445\u043E\u0434 \u043C\u043E\u0433 \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450113
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u044D\u0442\u0443 \u0437\u0430\u0434\u0430\u0447\u0443. \u0422\u0432\u043E\u0438
      \u043E\u0433\u043D\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B.
      \u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450114
    m_Localized: "\u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043F\u0443\u0442\u0438
      \u043D\u0443\u0436\u043D\u0430 \u043D\u043E\u0432\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
      \u0438\u0433\u0440\u044B. \u041E\u0431\u043D\u043E\u0432\u0438 CASCADE."
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450115
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0442\u0432\u043E\u0439 \u043F\u0443\u0442\u044C. \u041C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450116
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E
      \u0437\u0430\u0434\u0430\u0447\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 12135567450117
