      m_Items: []
  - m_Id: 49797250670602
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0443 \u0444\u043E\u043D\u0430\u0440\u0435\u0439
      \u043D\u0443\u0436\u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670603
    m_Localized: "\u042F \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043E\u0441\u043E\u043A. \u0418 \u044D\u0442\u0443 \u0441\u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670604
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670605
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0438\u0434\u0451\u0442 \u043E\u0434\u0438\u043D \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670606
    m_Localized: "\u042F \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430 \u043D\u0430\u0448
      \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670607
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670608
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430, \u044F \u043D\u0435\u0441\u0443
      \u0441\u0432\u0435\u0442 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670609
    m_Localized: "\u041C\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u043D\u0430\u0448\u043B\u0438
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670610
    m_Localized: "\u041F\u043E\u0447\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670611
    m_Localized: "\u041F\u0440\u0438\u0447\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670612
    m_Localized: "\u0410\u0440\u0445\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670613
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670614
    m_Localized: "\u041C\u0430\u044F\u043A \u0410\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670615
    m_Localized: "\u041D\u0430\u0448 \u043E\u0433\u043E\u043D\u0451\u043A \u0434\u043E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670616
    m_Localized: "\u041C\u0430\u044F\u043A \u0437\u0430\u0436\u0436\u0451\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670617
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u043D\u0430\u0448
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670618
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u0437\u0430 \u044D\u0442\u043E\u0442
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670619
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u0435\u0439 \u043F\u0443\u0442\u0438:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670620
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u043C\u0435\u043D
      \u0442\u0440\u0430\u0442\u0438\u0442 \u0442\u043E\u0447\u043A\u0443. \u041D\u0435\u0442
      \u0442\u043E\u0447\u0435\u043A? \u0420\u044F\u0434 \u043F\u0430\u0434\u0430\u0435\u0442.
      \u0412\u043D\u0438\u0437 \u2014 \u0443\u0439\u0442\u0438 \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670621
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u043A\u0438 \u0434\u0432\u0438\u0433\u0430\u044E\u0442
      \u0432\u0435\u0441\u044C \u0440\u044F\u0434 \u043F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670622
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u043D\u0430 \u0431\u043E\u043C\u0431\u0443. \u0425\u043E\u0434 \u0442\u0440\u0430\u0442\u0438\u0442
      \u0438\u0441\u043A\u0440\u0443. \u041D\u0435\u0442 \u0438\u0441\u043A\u0440?
      \u0414\u043E\u0441\u043A\u0430 \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864896
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u043D\u0430 \u043A\u043B\u044E\u0447 \u2014 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864897
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0443. \u041E\u043D\u0430
      \u043F\u043E\u0447\u0438\u043D\u0438\u0442 \u0434\u043E\u0441\u043A\u0443 \u043E\u0434\u0438\u043D
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864898
    m_Localized: "\u0422\u0440\u0435\u0449\u0438\u043D\u0430 \u0442\u0440\u0430\u0442\u0438\u0442
      \u043B\u0438\u0448\u043D\u044E\u044E \u0442\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864899
    m_Localized: "\u041F\u043E\u043C\u0435\u043D\u044F\u0439 \u043E\u0434\u043D\u0443
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u0443\u044E \u043F\u0430\u0440\u0443.
      \u041F\u043E\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043E\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864900
    m_Localized: "\u042D\u0442\u043E\u0442 \u043C\u043E\u0441\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437. \u041F\u043E\u0442\u043E\u043C
      \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864901
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u0443 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u043D\u0430 \u043F\u0435\u0447\u0430\u0442\u044C. \u0414\u043E\u0441\u0442\u0430\u0432\u044C
      \u0440\u044F\u0434 \u0434\u043E\u043C\u043E\u0439 \u2014 \u043F\u0435\u0447\u0430\u0442\u044C
      \u0442\u0432\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864902
    m_Localized: "\u0414\u043E\u0441\u043A\u0430 \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 49797254864903
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u043C\u0430\u044F\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 77866548060160
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0420\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837376
    m_Localized: "\u0427\u0442\u043E \u0441\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u043C?
      \u0427\u0442\u043E \u0432\u043E\u0437\u044C\u043C\u0451\u043C \u0441 \u0441\u043E\u0431\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837377
    m_Localized: "\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F \u043B\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837378
    m_Localized: "\u041E\u0434\u043D\u0430 \u043B\u0435\u043D\u0442\u0430 \u2014
      \u043E\u0431\u043C\u0435\u043D \u0447\u0435\u0440\u0435\u0437 \u043E\u0434\u043D\u0443
      \u0438\u043B\u0438 \u0434\u0432\u0435 \u0444\u0438\u0433\u0443\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837379
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 \u0441 \u043B\u0435\u043D\u0442\u043E\u0439
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837380
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u0444\u0438\u0433\u0443\u0440\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E.
      \u041B\u0435\u043D\u0442\u0430 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437. \u041E\u0442\u043C\u0435\u043D\u0430
      \u0432\u0435\u0440\u043D\u0451\u0442 \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837381
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E \u0444\u0438\u0433\u0443\u0440\u0443.
      \u041B\u0435\u043D\u0442\u0430 \u043D\u0430 \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837382
    m_Localized: "\u041B\u0435\u043D\u0442\u0430 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u0430.
      \u0421\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u0444\u0438\u0433\u0443\u0440\u044B
      \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837383
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0441\u043A\u0443. \u041C\u0435\u0442\u043A\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438
      \u2014 \u0434\u043E\u0441\u043A\u0430 \u0441\u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F.
      \u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u0412\u043D\u0438\u0437\xBB \u0441\u043F\u0443\u0441\u0442\u0438\u0442
      \u0440\u044F\u0434 \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 77866564837384
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0443 \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 96949670764544
    m_Localized: "\u0414\u043E\u0441\u043A\u0430: {0} \u0445\u043E\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958848
    m_Localized: "{0} \u0445\u043E\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958849
    m_Localized: "\u041E\u0431\u0435\u0437\u0432\u0440\u0435\u0436\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958850
    m_Localized: "\u0412\u0437\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958851
    m_Localized: "\u0412 \u0442\u0432\u043E\u0435\u0439 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958852
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u043E\u0431\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958853
    m_Localized: "\u041F\u0430\u0443\u0437\u0430 \u0431\u043E\u043C\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958854
    m_Localized: "\u041F\u0430\u0443\u0437\u0430: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958855
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435:
      \u0440\u044F\u0434 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958856
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435:
      \u0441\u0434\u0432\u0438\u0433 \u0432\u043B\u0435\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958857
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435:
      \u0441\u0434\u0432\u0438\u0433 \u0432\u043F\u0440\u0430\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958858
    m_Localized: "\u0412\u044B \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958859
    m_Localized: "\u041A\u0430\u0442\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958860
    m_Localized: "\u041F\u0435\u0441\u043E\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958861
    m_Localized: "\u041F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958862
    m_Localized: "\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435
      \u0432\u0435\u0449\u0438 \u0438 \u043D\u0430\u0439\u0434\u0438 \u043F\u0443\u0442\u044C
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958863
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u043C\u0435\u043D
      \u0442\u0440\u0430\u0442\u0438\u0442 \u0445\u043E\u0434. \u041D\u0430 \u043D\u0443\u043B\u0435
      \u0434\u043E\u0441\u043A\u0430 \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F.
      \u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F\xBB
      \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0451\u0442 \u0440\u044F\u0434 \u0432\u043D\u0438\u0437
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958864
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435 \u044D\u0442\u0430
      \u0434\u043E\u0441\u043A\u0430 \u0441\u0434\u0432\u0438\u043D\u0435\u0442 \u0438\u043B\u0438
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0451\u0442 \u0432\u0435\u0441\u044C
      \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 96949674958865
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0430\u0434 \u0431\u043E\u043C\u0431\u043E\u0439
      \u0435\u0451 \u0444\u0438\u0433\u0443\u0440\u0443 \u2014 \u0438 \u0444\u0438\u0442\u0438\u043B\u044C
      \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
