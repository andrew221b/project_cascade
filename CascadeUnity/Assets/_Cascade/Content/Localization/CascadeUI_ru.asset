      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u0432\u0435\u0440\u043D\u0443\u043B \u043A\u0430\u043D\u0430\u0442
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362913
    m_Localized: "\u041F\u043E\u0440\u044B\u0432 \u043C\u0435\u043D\u044F\u0435\u0442
      \u0440\u044F\u0434 \u043D\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0435.
      \u041F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0435\u0436\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362914
    m_Localized: "\u0422\u0430\u043A. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u043F\u043E\u0442\u043E\u043C
      \u0441\u043F\u0443\u0441\u043A. \u0414\u0430\u0439 \u043C\u0438\u043D\u0443\u0442\u043A\u0443
      \u0441\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362915
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B. \u041D\u043E \u0441\u0442\u0430\u0440\u044B\u0439
      \u0441\u0433\u043E\u0440\u0435\u043B \u0435\u0449\u0451 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u0441\u044E\u0434\u0430 \u043F\u043E\u043F\u0430\u043B\u0430
      \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362916
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043C\u043E\u0441\u0442
      \u0441\u043B\u043E\u043C\u0430\u043B\u0430 \u0431\u0443\u0440\u044F, \u0430
      \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362917
    m_Localized: "\u041F\u0435\u043A\u0430\u0440\u044C \u0436\u0434\u0451\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0441 \u0433\u0440\u0443\u0437\u043E\u043C. \u041F\u0443\u0441\u0442\u0430\u044F
