      \u043A \u0412\u0430\u043B\u044C\u0442\u0435\u0440\u0443. \u041F\u043E\u043F\u0440\u043E\u0448\u0443
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u043E\u0438 \u0443\u0437\u043B\u044B,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u043B\u0435\u0437\u0443
      \u0437\u0430 \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132675
    m_Localized: "\u0412\u043D\u0438\u0437 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0440\u044F\u0434.
      \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u0448\u044C \u0435\u0433\u043E
      \u0441 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u043E\u043C \u2014
      \u0437\u0430\u0436\u0436\u0451\u0442\u0441\u044F \u0444\u043E\u043D\u0430\u0440\u044C.
      \u041E\u0442 \u0435\u0433\u043E \u0440\u0435\u043B\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132676
    m_Localized: "\u0412\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u043C
      \u043E\u0434\u0438\u043D \u0440\u044F\u0434? \u0417\u043D\u0430\u0447\u0438\u0442,
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044F\u0442\u044C
      \u043F\u043E \u043F\u0443\u0442\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0439, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0441\u043A\u0430\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132677
    m_Localized: "\u0418 \u0435\u0449\u0451 \u043D\u0430\u0441\u0447\u0451\u0442
      \u0431\u0443\u0440\u0438. \u041A\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0442
      \u043F\u043E\u0433\u0430\u0441, \u044F \u043A\u0430\u043A \u0440\u0430\u0437
      \u043C\u0435\u0440\u0438\u043B \u044D\u0442\u043E\u0442 \u043C\u043E\u0441\u0442.
      \u041D\u0435\u0431\u043E \u0431\u044B\u043B\u043E \u0447\u0438\u0441\u0442\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132678
    m_Localized: "\u0414\u043E \u0431\u0443\u0440\u0438? \u0417\u043D\u0430\u0447\u0438\u0442,
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043C\u043E\u0433
      \u0432\u0438\u0434\u0435\u0442\u044C, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u041E\u0441\u0432\u0435\u0442\u0438\u043C \u0434\u043E\u0440\u043E\u0433\u0443
      \u2014 \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132679
    m_Localized: "\u0411\u0435\u043D \u0441\u043B\u044B\u0448\u0430\u043B, \u043A\u0430\u043A
      \u0432 \u0442\u0443 \u043D\u043E\u0447\u044C \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B
      \u0443\u0434\u0430\u0440\u0438\u043B\u0441\u044F \u044F\u0449\u0438\u043A.
      \u0421\u0432\u0435\u0442 \u043F\u043E\u0433\u0430\u0441 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
      \u0442\u043E\u0433\u0434\u0430 \u0436\u0435. \u0423\u0437\u043D\u0430\u0439,
      \u0447\u0442\u043E \u043E\u043D \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132680
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u043C, \u043A\u0443\u0434\u0430
      \u0443\u0432\u0435\u0437\u043B\u0438 \u044F\u0449\u0438\u043A. \u0415\u0441\u043B\u0438
      \u0441\u043B\u0435\u0434\u044B \u0435\u0449\u0451 \u0446\u0435\u043B\u044B,
      \u0441\u0440\u0430\u0432\u043D\u0438\u043C \u0441 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u043E\u0439
      \u043D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132681
    m_Localized: "\u042F\u0449\u0438\u043A \u0443\u0434\u0430\u0440\u0438\u043B \u0432
      \u043A\u043E\u043B\u0435\u0441\u043E. \u042F \u2014 \u0437\u0430 \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u0440\u044B\u0447\u0430\u0433. \u0425\u0440\u0443\u0441\u0442, \u0432\u043E\u0434\u0430
      \u0432\u043E \u0432\u0441\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
      \u0410 \u0443 \u0431\u0440\u0430\u0442\u0430 \u0432 \u043A\u0440\u0430\u043D\u0435
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0441\u0443\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132682
    m_Localized: "\u042D\u0442\u043E \u043E\u043D \u0441 \u0432\u0435\u0434\u0440\u043E\u043C?
      \u0414\u0430\u0432\u0430\u0439 \u0441\u043A\u0430\u0436\u0435\u043C \u0435\u043C\u0443
      \u0441\u0435\u0439\u0447\u0430\u0441. \u041F\u043E\u043A\u0430 \u043E\u043D
      \u043E\u043F\u044F\u0442\u044C \u043D\u0435 \u043F\u043E\u0448\u0451\u043B
      \u043A \u043A\u0440\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132683
    m_Localized: "\u0427\u0435\u0440\u0442\u0451\u0436 \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u043E\u043E\u0431\u0449\u0438\u043B
      \u043E \u043A\u043E\u043B\u0435\u0441\u0435. \u0422\u0430\u043C \u0435\u0449\u0451
      \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0435 \u0440\u0435\u043B\u0435.
      \u042F \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0438 \u0435\u0433\u043E
      \u0441\u043B\u043E\u043C\u0430\u043B \u0441\u0432\u043E\u0438\u043C \u0440\u044B\u0447\u0430\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132684
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043D\u0430\u0448\u0451\u043B
      \u0442\u0430\u043A\u0443\u044E \u0436\u0435 \u043F\u043E\u043B\u043E\u043C\u043A\u0443
      \u0432 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0435. \u0422\u0432\u043E\u0439
      \u0440\u044B\u0447\u0430\u0433 \u0434\u043E \u043D\u0435\u0433\u043E \u0431\u044B
      \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043B. \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132685
    m_Localized: "\u042F\u0449\u0438\u043A \u0437\u0430\u0434\u0435\u043B \u043A\u043E\u043B\u0435\u0441\u043E.
      \u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u0432\u0441\u0442\u0430\u043B\u0438
      \u0447\u0430\u0441\u044B. \u041F\u043E\u0442\u043E\u043C \u044F \u0434\u0451\u0440\u043D\u0443\u043B
      \u0440\u044B\u0447\u0430\u0433. \u0411\u0440\u0430\u0442 \u0435\u0449\u0451
      \u0431\u044B\u043B \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u0434\u043E\u0436\u0434\u044C
      \u043D\u0435 \u043D\u0430\u0447\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132686
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u043E\u043B\u0435\u0441\u043E
      \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u043B\u043E. \u0427\u0430\u0441\u044B
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0435\u043C,
      \u0441\u0432\u0435\u0440\u0438\u043C \u0438\u0445 \u0432\u0440\u0435\u043C\u044F
      \u0441 \u043B\u0451\u0442\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u043E\u0439
      \u041D\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132687
    m_Localized: "\u041D\u0430 \u043E\u0431\u043B\u043E\u043C\u043A\u0435 \u043C\u0435\u0434\u043D\u0430\u044F
      \u043F\u044B\u043B\u044C \u0438 \u043F\u0435\u0447\u0430\u0442\u044C \u0420\u043E\u0437\u044B.
      \u0427\u0442\u043E \u0431\u044B \u043D\u0438 \u0432\u0435\u0437\u043B\u0438
      \u0432 \u044F\u0449\u0438\u043A\u0435, \u044F\u0431\u043B\u043E\u043A\u0430\u043C\u0438
      \u0442\u0430\u043C \u043D\u0435 \u043F\u0430\u0445\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132688
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0451\u043C \u043E\u0431\u043B\u043E\u043C\u043E\u043A
      \u0441 \u0441\u043E\u0431\u043E\u0439. \u0422\u0430\u043A \u0435\u0439 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0440\u043E\u0449\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132689
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u043C\u043E\u044F. \u041F\u0443\u0441\u0442\u044B\u0435
      \u044F\u0449\u0438\u043A\u0438 \u044F \u0434\u0430\u044E \u043D\u0430\u043F\u0440\u043E\u043A\u0430\u0442.
      \u0427\u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C
      \u0438\u0437 \u043D\u0438\u0445 \u043D\u0435 \u0432\u044B\u0432\u0435\u0442\u0440\u0438\u0432\u0430\u0435\u0448\u044C.
      \u042D\u0442\u043E\u0442 \u0434\u0430\u0432\u043D\u043E \u043F\u043E\u0440\u0430
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132690
    m_Localized: "\u0410 \u0432\u043E\u0439\u043B\u043E\u043A \u0443\u0436\u0435
      \u0431\u044B\u043B \u0432\u043D\u0443\u0442\u0440\u0438? \u041A\u0443\u0441\u043E\u0447\u0435\u043A
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0432 \u043F\u0435\u0442\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132691
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u043A \u0437\u0430\u043A\u0430\u0437\u0430\u043B
      \u0424\u0435\u043B\u0438\u043A\u0441 \u0434\u043B\u044F \u043B\u0438\u043D\u0437\u044B.
      \u042F\u0449\u0438\u043A \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043A \u0410\u0434\u0435 \u043F\u043E\u0434 \u043F\u043E\u0433\u0440\u0443\u0437\u043A\u0443,
      \u0442\u0430\u043C \u0435\u0433\u043E \u0437\u0430\u0431\u0440\u0430\u043B\u0430
      \u041D\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132692
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u042F\u0449\u0438\u043A
      \u0432\u0435\u0437\u043B\u0430 \u041D\u043E\u0440\u0430? \u0425\u043E\u0447\u0443
      \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0443\u0434\u0430 \u043E\u043D
      \u043F\u043E\u043F\u0430\u043B \u043F\u043E\u0441\u043B\u0435 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132693
    m_Localized: "\u041D\u043E\u0440\u0430 \u0437\u0430\u0431\u0440\u0430\u043B\u0430
      \u0435\u0433\u043E \u0434\u043B\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439
      \u043B\u0438\u043D\u0437. \u041F\u043E\u043A\u0430\u0436\u0443 \u0437\u0430\u043F\u0438\u0441\u044C.
      \u041F\u0440\u043E\u0447\u0442\u0451\u043C, \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0433\u0440\u0435\u0432\u0430\u044E\u0442\u0441\u044F
      \u0433\u0440\u044F\u0434\u043A\u0438 \u0441 \u0440\u0430\u0441\u0441\u0430\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132694
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0418 \u043F\u043E\u043A\u0430\u0436\u0438,
      \u043A\u0430\u043A\u0438\u0435 \u0444\u043E\u043D\u0430\u0440\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438:
      \u0410\u0434\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0438 \u0433\u0440\u044F\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132695
    m_Localized: "\u041D\u043E\u0440\u0430 \u0438 \u043D\u0430 \u0434\u044B\u043C\u044F\u0449\u0443\u044E\u0441\u044F
      \u0442\u0440\u0443\u0431\u0443 \u0441\u044F\u0434\u0435\u0442. \u0410 \u0432\u043E\u0442
      \u043D\u0430 \u0447\u0430\u0439 \u0435\u0451 \u043D\u0435 \u0443\u0441\u0430\u0434\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132696
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043F\u0440\u043E\u0448\u0443
      \u043B\u0451\u0442\u043D\u0443\u044E \u043A\u043D\u0438\u0433\u0443. \u0410
      \u0447\u0430\u0439 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u044F\u043C\u043E
      \u0437\u0430 \u0447\u0442\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132697
    m_Localized: "\u042F\u0449\u0438\u043A \u043D\u0430 \u0441\u0435\u0432\u0435\u0440?
      \u0414\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D. \u041F\u0435\u0447\u0430\u0442\u044C
      \u0410\u0434\u044B, \u0441\u0431\u043E\u0440 \u043E\u043F\u043B\u0430\u0447\u0435\u043D.
      \u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0440\u0430\u0437\u0431\u0438\u043B\u043E\u0441\u044C,
      \u043D\u0443\u0436\u043D\u0430 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132698
    m_Localized: "\u0412 \u043D\u0451\u043C \u043C\u043E\u0433 \u0431\u044B\u0442\u044C
      \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C.
      \u041A\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0442\u0435\u0431\u0435
      \u0437\u0430\u043A\u0430\u0437? \u0421\u0430\u043C\u0430 \u0410\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132699
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0435 \u043E\u043A\u043E\u0448\u043A\u043E.
      \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u044F \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B\u0430. \u042F \u0442\u043E\u0433\u0434\u0430
      \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u043B\u0430 \u043A \u041A\u043B\u0430\u0440\u0435\u2026
      \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u0438\u043D\u0435\u0441\u0443
      \u043A\u043D\u0438\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132700
    m_Localized: "\u0418 \u0437\u0430\u043A\u0430\u0437, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u0423 \u043D\u0430\u0441 \u0437\u0430\u043F\u0438\u0441\u044C \u043E \u0432\u044B\u0434\u0430\u0447\u0435
      \u044F\u0449\u0438\u043A\u0430. \u041C\u043E\u0436\u0435\u0442, \u0442\u0432\u043E\u0439
      \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0432\u0441\u0451 \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132701
    m_Localized: "\u0422\u0430\u043C \u0435\u0449\u0451 \u043F\u0438\u0441\u044C\u043C\u043E
      \u041A\u043B\u0430\u0440\u0435. \u0422\u0440\u0438\u0436\u0434\u044B \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u0430.
      \u0418 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043F\u043E\u0433\u043E\u0434\u0430
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0446\u0435\u043B\u0443\u044E
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132702
    m_Localized: "\u0410 \u0441 \u043D\u0430\u043C\u0438 \u043F\u043E\u0439\u0434\u0451\u0448\u044C?
      \u0412 \u043B\u0430\u0433\u0443\u043D\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043E\u0442\u0434\u0430\u0442\u044C \u0435\u0439 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0441\u0430\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132703
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u043F\u0440\u0438\u043B\u0438\u0432\u044B \u0438 \u0432\u0441\u0435 \u043B\u043E\u0434\u043A\u0438.
      \u041F\u043E \u0435\u0451 \u0436\u0443\u0440\u043D\u0430\u043B\u0443 \u043C\u043E\u0436\u043D\u043E
      \u0441\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u043E\u0439 \u0440\u0435\u0439\u0441.
      \u0415\u0441\u043B\u0438 \u043E\u043D\u0430 \u043C\u0435\u043D\u044F \u043F\u0440\u0438\u043C\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132704
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B\u0435 \u0432\u0442\u043E\u0440\u043E\u0439
      \u043A\u0430\u043D\u0430\u0442. \u0414\u0430\u0432\u0430\u0439 \u0441\u043F\u0435\u0440\u0432\u0430
      \u043F\u0440\u0438\u0432\u044F\u0436\u0435\u043C \u043B\u043E\u0434\u043A\u0443.
      \u041E \u0436\u0443\u0440\u043D\u0430\u043B\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043C,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132705
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u041D\u043E\u0440\u044B \u043F\u043E\u0434
      \u0447\u0430\u0448\u043A\u043E\u0439. \u042F \u043E\u0442\u0432\u0435\u0447\u0443.
      \u0410 \u043B\u043E\u0434\u043A\u0443 \u0441\u043D\u043E\u0441\u0438\u0442,
      \u043F\u043E\u0434\u0430\u0439 \u043A\u0430\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132706
    m_Localized: "\u0414\u0435\u0440\u0436\u0438. \u041A\u043E\u0433\u0434\u0430
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043C, \u043F\u043E\u043A\u0430\u0436\u0435\u0448\u044C
      \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435 \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043A\u0430\u043D\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132707
    m_Localized: "\u0421\u043A\u0432\u043E\u0437\u044C \u0432\u043E\u0439\u043B\u043E\u043A
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u043B\u0441\u044F \u0441\u0432\u0435\u0442.
      \u042F \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430, \u0410\u0434\u0430
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0444\u043E\u043D\u0430\u0440\u044C \u043D\u0430 \u0441\u0435\u0432\u0435\u0440.
      \u041C\u0430\u043C\u0438\u043D\u0430 \u043B\u043E\u0434\u043A\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0430
      \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u043E\u0433\u043D\u0451\u043C
      \u043A\u0430\u043D\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132708
    m_Localized: "\u0410\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
      \u0447\u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u0442
      \u043F\u0443\u0442\u044C? \u0412 \u0437\u0430\u043A\u0430\u0437\u0435 \u041D\u043E\u0440\u044B
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E, \u0447\u0442\u043E \u0433\u0440\u0443\u0437
      \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132709
    m_Localized: "\u041D\u0435\u0442. \u0412 \u043E\u0442\u0432\u0435\u0442\u0430\u0445
      \u0431\u044B\u043B\u0438 \u043E\u0434\u043D\u0438 \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0438.
      \u0424\u0435\u043B\u0438\u043A\u0441 \u0441\u0434\u0435\u043B\u0430\u043B \u0434\u043B\u044F
      \u043C\u0435\u043D\u044F \u0437\u0430\u043C\u0435\u0440\u044B, \u043D\u043E
      \u0410\u0434\u0430 \u0442\u0430\u043A \u0438 \u043D\u0435 \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043B\u0430
      \u0434\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132710
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u0434\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0435\u0451 \u0441\u0430\u043C\u0443. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u043A\u0430\u043D\u0430\u043B:
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043A \u0430\u0440\u0445\u0438\u0432\u0443
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132711
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \u043A\u043B\u044E\u0447\u0435\u0439
      \u0443 \u041E\u0441\u043A\u0430\u0440\u0430. \u041E\u043D \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442
      \u0432\u044B\u0442\u0435\u0440\u0435\u0442\u044C \u043B\u0430\u043F\u044B.
      \u0417\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0443 \u043D\u0435\u0433\u043E
      \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u043A\u043E\u0432\u0440\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307759132712
    m_Localized: "\u0412\u044B\u0442\u0440\u0443 \u043D\u0430 \u043E\u0431\u043E\u0438\u0445.
      \u0410 \u0442\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u0448\u044C \u041D\u043E\u0440\u0443
      \u0443 \u0441\u0435\u0431\u044F? \u041E\u043D\u0430 \u0432\u0441\u0451 \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0447\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326976
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \u043A\u043B\u044E\u0447\u0435\u0439
      \u043C\u0430\u044F\u043A\u0430. \u041E\u0434\u0438\u043D \u0443 \u0410\u0434\u044B.
      \u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0431\u0435\u0440\u0451\u0442 \u0424\u0435\u043B\u0438\u043A\u0441,
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0438\u043D\u0438\u0442 \u043B\u0438\u043D\u0437\u044B.
      \u0420\u0430\u0441\u043F\u0438\u0441\u043A\u0438 \u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F\u0445
      \u0442\u043E\u0436\u0435 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0443
      \u0410\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326977
    m_Localized: "\u0421\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043A\u043B\u044E\u0447
      \u0435\u0449\u0451 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442.
      \u041D\u0430\u0434\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0410\u0434\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0430 \u0435\u043C\u0443
      \u0437\u0430\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326978
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0443 \u043A\u043E\u0433\u043E \u0431\u044B\u043B \u0434\u043E\u0441\u0442\u0443\u043F,
      \u0430 \u043D\u0435 \u0447\u0442\u043E \u043E\u0442\u0442\u0443\u0434\u0430
      \u0432\u044B\u043D\u0435\u0441\u043B\u0438. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u043D\u0443\u0436\u0435\u043D \u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0432
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326979
    m_Localized: "\u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0439\u0442\u0438
      \u043D\u043E\u043C\u0435\u0440? \u041D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0410\u0434\u0430 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u043B\u0430
      \u0432\u0441\u0435 \u043F\u0430\u043F\u043A\u0438 \u043D\u0430 \u043C\u0430\u044F\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326980
    m_Localized: "\u041E\u043D\u0430 \u0443 \u0410\u0434\u044B. \u0410 \u0432\u043E\u0442
      \u043F\u0440\u043E\u0448\u0435\u043D\u0438\u044F \u043E \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u041A\u043B\u0430\u0440\u0430,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043B\u0430\u043D \u0424\u0435\u043B\u0438\u043A\u0441\u0430.
      \u041E\u0442\u0432\u0435\u0442 \u043E\u0434\u0438\u043D: \xAB\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C\xBB.
      \u0413\u043E\u0434 \u0437\u0430 \u0433\u043E\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326981
    m_Localized: "\u0418 \u0438\u0445 \u0441\u043A\u043E\u043F\u0438\u0440\u0443\u0435\u043C.
      \u0410\u0434\u0430 \u043D\u0430\u0441 \u0436\u0434\u0451\u0442. \u0410 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
      \u0443 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043C\u0435\u0441\u0442\u0430 \u043D\u0430 \u0435\u0451
      \u0437\u0430\u043F\u0438\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326982
    m_Localized: "\u041E\u0441\u043A\u0430\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u044D\u0442\u043E\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u043F\u0443\u0441\u0442\u044B\u043C.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0443\u0441\u0442\u0443\u043F \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0441\u044F
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u0443\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326983
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043E\u0431\u0445\u043E\u0434.
      \u041E\u0442\u043C\u0435\u0442\u0438\u043C \u0435\u0433\u043E, \u043F\u043E\u043A\u0430
      \u0441\u044E\u0434\u0430 \u043D\u0435 \u043F\u0440\u0438\u0448\u0451\u043B
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0435\u0449\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326984
    m_Localized: "\u0425\u0440\u0435\u0431\u0435\u0442 \u044F \u0437\u043D\u0430\u044E.
      \u0414\u0435\u0440\u0436\u0438\u0441\u044C \u0440\u044F\u0434\u043E\u043C.
      \u0414\u043E \u043C\u0430\u044F\u043A\u0430 \u0434\u043E\u0439\u0434\u0451\u043C
      \u0431\u0435\u0437 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326985
    m_Localized: "\u041B\u044E\u043C\u0438, \u043F\u0440\u044F\u0436\u043A\u0430
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.
      \u0422\u044B \u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0430\u0437 \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F
      \u0435\u0451 \u0437\u0430\u0441\u0442\u0435\u0433\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326986
    m_Localized: "\u041D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0443.
      \u0412\u043D\u0438\u0437\u0443 \u0435\u0441\u0442\u044C \u043F\u0440\u0438\u044E\u0442.
      \u0412\u0441\u0451 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u0437\u0430\u0439\u0442\u0438
      \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326987
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0438 \u0437\u0430\u0439\u0434\u0451\u043C.
      \u041D\u043E\u0440\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0432
      \u043F\u0440\u0438\u044E\u0442\u0435 \u043E\u0434\u0435\u044F\u043B\u0430 \u043E\u0442
      \u0411\u0435\u043D\u0430. \u041F\u043E\u043A\u0430\u0436\u0438, \u043A\u0443\u0434\u0430
      \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043E\u0433\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326988
    m_Localized: "\u041B\u0443\u0447 \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0435\u0449\u0451 \u0434\u043E
      \u0441\u043D\u0435\u0433\u0430. \u041D\u043E\u0440\u0430 \u0432\u0435\u0437\u043B\u0430
      \u044F\u0449\u0438\u043A \u0442\u0443\u0434\u0430. \u042F \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0410\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326989
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u0442\u043E\u0436\u0435 \u0442\u0430\u043A
      \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430, \u043D\u043E \u0435\u0439
      \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0441\u043E\u043E\u0431\u0449\u0438\u043B. \u0421\u043F\u0440\u043E\u0441\u0438\u043C
      \u0410\u0434\u0443, \u043F\u043E\u0447\u0435\u043C\u0443 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0434\u043E \u043D\u0435\u0451 \u043D\u0435 \u0434\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326990
    m_Localized: "\u0414\u0432\u0435 \u0432\u0441\u043F\u044B\u0448\u043A\u0438.
      \u041E\u043A\u043D\u043E \u0410\u0434\u044B. \u0412\u0438\u0434\u0438\u0442
      \u043D\u0430\u0441. \u042F \u0434\u0435\u0440\u0436\u0443 \u043C\u043E\u0441\u0442,
      \u043E\u0442\u0432\u0435\u0442\u044C \u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326991
    m_Localized: "\u0414\u0432\u0435 \u0432 \u043E\u0442\u0432\u0435\u0442. \u0411\u0430\u0431\u0443\u0448\u043A\u0430,
      \u0441\u0442\u043E\u0439 \u0442\u0430\u043C! \u0414\u0430\u0439 \u043C\u043D\u0435
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326992
    m_Localized: "\u0420\u0438\u043D\u2026 \u0414\u0430\u0439 \u043D\u0430 \u0442\u0435\u0431\u044F
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C. \u0412\u0435\u0441\u044C
      \u043F\u0443\u0442\u044C \u0436\u0434\u0430\u043B\u0430 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0441\u0432\u0435\u0442\u0430. \u0425\u043E\u0442\u0435\u043B\u0430 \u0432\u044B\u0439\u0442\u0438
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443, \u0434\u0430 \u0432\u043E\u0442
      \u043C\u043E\u0441\u0442\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326993
    m_Localized: "\u042F \u0437\u0434\u0435\u0441\u044C, \u0431\u0430\u0431\u0443\u0448\u043A\u0430.
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0437\u0430\u043A\u0430\u0437
      \u041D\u043E\u0440\u044B. \u041D\u0430 \u043D\u0451\u043C \u0442\u0432\u043E\u044F
      \u043F\u0435\u0447\u0430\u0442\u044C. \u0422\u044B \u0432\u0435\u043B\u0435\u043B\u0430
      \u0443\u0432\u0435\u0437\u0442\u0438 \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326994
    m_Localized: "\u042F \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0430 \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C
      \u043B\u0438\u043D\u0437\u0443, \u043D\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u044C
      \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C.
      \u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u043F\u0430\u0436\u0438 \u043C\u0430\u043C\u044B
      \u041A\u043B\u0430\u0440\u044B \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0442\u043E\u0442 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326995
    m_Localized: "\u0410 \u043B\u043E\u0434\u043A\u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0445\u043E\u0434\u0438\u043B\u0438. \u041A\u043B\u0430\u0440\u0435 \u043D\u0443\u0436\u043D\u044B
      \u043E\u0433\u043D\u0438, \u0430 \u043D\u0435 \u0435\u0449\u0451 \u043E\u0434\u043D\u0430
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u043D\u043E\u043C\u0435\u0440 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326996
    m_Localized: "\u0420\u0430\u0441\u043F\u0438\u0441\u043A\u0430 \u0432 \u043F\u0430\u043F\u043A\u0435
      \u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u043C\u0438. \u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A
      \u0437\u0430\u0435\u043B\u043E. \u041F\u043E\u043C\u043E\u0433\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043F\u0430\u043F\u043A\u0443, \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C,
      \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0424\u0435\u043B\u0438\u043A\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326997
    m_Localized: "\u0412\u043A\u043B\u044E\u0447\u0443 \u0440\u0435\u043B\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0430.
      \u041E\u0441\u0442\u0430\u043D\u044C\u0441\u044F \u0443 \u043F\u0435\u0440\u0438\u043B,
      \u0441\u043B\u0435\u0434\u0438 \u0437\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u043C
      \u043A\u043E\u043D\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326998
    m_Localized: "\u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C
      \u0437\u0430 \u0442\u0432\u043E\u0435\u0439 \u043B\u0438\u043D\u0437\u043E\u0439.
      \u0410\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E
      \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043B\u0430 \u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C. \u041F\u043E\u043A\u0430\u0436\u0438
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u0440\u0438\u0448\u043B\u043E \u0441 \u044F\u0449\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763326999
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u0431\u044B\u043B\u0430 \u0435\u0451.
      \u042F \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u043B \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043B\u0443\u0447. \u041F\u043E\u0441\u0442\u043E\u0439, \u0441\u0438\u0433\u043D\u0430\u043B
      \u043F\u0438\u043B\u043E\u0442\u0430. \u0422\u0440\u0438 \u0432\u0441\u043F\u044B\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327000
    m_Localized: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442?
      \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438
      \u0434\u043E\u043B\u0435\u0442\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327001
    m_Localized: "\u041D\u0435\u0442. \u041F\u043B\u0430\u043D\u0435\u0440 \u043A\u0440\u0443\u0436\u0438\u0442
      \u0437\u0430 \u043B\u0438\u043D\u0437\u043E\u0439. \u041D\u0430 \u043C\u043E\u0435\u0439
      \u043A\u0430\u0440\u0442\u0435 \u0443 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430
      \u0444\u043E\u043D\u0430\u0440\u044C, \u043D\u043E \u041D\u043E\u0440\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0442\u0430\u043C \u0442\u0435\u043C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327002
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u043A\u0430 \u043D\u0435
      \u0442\u0440\u043E\u0433\u0430\u0439 \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C.
      \u041A\u0430\u043A\u0438\u0435 \u0440\u0435\u043B\u0435 \u043C\u043E\u0433\u0443\u0442
      \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u0442\u043E\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327003
    m_Localized: "\u041D\u0438\u0436\u043D\u044F\u044F \u0446\u0435\u043F\u044C.
      \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043F\u043E\u043B\u043D\u0430\u044F
      \u0441\u0445\u0435\u043C\u0430. \u041D\u0430 \u0442\u043E\u0439, \u0447\u0442\u043E
      \u044F \u043F\u043E\u0441\u043B\u0430\u043B \u0411\u0435\u043D\u0443, \u0435\u0451
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327004
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0443. \u0418 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0442\u043E\u0436\u0435. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435
      \u0434\u0432\u0438\u0433\u0430\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A,
      \u043F\u043E\u043A\u0430 \u043F\u0438\u043B\u043E\u0442 \u0438\u0434\u0451\u0442
      \u043F\u043E \u0435\u0433\u043E \u043B\u0443\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327005
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438 \u043E\u0431\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
      \u0443 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0430. \u0421\u043B\u0435\u0434\u0438
      \u0437\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C,
      \u044F \u0432\u043A\u043B\u044E\u0447\u0443 \u043D\u0438\u0436\u043D\u044E\u044E
      \u0446\u0435\u043F\u044C. \u041D\u043E\u0440\u0430, \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F
      \u0441 \u043F\u0438\u043B\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327006
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0444\u043E\u043D\u0430\u0440\u044C\u2026
      \u0414\u0430\u0432\u0430\u0439 \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u043E\u0438\u043C? \u0425\u043E\u0447\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044C,
      \u043A\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327007
    m_Localized: "\u041D\u0443 \u0438?.. \u041E\u043D \u043F\u043E\u0439\u0434\u0451\u0442
      \u0441 \u043D\u0430\u043C\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327008
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u044F\u0449\u0438\u043A
      \u043F\u0440\u043E\u0432\u0435\u0437\u043B\u0438 \u0435\u0449\u0451 \u043F\u0440\u0438
      \u044F\u0441\u043D\u043E\u043C \u043D\u0435\u0431\u0435. \u0410 \u0431\u0443\u0440\u044F
      \u043F\u0440\u0438\u0448\u043B\u0430 \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327009
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u0443 \u0433\u043D\u0435\u0437\u0434\u0430
      \u043A\u0442\u043E-\u0442\u043E \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F.
      \u041F\u0442\u0438\u0446\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
      \u0441\u0432\u0435\u0442 \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327010
    m_Localized: "\u0421\u0435\u043C\u0435\u043D\u0430 \u0432 \u044D\u0442\u043E\u0442
      \u043A\u0430\u0440\u043C\u0430\u043D, \u0431\u0443\u043C\u0430\u0433\u0438
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439. \u0410\u0434\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u0432\u043E\u0438\u043C\u0438
      \u0441\u043E\u0432\u0435\u0442\u0430\u043C\u0438, \u043A\u0430\u043A \u0441\u0430\u0436\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327011
    m_Localized: "\u0422\u044B \u0432\u0438\u0434\u0435\u043B\u0430 \u0441\u0432\u0435\u0442
      \u0441\u043A\u0432\u043E\u0437\u044C \u0432\u043E\u0439\u043B\u043E\u043A.
      \u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u0412\u044B\u0441\u0448\u0438\u0439
      \u0424\u043E\u043D\u0430\u0440\u044C, \u0435\u0433\u043E \u0432\u0435\u0437\u043B\u0438
      \u0433\u043E\u0440\u044F\u0449\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327012
    m_Localized: "\u0423\u043B\u043E\u0436\u0443 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0437\u0430\u043A\u0430\u0437\u043E\u043C \u041D\u043E\u0440\u044B.
      \u0425\u043E\u0447\u0443 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0410\u0434\u0430 \u0432\u0441\u0451
      \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u0430 \u044D\u0442\u043E\u0442
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327013
    m_Localized: "\u0418\u0445 \u0442\u043E\u0436\u0435 \u043F\u043E\u043F\u0440\u043E\u0448\u0443.
      \u041D\u043E\u0440\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E \u043F\u0440\u043E
      \u0443\u0436\u0438\u043D. \u041E\u043D\u0430 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0443\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327014
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0439 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448
      \u0432\u043E\u0437\u044C\u043C\u0443 \u0434\u043B\u044F \u043A\u0430\u0440\u0442\u044B.
      \u042D\u0442\u043E\u0442 \u0443\u0436\u0435 \u0441\u043E\u0432\u0441\u0435\u043C
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327015
    m_Localized: "\u042F\u0449\u0438\u043A \u0443\u0432\u0435\u0437\u043B\u0438 \u043A
      \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C,
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043B\u0438 \u0435\u0451 \u043B\u0443\u0447 \u0438\u0434\u0451\u0442 \u043E\u0442
      \u043D\u0430\u0448\u0435\u0433\u043E \u0444\u043E\u043D\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307763327016
    m_Localized: "\u041D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C.
      \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0441\u0442\u044B\u043A\u043E\u043C.
      \u0414\u0432\u0430 \u0441\u0442\u0443\u043A\u0430 \u2014 \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0439
      \u0441\u043F\u0443\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521280
    m_Localized: "\u0414\u0432\u0430 \u0441\u0442\u0443\u043A\u0430. \u0417\u0430\u043F\u043E\u043C\u043D\u044E.
      \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C \u0441\u043E \u043C\u043D\u043E\u0439,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0434\u043E\u0431\u0435\u0440\u0443\u0441\u044C
      \u0434\u043E \u0444\u043E\u043D\u0430\u0440\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521281
    m_Localized: "\u0422\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C,
      \u0437\u0430\u0447\u0435\u043C \u043C\u043D\u0435 \u043A\u0440\u0438\u0432\u043E\u0435
      \u0434\u0435\u0440\u0435\u0432\u043E. \u041E\u0431\u044B\u0447\u043D\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441 \u044D\u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521282
    m_Localized: "\u0422\u044B \u0436\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430:
      \u043A\u043E\u0440\u043D\u0438 \u0434\u0435\u0440\u0436\u0430\u0442 \u0442\u0435\u0440\u0440\u0430\u0441\u0443.
      \u0410 \u043A\u0440\u0438\u0432\u0443\u044E \u0432\u0435\u0442\u043A\u0443
      \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u043E\u0439\u0442\u0438 \u0441\u043D\u0430\u0440\u0443\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521283
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0435
      \u0444\u0438\u0433\u0443\u0440\u044B. \u0410\u0434\u0430 \u0443\u0447\u0438\u043B\u0430
      \u0438\u043C \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0447\u0442\u0435\u043D\u0438\u044E
      \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521284
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0443\u0442\u044C \u0435\u0449\u0451
      \u043D\u0435 \u043E\u0441\u0432\u0435\u0449\u0451\u043D. \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F, \u0430 \u0442\u044B
      \u0441\u0432\u0435\u0440\u044C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521285
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041D\u0430\u0447\u043D\u0451\u043C
      \u0441 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0444\u043E\u043D\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521286
    m_Localized: "\u041D\u0430 \u0441\u0432\u0435\u0442\u043E\u0432\u044B\u0445 \u0434\u0435\u0442\u0430\u043B\u044F\u0445
      \u0431\u0443\u043A\u0432\u044B. \u0421\u043F\u0443\u0441\u043A\u0430\u0435\u043C
      \u0442\u043E\u0442 \u0436\u0435 \u0440\u044F\u0434, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u043D\u0430\u0447\u0435 \u0447\u0438\u0442\u0430\u0435\u043C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521287
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u0446\u0435\u043F\u044C \u0444\u043E\u043D\u0430\u0440\u0435\u0439. \u0415\u0451
      \u0435\u0449\u0451 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u0436\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521288
    m_Localized: "\u0421\u0432\u0435\u0440\u044E \u0432\u0435\u0441\u044C \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0445\u043E\u0434\u0430.
      \u0410\u0434\u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u0431\u044B
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521289
    m_Localized: "\u0411\u0443\u043A\u0432\u044B \u0438 \u0444\u0438\u0433\u0443\u0440\u044B
      \u0432\u043C\u0435\u0441\u0442\u0435. \u041D\u0430\u0434\u043E \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C, \u0430 \u043D\u0435
      \u0437\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C\u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521290
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u0430\u043D\u0430\u0442
      \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A, \u043F\u043E\u043A\u0430
      \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0431\u043B\u0438\u0436\u043D\u0435\u0435
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521291
    m_Localized: "\u0412\u0438\u0436\u0443. \u041D\u0430\u0447\u043D\u0443 \u0441
      \u043D\u0438\u0436\u043D\u0435\u0433\u043E \u0444\u043E\u043D\u0430\u0440\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0432\u0435\u0440\u0438\u043C \u0432\u0441\u044E
      \u0446\u0435\u043F\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521292
    m_Localized: "\u041D\u0430\u0448 \u043F\u0443\u0442\u044C \u0441 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521293
    m_Localized: "\u041A\u0430\u043D\u0430\u0442 \u043D\u0430 \u043F\u0440\u0435\u0436\u043D\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435. \u0417\u0430\u043F\u0438\u0441\u0438 \u0442\u043E\u0436\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521294
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u0434\u0435\u0442\u0430\u043B\u0438
      \u0441 \u0431\u0443\u043A\u0432\u0430\u043C\u0438. \u0412 \u0437\u0430\u043F\u0438\u0441\u044F\u0445
      \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435
      \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521295
    m_Localized: "\u041A\u0430\u043D\u0430\u0442 \u0433\u043E\u0442\u043E\u0432.
      \u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0442\u043E\u0433\u043E \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
      \u2014 \u044F \u043F\u043E\u043A\u0430\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521296
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0439
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A. \u0421\u0432\u0435\u0440\u044E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u043D\u0430\u043A, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521297
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0435\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E. \u0422\u0432\u043E\u0438
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0440\u044F\u0434\u043E\u043C \u0441
      \u043A\u0430\u043D\u0430\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318702
    m_Localized: "\u0421 \u0434\u043E\u0431\u0440\u044B\u043C \u0443\u0442\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318703
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318704
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E!
      \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043C \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318705
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E!
      \u041F\u0443\u0441\u0442\u044C \u0434\u0435\u043D\u044C \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0441\u044E\u0440\u043F\u0440\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318706
    m_Localized: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E!
      \u041D\u043E\u0432\u0430\u044F \u0434\u043E\u0440\u043E\u0436\u043A\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F
      \u0442\u0438\u0445\u0430\u044F \u043C\u0438\u043D\u0443\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318707
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440!
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0441 \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430, \u0433\u0434\u0435
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318708
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440!
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0430
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318709
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440!
      \u0416\u0435\u043B\u0430\u0435\u043C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438 \u0438 \u043B\u0451\u0433\u043A\u043E\u0433\u043E
      \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318710
    m_Localized: "\u0423\u0436\u0435 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043E
      {0} \u043F\u0443\u0442\u0435\u0439. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2323307767521298
    m_Localized: "\u0422\u0440\u043E\u0444\u0435\u0435\u0432 \u043F\u043E\u043A\u0430
      \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3745925842329600
    m_Localized: "\u041E\u0434\u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3745925842329601
    m_Localized: "\u0421\u0443\u043C\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0438 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
