      \u0438\u043B\u0438 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318567
    m_Localized: "\u041E\u0433\u043E\u043D\u044C\u043A\u0438 \u0434\u043E \u043F\u043E\u0441\u044B\u043B\u043A\u0438:
      {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318568
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u044E\u0440\u043F\u0440\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318569
    m_Localized: "20 \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318570
    m_Localized: "+20 \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318571
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u043D\u0430\u0440\u044F\u0434 \u0420\u0438\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318572
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318573
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0442\u0432\u043E\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318574
    m_Localized: "\u0428\u043B\u044F\u043F\u0430 \u043F\u0443\u0442\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318575
    m_Localized: "\u041A\u043E\u0441\u0442\u044E\u043C \u043B\u044F\u0433\u0443\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318576
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439 \u0440\u044B\u0446\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318577
    m_Localized: "\u041C\u0430\u0441\u043A\u0430 \u043B\u0438\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318578
    m_Localized: "\u041B\u0435\u0442\u044F\u0449\u0438\u0435 \u043B\u0438\u0441\u0442\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318579
    m_Localized: "\u041A\u0430\u043F\u043B\u0438 \u0434\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318580
    m_Localized: "\u041C\u0435\u0440\u0446\u0430\u044E\u0449\u0438\u0435 \u0437\u0432\u0451\u0437\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318581
    m_Localized: "\u041F\u0430\u0440\u044F\u0449\u0438\u0435 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318582
    m_Localized: "\u0422\u0435\u0441\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318583
    m_Localized: "\u041D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u043E\u0441\u044C.
      \u0415\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318584
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0431\u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318585
    m_Localized: "\u042F \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u043B
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0432\u043E\u0439 \u043C\u043E\u0441\u0442.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0451 \u0438\u043C\u044F
      \u043D\u0430 \u043A\u0443\u0447\u0435 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0445
      \u0434\u043E\u0441\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318586
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C
      \u0438 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C \u0445\u043B\u0435\u0431\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044E
      \u0434\u043E\u0441\u043A\u0438, \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u043C\u0430\u0436\u0443
      \u0445\u043B\u0435\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318587
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0447\u0438\u043D\u0438\u043C
      \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0435\u0445\u043E\u0434. \u0422\u043E\u0433\u0434\u0430
      \u044F \u0443\u0432\u0438\u0436\u0443, \u043A\u0443\u0434\u0430 \u043D\u0435\u0441\u0442\u0438
      \u0441\u0432\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318588
    m_Localized: "\u041E\u043D \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B \u0443\u0436\u0435
      \u0442\u0440\u0438 \u0432\u0435\u0434\u0440\u0430. \u041D\u0430\u0434\u043E
      \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0445\u043E\u0442\u044C
      \u043E\u0434\u043D\u043E, \u043F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435
      \u043D\u0430\u0448\u0451\u043B \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318589
    m_Localized: "\u041E\u043D \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B \u043C\u043E\u0439
      \u0442\u0440\u044E\u043A \u0441 \u043A\u043E\u043B\u0435\u0441\u043E\u043C.
      \u041D\u0430\u0434\u043E \u0435\u0449\u0451 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0435\u043C\u0443, \u043A\u0430\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318590
    m_Localized: "\u042F \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0430 \u044D\u0442\u043E
      \u0434\u0435\u0440\u0435\u0432\u043E, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0430
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043F\u0430\u0441\u043B\u0430 \u0441\u0435\u043C\u0435\u043D\u0430,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043B\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318591
    m_Localized: "\u041F\u043E\u0441\u0430\u0436\u0443 \u043E\u0434\u043D\u043E \u0443
      \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E\u0433\u043E \u043E\u043A\u043D\u0430.
      \u041E\u043D\u0430 \u0441\u043C\u043E\u0436\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
      \u043F\u0435\u0440\u0432\u044B\u0439 \u043B\u0438\u0441\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318592
    m_Localized: "\u042F \u043F\u043E\u0441\u0441\u043E\u0440\u0438\u043B\u0430\u0441\u044C
      \u0441 \u0434\u0430\u0432\u043D\u0435\u0439 \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u0439.
      \u0423\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0441\u044F\u0446\u0435\u0432
      \u043D\u043E\u0448\u0443 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u0435
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318593
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
      \u0435\u0439 \u0441\u043A\u0430\u0437\u0430\u0442\u044C? \u041C\u043E\u0436\u0435\u0448\u044C
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043C\u043D\u0435, \u0430 \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318594
    m_Localized: "\u0427\u0442\u043E \u044F \u0431\u044B\u043B\u0430 \u043D\u0435\u043F\u0440\u0430\u0432\u0430.
      \u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0432\u0441\u0451
      \u0432\u0440\u0435\u043C\u044F \u043F\u0438\u0448\u0443 \u043E \u043F\u043E\u0433\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318595
    m_Localized: "\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u0430 \u044D\u0442\u043E
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0443\u0441\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318596
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C
      \u0435\u0451 \u0431\u0440\u0430\u0442\u044C. \u042F \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0443
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u0430 \u0447\u0438\u0441\u0442\u044B\u0439
      \u043B\u0438\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318597
    m_Localized: "\u041C\u043E\u0439 \u0443\u0447\u0438\u0442\u0435\u043B\u044C \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u043E\u0441\u0442\u0430\u0432\u044C
      \u043C\u043D\u0435; \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0442\u0432\u043E\u044E
      \u043A\u043E\u043F\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318598
    m_Localized: "\u0422\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B.
      \u0410 \u044F \u043E\u0442\u043C\u0435\u0447\u0443 \u0441\u0443\u0445\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043F\u0440\u0438\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318599
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0437\u043D\u0430\u043A \u043F\u043E\u0434
      \u0442\u0435\u043C \u0441\u0443\u0433\u0440\u043E\u0431\u043E\u043C. \u042F
      \u0435\u0433\u043E \u043E\u0442\u043A\u043E\u043F\u0430\u044E, \u0435\u0441\u043B\u0438
      \u0442\u044B \u043F\u043E\u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318600
    m_Localized: "\u041E\u0434\u043D\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0431\u044B\u043B\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u043C.
      \u042F \u0437\u0430\u043A\u0440\u044B\u043B \u043A\u0430\u0440\u0442\u0443
      \u0438 \u0441\u0442\u0430\u043B \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      \u0435\u0451 \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318601
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C.
      \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0435\u0451 \u0441 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318602
    m_Localized: "\u041E\u0433\u043D\u0438 \u0434\u043E \u0431\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318603
    m_Localized: "\u042F \u043E\u0442\u043C\u0435\u0447\u0443 \u043F\u0435\u0440\u0432\u0443\u044E
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0443\u044E \u0434\u043E\u0441\u043A\u0443.
      \u0421\u043A\u0430\u0436\u0438, \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C
      \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0435\u0440\u0435\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318604
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u0430.
      \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u043D\u0438\u0437...
      \u043F\u043E\u043A\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318605
    m_Localized: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318606
    m_Localized: "\u042F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u044D\u0442\u0443
      \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0443. \u0410 \u0431\u0440\u0430\u0442
      \u043F\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u0435\u0434\u0440\u043E
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0441\u0443\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318607
    m_Localized: "\u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0442\u0440\u0443\u0431\u0443.
      \u041E\u0442 \u043A\u0440\u0443\u0442\u044F\u0449\u0435\u0433\u043E\u0441\u044F
      \u043A\u043E\u043B\u0435\u0441\u0430 \u043C\u0430\u043B\u043E \u0442\u043E\u043B\u043A\u0443,
      \u0435\u0441\u043B\u0438 \u0432\u0435\u0434\u0440\u043E \u043F\u0443\u0441\u0442\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318608
    m_Localized: "\u0420\u0430\u0441\u0441\u0430\u0434\u0430 \u043D\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318609
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438 \u0442\u0440\u0438 \u0441\u0435\u043C\u0435\u0447\u043A\u0430.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u2014 \u0434\u043B\u044F \u0441\u0430\u0434\u0430
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318610
    m_Localized: "\u0422\u0440\u0438 \u0441\u0435\u043C\u0435\u0447\u043A\u0430 \u0438
      \u043E\u0434\u043D\u043E \u043F\u0438\u0441\u044C\u043C\u043E. \u041A\u043E\u0433\u0434\u0430
      \u0434\u043E\u0431\u0435\u0440\u0451\u043C\u0441\u044F \u0434\u043E\u043C\u043E\u0439,
      \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0443 \u0431\u0430\u0431\u0443\u0448\u043A\u0438
      \u0433\u043E\u0440\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318611
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0431\u0435\u0437 \u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318612
    m_Localized: "\u042F \u043D\u0430\u043F\u0438\u0448\u0443 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u0435.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0440\u0435\u0433\u0438
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0438\u0441\u044C\u043C\u0430
      \u043E\u0442 \u044D\u0442\u043E\u0439 \u043B\u0443\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318613
    m_Localized: "\u042F \u0438\u0445 \u0441\u043E\u0431\u0435\u0440\u0443. \u041E\u0441\u0442\u0430\u0432\u044C
      \u0441\u0432\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u0441\u0432\u0435\u0440\u0445\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u043E \u0431\u044B\u043B\u043E
      \u043D\u0430 \u0432\u0438\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318614
    m_Localized: "\u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043A\u0430\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318615
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u043B\u0430\u043C\u043F\u0430
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u0438\u0440\u0441\u043E\u043C.
      \u0414\u043E \u043D\u0435\u0451 \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E \u0441\u0443\u0445\u0438\u043C \u0434\u043E\u0441\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318616
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043C\u043D\u0435 \u0435\u0451.
      \u041E \u0434\u0430\u043B\u044C\u043D\u0435\u043C \u0431\u0435\u0440\u0435\u0433\u0435
      \u043F\u043E\u0434\u0443\u043C\u0430\u044E, \u043A\u043E\u0433\u0434\u0430
      \u0434\u043E \u043D\u0435\u0433\u043E \u0434\u043E\u0431\u0435\u0440\u0451\u043C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318617
    m_Localized: "\u0414\u0432\u0430 \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
      \u043F\u0440\u043E\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318618
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u044D\u0442\u043E\u0442 \u0443\u0433\u043E\u043B\u043E\u043A.
      \u041D\u0430 \u043A\u043E\u043F\u0438\u0438 \u043D\u0443\u0436\u0435\u043D
      \u043F\u0440\u0438\u044E\u0442, \u0430 \u043D\u0435 \u043A\u0430\u0436\u0434\u0430\u044F
      \u0433\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318619
    m_Localized: "\u0418 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u043C\u044B \u043D\u0430\u0439\u0434\u0451\u043C. \u042F
      \u043F\u0440\u0438\u043D\u0435\u0441\u0443 \u044D\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u0438
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318620
    m_Localized: "\u041B\u0443\u0447 \u043D\u0430\u0434 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318621
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0432\u044B\u0432\u0435\u043B\u0430
      \u0411\u0435\u043D\u0430 \u0438\u0437 \u0442\u0430\u043A\u043E\u0433\u043E
      \u0442\u0443\u043C\u0430\u043D\u0430. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043C\u043D\u0435 \u0441\u0430\u043C\u043E\u0439 \u043D\u0443\u0436\u043D\u0430
      \u0447\u044C\u044F-\u0442\u043E \u043B\u0430\u043F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318622
    m_Localized: "\u0412\u043E\u0442. \u0414\u0435\u0440\u0436\u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0448\u0430\u0440\u0444\u0430. \u0418 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438
      \u043C\u0435\u043D\u044F, \u0435\u0441\u043B\u0438 \u043D\u0430\u0447\u043D\u0443
      \u0441\u043F\u0435\u0448\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318623
    m_Localized: "\u041F\u0430\u043F\u043A\u0430 \u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318624
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u043E\u0439 \u0444\u043E\u043D\u0430\u0440\u044C.
      \u042F \u0431\u0443\u0434\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043F\u0435\u0440\u0438\u043B\u0430, \u0430 \u0442\u044B \u0441\u043B\u0435\u0434\u0438
      \u0437\u0430 \u0444\u0438\u0442\u0438\u043B\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318625
    m_Localized: "\u0422\u0432\u043E\u0439 \u0444\u043E\u043D\u0430\u0440\u044C \u0438
      \u043C\u043E\u0439. \u041F\u043E\u0434\u0435\u0440\u0436\u0443 \u0438\u0445
      \u043F\u043E\u043D\u0438\u0436\u0435, \u043F\u043E\u043A\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318626
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C \u043B\u0443\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318627
    m_Localized: "\u041B\u0443\u043D\u043D\u044B\u0439 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442
      \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0442\u0443\u0434\u0430. \u0415\u0433\u043E \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318628
    m_Localized: "\u0422\u044B \u0447\u0438\u0442\u0430\u0439 \u0448\u043A\u0430\u043B\u0443.
      \u042F \u043F\u043E\u0434\u0435\u0440\u0436\u0443 \u0441\u0432\u0435\u0442,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F
      \u043C\u0435\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318629
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440. \u042F \u0441\u0442\u0440\u043E\u0438\u043B
      \u044D\u0442\u0438 \u043C\u043E\u0441\u0442\u044B. \u0414\u043E\u0441\u043A\u0438
      \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0438 \u0431\u0443\u0440\u044E \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043C\u043E\u044F \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318630
    m_Localized: "\u041A\u043B\u0430\u0440\u0430. \u041E\u0441\u0442\u0430\u043D\u044C\u0441\u044F
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043D\u0430 \u043F\u0438\u0440\u0441\u0435.
      \u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C \u0441
      \u0441\u0443\u0445\u0438\u0445 \u0434\u043E\u0441\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318631
    m_Localized: "\u041E\u0441\u043A\u0430\u0440. \u041C\u043E\u043A\u0440\u044B\u0435
      \u043B\u0430\u043F\u044B \u0434\u0435\u0440\u0436\u0438\u043C \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u043A\u0430\u0440\u0442. \u041C\u043E\u043A\u0440\u044B\u043C
      \u043B\u0430\u043F\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C
      \u043F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318632
    m_Localized: "\u0424\u0435\u043B\u0438\u043A\u0441. \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0443 \u0448\u0435\u0441\u0442\u044C
      \u0440\u0430\u0437. \u0415\u0439 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043D\u0443\u0436\u0435\u043D \u0432\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318633
    m_Localized: "\u0421\u043B\u0435\u0434 \u0438\u0437\u043C\u0435\u0440\u0435\u043D.
      \u0415\u0433\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0442\u043E\u043D\u043A\u0430\u044F
      \u043B\u0430\u0442\u0443\u043D\u043D\u0430\u044F \u043A\u0440\u043E\u043C\u043A\u0430,
      \u043D\u0435 \u043C\u043E\u044F \u0448\u0438\u0440\u043E\u043A\u0430\u044F
      \u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0442\u0430\u043C\u0435\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318634
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u0435? \u0425\u043E\u0440\u043E\u0448\u043E.
      \u0412\u0441\u0451 \u0443\u0442\u0440\u043E \u0441\u043B\u044B\u0448\u0443,
      \u043A\u0430\u043A \u043E\u043D \u0441\u043A\u0440\u0435\u0431\u0451\u0442
      \u0432\u0435\u0434\u0440\u043E\u043C \u043F\u043E \u0434\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318635
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0434\u0430\u043B\u0430
      \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0443, \u0430 \u043D\u0435 \u0433\u0440\u0443\u0437.
      \u0421\u043F\u0440\u043E\u0448\u0443 \u0443 \u041D\u043E\u0440\u044B, \u0447\u0442\u043E
      \u0431\u044B\u043B\u043E \u0432 \u0437\u0430\u043A\u0430\u0437\u0435 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318636
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430. \u041D\u0430\u043F\u0438\u0441\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u043F\u0440\u0438\u0439\u0442\u0438
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u043F\u0430\u0436\u0438 \u0435\u0451
      \u043C\u0430\u043C\u0438\u043D\u043E\u0439 \u043B\u043E\u0434\u043A\u0438.
      \u0411\u0435\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
      \u043E \u043F\u043E\u0433\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318637
    m_Localized: "\u041F\u043E\u0439\u0434\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439.
      \u041F\u043E\u043A\u0430 \u041A\u043B\u0430\u0440\u0430 \u0447\u0438\u0442\u0430\u0435\u0442,
      \u043F\u043E\u043C\u043E\u0436\u0435\u043C \u0435\u0439 \u0441 \u043B\u043E\u0434\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318638
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u0430\u0440\u0443\u0441
      \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u0440\u044F\u043C\u043E. \u0412\u0441\u0451
      \u0436\u0434\u0430\u043B\u0430, \u0447\u0442\u043E \u0437\u0430\u0446\u0435\u043F\u0438\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0446\u0435\u043F\u043B\u044F\u043B\u0441\u044F \u043C\u0430\u043C\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318639
    m_Localized: "\u041E\u0442\u043C\u0435\u0442\u044C \u043F\u0440\u043E\u0441\u0432\u0435\u0442
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435. \u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043B\u043E\u0434\u043A\u0438 \u043F\u0430\u0440\u0443\u0441 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0432\u044B\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318640
    m_Localized: "\u041D\u0430 \u043A\u043E\u043F\u0438\u0438 \u0435\u0441\u0442\u044C
      \u0432\u0441\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B. \u042F
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u043F\u0440\u0438\u044E\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0447\u0438\u0442\u0435\u043B\u044C
      \u0437\u0430\u0431\u044B\u043B \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318641
    m_Localized: "\u0418 \u0434\u0430\u0442\u0443. \u0422\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442 \u043D\u0443\u0436\u043D\u043E\u0435
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0430 \u043D\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
      \u043D\u0430\u0443\u0433\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318642
    m_Localized: "\u041B\u0430\u043F\u044B \u0441\u043E\u0433\u0440\u0435\u043B\u0438\u0441\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0433\u0443 \u0437\u0430\u0441\u0442\u0435\u0433\u043D\u0443\u0442\u044C
      \u043F\u0440\u044F\u0436\u043A\u0443. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0442\u043E\u0436\u0435 \u0437\u0430\u0439\u0434\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318643
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u0441\u044E\u0434\u0430
      \u0434\u043E \u043C\u0430\u044F\u043A\u0430? \u0421 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u043E\u0439
      \u043F\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318644
    m_Localized: "\u0421\u0438\u0433\u043D\u0430\u043B \u043F\u043E\u0439\u043C\u0430\u043B
      \u043B\u0443\u0447 \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438.
      \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0433\u043E\u0440\u0438\u0442 \u043D\u0430\u0432\u0435\u0440\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318645
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u0439\u0434\u0443,
      \u043F\u043E\u0434\u0430\u0439 \u0441\u0438\u0433\u043D\u0430\u043B \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C.
      \u041D\u043E\u0440\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0437\u043D\u0430\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u043F\u043E\u043F\u0430\u043B \u0435\u0451 \u044F\u0449\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318646
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0440\u0435\u043B\u0435
      \u0433\u043E\u0442\u043E\u0432\u043E. \u0412\u043E\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435.
      \u041E\u0431\u0430 \u043B\u0438\u0441\u0442\u0430, \u043A\u0430\u043A \u0442\u044B
      \u043F\u0440\u043E\u0441\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318647
    m_Localized: "\u0410\u0434\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0430
      \u0432\u0437\u044F\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E
      \u043B\u0438\u043D\u0437\u0443. \u0417\u0434\u0435\u0441\u044C \u0432\u0435\u043B\u0435\u043D\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0412\u044B\u0441\u0448\u0438\u0439
      \u0424\u043E\u043D\u0430\u0440\u044C \u043D\u0430 \u043C\u0430\u044F\u043A\u0435.
      \u041A\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0437\u0430\u043A\u0430\u0437
      \u041D\u043E\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318648
    m_Localized: "\u041D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u0430,
      \u0431\u0443\u0434\u0442\u043E \u0441\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C
      \u0441\u0442\u0430\u043C\u0435\u0441\u043A\u0430. \u041E\u0434\u043D\u043E\u0439
      \u043C\u043E\u0435\u0439 \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0435
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318649
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439
      \u0440\u044B\u0447\u0430\u0433. \u041D\u0430 \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u043F\u043E\u0432\u044F\u0437\u0430\u043B \u043A\u0440\u0430\u0441\u043D\u0443\u044E
      \u043D\u0438\u0442\u043A\u0443: \u043D\u0435 \u0441\u043A\u0430\u0436\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0437\u0430\u0431\u044B\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318650
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u044C \u0440\u0430\u0441\u0441\u0430\u0434\u043D\u0438\u043A\u0430
      \u0433\u0440\u0435\u0435\u0442 \u043C\u043E\u043B\u043E\u0434\u044B\u0435 \u043A\u043E\u0440\u043D\u0438.
      \u0415\u0449\u0451 \u043E\u0434\u043D\u043E\u0439 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438 \u043E\u043D\u0438 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318651
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u041A\u043B\u0430\u0440\u0435
      \u0441\u0432\u0435\u0440\u0445\u0443 \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u0435.
      \u041E\u0441\u0442\u0430\u0432\u043B\u044E \u0437\u0434\u0435\u0441\u044C \u2014
      \u043E\u043F\u044F\u0442\u044C \u0443\u043D\u0435\u0441\u0443 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318652
    m_Localized: "\u041F\u043E\u0431\u0443\u0434\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0432\u0435\u0442\u0438\u043C
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0434\u043B\u044F \u043A\u043E\u0440\u0437\u0438\u043D\u044B,
      \u043F\u043E\u0442\u043E\u043C \u0432\u043C\u0435\u0441\u0442\u0435 \u0435\u0451
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318653
    m_Localized: "\u0412 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u0444\u043E\u043D\u0430\u0440\u0438
      \u0440\u044F\u0434\u043E\u043C. \u041D\u0430 \u0441\u0430\u043C\u043E\u043C
      \u0434\u0435\u043B\u0435 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0438
      \u0441\u0442\u043E\u044F\u0442 \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0445
      \u0443\u0441\u0442\u0443\u043F\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318654
    m_Localized: "\u041D\u043E\u043C\u0435\u0440 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043D\u0430 \u044D\u0442\u043E\u0439 \u043F\u043E\u043B\u043A\u0435. \u0424\u043E\u043D\u0430\u0440\u044C
      \u043F\u043E\u0433\u0430\u0441, \u0430 \u0441\u0432\u0435\u0447\u0443 \u043A
      \u0431\u0443\u043C\u0430\u0433\u0430\u043C \u044F \u043D\u0435 \u043F\u043E\u043D\u0435\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318655
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0443\u0441\u044C \u0434\u043E \u0444\u043E\u043D\u0430\u0440\u044F
      \u0441\u043D\u0438\u0437\u0443. \u041D\u0430\u0439\u0434\u0438 \u0437\u0430\u043F\u0438\u0441\u044C
      \u0437\u0430 \u0434\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u041D\u043E\u0440\u0430
      \u0437\u0430\u0431\u0438\u0440\u0430\u043B\u0430 \u044F\u0449\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318656
    m_Localized: "\u041F\u0440\u0438\u044E\u0442 \u043F\u043E\u0434 \u043D\u0430\u043C\u0438.
      \u041E\u0431\u044B\u0447\u043D\u043E \u044F \u0432\u0435\u0434\u0443 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u043C\u0438\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318657
    m_Localized: "\u041F\u0430\u043F\u043A\u0430 \u0432 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0435,
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0447\u0435\u0442\u0430\u043C\u0438
      \u0437\u0430 \u043C\u0430\u0441\u043B\u043E. \u0422\u044F\u043D\u0438 \u0437\u0430
      \u0437\u0435\u043B\u0451\u043D\u0443\u044E \u043B\u0435\u043D\u0442\u0443,
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0432\u044F\u0437\u043A\u0435
      \u0441\u0447\u0435\u0442\u0430 \u0437\u0430 \u0446\u0435\u043B\u044B\u0439
      \u0433\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318658
    m_Localized: "\u0417\u0430 \u0437\u0435\u043B\u0451\u043D\u0443\u044E. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A,
      \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318659
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435
      \u0435\u0441\u0442\u044C \u043F\u0440\u044F\u043C\u043E\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u043C\u0430\u044F\u043A\u0430 \u0441 \u044D\u0442\u043E\u0439 \u043B\u0438\u043D\u0437\u043E\u0439.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0438\u0436\u043D\u044F\u044F
      \u0446\u0435\u043F\u044C \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430 \u043F\u0440\u0438
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318660
    m_Localized: "\u0422\u0440\u0443\u0431\u044B \u0448\u0443\u043C\u044F\u0442 \u0440\u043E\u0432\u043D\u043E.
      \u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u043A\u0440\u0430\u043D \u0443 \u0434\u043E\u043C\u0430 \u0431\u0440\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318661
    m_Localized: "\u041F\u043E\u0439\u0434\u0443 \u043A \u043A\u0440\u0430\u043D\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u043C\u0430\u0448\u0443, \u0441\u0434\u0435\u043B\u0430\u0439
      \u043E\u0434\u0438\u043D \u043E\u0431\u043E\u0440\u043E\u0442 \u043A\u043E\u043B\u0435\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318662
    m_Localized: "\u041E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0434\u0440\u043E\u0436\u0438\u0442.
      \u0421\u0430\u043C \u0444\u043E\u043D\u0430\u0440\u044C \u2014 \u043D\u0435\u0442.
      \u0421\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0441\u043A\u043E\u0431\u0443,
      \u043D\u0435 \u043D\u0430 \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318663
    m_Localized: "\u041A\u0430\u043A \u0441\u0442\u044B\u043A \u0412\u0430\u043B\u044C\u0442\u0435\u0440\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u044E, \u0437\u0430
      \u0447\u0435\u043C \u0441\u043B\u0435\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318664
    m_Localized: "\u041D\u0430 \u0442\u043E\u0439 \u043F\u043E\u043B\u043A\u0435
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E\u0434\u043D\u0438\u0435 \u043A\u0430\u0440\u0442\u044B.
      \u041F\u043E\u0441\u043B\u0435 \u0431\u0443\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F, \u0438\u0434\u0438\u0442\u0435
      \u0441 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0435\u0439 \u041B\u044E\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318665
    m_Localized: "\u041F\u043E\u043C\u0435\u0442\u044C \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0441\u0435\u0439\u0447\u0430\u0441.
      \u041F\u043E\u043F\u0440\u043E\u0448\u0443 \u0435\u0451 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0442\u0443\u0434\u0430
      \u0441\u0442\u0443\u043F\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318666
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u0434\u043E\u0436\u0434\u0451\u043C \u0443 \u0444\u043E\u043D\u0430\u0440\u044F,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0443\u0432\u0438\u0434\u0438\u043C
      \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318667
    m_Localized: "\u041F\u0440\u0438\u0432\u044F\u0436\u0443 \u0441\u0443\u043C\u043A\u0443
      \u0437\u0434\u0435\u0441\u044C. \u041F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u043B\u0435\u0433\u0447\u0435, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430
      \u043D\u0435 \u0431\u043E\u043B\u0442\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318668
    m_Localized: "\u0422\u044B \u043F\u0440\u0438\u0432\u0435\u0437\u043B\u0430 \u0441\u0435\u043C\u0435\u043D\u0430
      \u0420\u043E\u0437\u044B. \u0417\u0430\u043A\u043E\u043D\u0447\u0443 \u0441
      \u043B\u0438\u043D\u0437\u043E\u0439 \u0438 \u0434\u043E\u0441\u0442\u0430\u043D\u0443
      \u0433\u043E\u0440\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318669
    m_Localized: "\u041E\u043D\u0430 \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C. \u0417\u0430\u0432\u0442\u0440\u0430
      \u043F\u043E\u0441\u0430\u0434\u0438\u043C \u0443 \u0442\u0432\u043E\u0435\u0433\u043E
      \u043E\u043A\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318670
    m_Localized: "\u041D\u043E\u0440\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430
      \u043F\u0435\u0440\u0432\u0443\u044E \u0431\u0430\u0448\u043D\u044E. \u0421
      \u0442\u0430\u043A\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u044B \u0444\u043E\u043D\u0430\u0440\u044C
      \u0432\u0438\u0434\u0435\u043D \u0441 \u043F\u043B\u0430\u043D\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318671
    m_Localized: "\u0417\u0430\u043F\u0438\u0448\u0443 \u0440\u044F\u0434\u043E\u043C
      \u0432\u044B\u0441\u043E\u0442\u0443. \u0414\u0430\u043B\u044C\u0448\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u0432\u0442\u043E\u0440\u0443\u044E
      \u0431\u0430\u0448\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318672
    m_Localized: "\u042F \u0434\u0435\u0440\u0436\u0443 \u044D\u0442\u043E\u0442
      \u043A\u043E\u043D\u0435\u0446. \u0421\u043A\u0430\u0436\u0438, \u0435\u0441\u043B\u0438
      \u043A\u0430\u043D\u0430\u0442 \u043D\u0430\u0447\u043D\u0451\u0442 \u0442\u0435\u0440\u0435\u0442\u044C\u0441\u044F
      \u043E \u0440\u0430\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318673
    m_Localized: "\u0410 \u0442\u044B \u0441\u043A\u0430\u0436\u0438, \u0435\u0441\u043B\u0438
      \u043D\u0430\u0447\u043D\u0443 \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0417\u0430\u0441\u043C\u043E\u0442\u0440\u044E\u0441\u044C \u043D\u0430 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A
      \u0438 \u0437\u0430\u0431\u044B\u0432\u0430\u044E \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u0433\u043E\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318674
    m_Localized: "\u0423\u0431\u0440\u0430\u043B\u0430 \u0438\u0437 \u043F\u0438\u0441\u044C\u043C\u0430
      \u041A\u043B\u0430\u0440\u0435 \u0432\u0441\u044E \u043F\u043E\u0433\u043E\u0434\u0443.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u043C\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u0442\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318675
    m_Localized: "\u0410 \u0447\u0442\u043E \u0442\u044B \u0445\u043E\u0442\u0435\u043B\u0430
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0435\u0439 \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0439
      \u0441\u0442\u0440\u043E\u043A\u0438 \u043F\u0440\u043E \u043F\u043E\u0433\u043E\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318676
    m_Localized: "\u0414\u0432\u0430 \u043F\u0440\u043E\u0448\u0435\u043D\u0438\u044F,
      \u0434\u0432\u0435 \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0438. \u0422\u0430\u043A
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u043F\u043E\u0434\u0448\u0438\u043B,
      \u0447\u0442\u043E \u0437\u0430\u0431\u044B\u043B: \u043E\u0442\u0432\u0435\u0442\u0430
      \u043F\u043E \u0441\u0443\u0442\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318677
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0443 \u043A\u043E\u043F\u0438\u0438
      \u0441 \u0435\u0451 \u043E\u0442\u0432\u0435\u0442\u0430\u043C\u0438. \u0425\u043E\u0447\u0443
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C, \u0447\u0435\u0433\u043E
      \u043E\u043D\u0430 \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u0436\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318678
    m_Localized: "\u041F\u0440\u043E\u0448\u0435\u043D\u0438\u044F \u041A\u043B\u0430\u0440\u044B
      \u0443 \u043C\u0435\u043D\u044F \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u0432\u0435\u0447\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C
      \u0438 \u0434\u0430\u0442\u043E\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318679
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u044C \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u041A\u043B\u0430\u0440\u044B.
      \u041D\u0430 \u043F\u043B\u0430\u043D\u0435 \u0435\u0441\u0442\u044C \u043F\u043E\u0432\u043E\u0440\u043E\u0442,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441 \u043C\u0430\u044F\u043A\u0430
      \u043D\u0435 \u0432\u0438\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318680
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0430
      \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u043A\u0430\u043D\u0430\u043B\u0430.
      \u042F \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u043D\u0430\u0434
      \u043D\u0438\u043C\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043B\u0443\u0447, \u043D\u043E \u0441 \u043B\u043E\u0434\u043A\u0438 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318681
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438 \u0435\u0451 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u041D\u043E\u0440\u043E\u0439.
      \u0418\u043C \u043D\u0443\u0436\u0435\u043D \u043E\u0434\u0438\u043D \u0438
      \u0442\u043E\u0442 \u0436\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442:
      \u0441 \u0432\u043E\u0434\u044B \u0438 \u0441 \u0432\u043E\u0437\u0434\u0443\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318682
    m_Localized: "\u0414\u043E\u0441\u043A\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0443\u0445\u0438\u043C\u0438. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443 \u0435\u0449\u0451 \u043D\u0443\u0436\u0435\u043D
      \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318683
    m_Localized: "\u042F \u043F\u043E\u043D\u0435\u0441\u0443 \u0435\u0433\u043E.
      \u0410 \u0442\u044B \u043F\u043E\u043A\u0430\u0436\u0435\u0448\u044C, \u043A\u0443\u0434\u0430
      \u043A\u043B\u0430\u0441\u0442\u044C \u0446\u0435\u043B\u044B\u0435 \u0434\u043E\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318684
    m_Localized: "\u0412\u0435\u0434\u0440\u043E \u0431\u0440\u0430\u0442\u0430 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442,
      \u0440\u0430\u0434\u0438 \u043A\u043E\u0433\u043E \u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E
      \u0445\u043E\u0434 \u043A\u043E\u043B\u0435\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318685
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C, \u043E\u0442\u043A\u0443\u0434\u0430
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318686
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435 \u0441
      \u043D\u0438\u0437\u043A\u0438\u043C \u0433\u043D\u0435\u0437\u0434\u043E\u043C.
      \u041F\u0442\u0438\u0446\u044B \u0442\u043E\u0436\u0435 \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u044D\u0442\u043E\u0439 \u0442\u0440\u043E\u043F\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318687
    m_Localized: "\u041F\u043E\u0434\u0435\u0440\u0436\u0443 \u0441\u0432\u0435\u0442
      \u043F\u043E\u043D\u0438\u0436\u0435. \u0422\u044B \u043D\u0430\u0448\u043B\u0430
      \u0441\u0443\u0445\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F
      \u0441\u0435\u043C\u044F\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318688
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u0430\u044F \u043F\u043E\u0447\u0442\u0430!
      \u041E\u0434\u043D\u0430 \u0441\u0443\u043C\u043A\u0430 \u0434\u043B\u044F
      \u043F\u0438\u0441\u0435\u043C, \u043E\u0434\u0438\u043D \u043A\u0430\u0440\u043C\u0430\u043D
      \u0434\u043B\u044F \u043C\u043E\u0435\u0433\u043E \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318689
    m_Localized: "\u042F \u043F\u043E\u043D\u0435\u0441\u0443 \u0441\u0443\u043C\u043A\u0443.
      \u0410 \u0442\u044B \u0434\u0435\u0440\u0436\u0438 \u044D\u0442\u043E\u0442
      \u043A\u0430\u0440\u043C\u0430\u043D \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318690
    m_Localized: "\u0411\u043B\u0438\u0436\u0430\u0439\u0448\u0430\u044F \u043B\u0430\u043C\u043F\u0430
      \u2014 \u043D\u0430\u0448\u0430 \u043F\u0435\u0440\u0432\u0430\u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430.
      \u042F \u043C\u043E\u0433\u0443 \u043F\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043B\u043E\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318691
    m_Localized: "\u042F \u043F\u0440\u043E\u043D\u0435\u0441\u0443 \u0441\u0432\u0435\u0442
      \u043F\u043E \u043F\u0438\u0440\u0441\u0443. \u0421\u043A\u0430\u0436\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u043B\u043E\u0434\u043A\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318692
    m_Localized: "\u041E\u0434\u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F
      \u043A\u043E\u043F\u0438\u044F. \u041E\u0434\u0438\u043D \u0441\u0443\u0445\u043E\u0439
      \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B. \u042F \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B
      \u0438\u0445 \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318693
    m_Localized: "\u042F \u0432\u0435\u0440\u043D\u0443 \u043A\u043E\u043F\u0438\u044E
      \u0441 \u043D\u0430\u0448\u0438\u043C\u0438 \u043F\u0440\u0438\u0432\u0430\u043B\u0430\u043C\u0438.
      \u041E\u0441\u0442\u0430\u0432\u044C \u043C\u043D\u0435 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318694
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0437\u0430\u043D\u0451\u0441 \u0435\u0449\u0451
      \u043E\u0434\u0438\u043D \u0437\u043D\u0430\u043A. \u0414\u0435\u0440\u0436\u0438\u0441\u044C
      \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E \u043C\u043E\u0435\u0433\u043E \u0448\u0430\u0440\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318695
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0442\u044B
      \u0442\u043E\u0436\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043C\u043E\u0438\u043C. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318696
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u044C \u0433\u043E\u0442\u043E\u0432.
      \u041C\u043E\u0438 \u043A\u043E\u043B\u0435\u043D\u0438 \u043F\u0440\u043E\u0441\u044F\u0442
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043F\u0435\u0440\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318697
    m_Localized: "\u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E. \u041F\u043E\u0442\u043E\u043C
      \u043F\u043E\u043D\u0435\u0441\u0451\u043C \u0441\u0432\u0435\u0442 \u0440\u044F\u0434\u043E\u043C,
      \u0432\u0434\u0432\u043E\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318698
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043A\u0430\u0440\u0442\u0443 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439.
      \u0414\u043B\u044F \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318699
    m_Localized: "\u042F \u043E\u0442\u043C\u0435\u0447\u0443 \u0442\u043E, \u0447\u0442\u043E
      \u0432\u0438\u0436\u0443. \u0410 \u0442\u044B \u0441\u0432\u0435\u0440\u0438\u0448\u044C
      \u0441 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318700
    m_Localized: "\u0422\u0430\u043C \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u0432\u0435\u0441\u0442\u0438 \u0434\u043B\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0438.
      \u0414\u0430\u0432\u0430\u0439 \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0441\u043E\u0431\u0435\u0440\u0451\u043C
      \u043F\u0438\u0441\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 797900375318701
    m_Localized: "\u042F \u043F\u043E\u0434\u0435\u0440\u0436\u0443 \u0444\u043E\u043D\u0430\u0440\u044C.
      \u0421\u043A\u0430\u0436\u0438, \u0435\u0441\u043B\u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0441\u0442\u0443\u043F\u0435\u043D\u044C \u0442\u043E\u0436\u0435 \u0441\u043A\u0440\u044B\u043B\u0430\u0441\u044C
      \u043F\u043E\u0434 \u0441\u043D\u0435\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 948420247281664
    m_Localized: "\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447488
    m_Localized: "\u0420\u0430\u043C\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447489
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0442\u0438\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447490
    m_Localized: "\u0423\u0431\u0440\u0430\u0442\u044C \u0441\u0442\u0438\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447491
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447492
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0437\u0430 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447493
    m_Localized: "\u0412\u0430\u043B\u044C\u0441 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447494
    m_Localized: "\u041E\u0433\u043D\u0438 \u0441\u0443\u043C\u0435\u0440\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447495
    m_Localized: "\u0421\u0430\u0434 \u043A\u0440\u044B\u043B\u044C\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447496
    m_Localized: "\u0412\u0435\u0441\u0435\u043D\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u043B\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447497
    m_Localized: "\u0417\u0435\u0440\u043A\u0430\u043B\u043E \u0441\u0442\u0440\u0435\u043A\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447498
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u043E\u0433\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447499
    m_Localized: "\u0422\u0438\u0445\u0438\u0439 \u0441\u043D\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 948420272447500
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439 \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641792
    m_Localized: "\u0426\u0432\u0435\u0442\u043E\u0447\u043D\u0430\u044F \u0440\u0435\u0437\u044C\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641793
    m_Localized: "\u041E\u0431\u043B\u0430\u0447\u043D\u044B\u0439 \u043A\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641794
    m_Localized: "\u041C\u0435\u0434\u043D\u0430\u044F \u0447\u0435\u043A\u0430\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641795
    m_Localized: "\u041B\u0443\u043D\u043D\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641796
    m_Localized: "\u041B\u0435\u043F\u0435\u0441\u0442\u043A\u0438 \u0438 \u0433\u043E\u0441\u0442\u0438
      \u0441\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641797
    m_Localized: "\u041C\u044F\u0433\u043A\u0438\u0439 \u0441\u0432\u0435\u0442 \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641798
    m_Localized: "\u0411\u0430\u0431\u043E\u0447\u043A\u0438 \u0438 \u043B\u0435\u0442\u044F\u0449\u0430\u044F
      \u043F\u044B\u043B\u044C\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641799
    m_Localized: "\u041F\u0442\u0438\u0446\u044B \u0432\u0434\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641800
    m_Localized: "\u0421\u0442\u0440\u0435\u043A\u043E\u0437\u044B \u043D\u0430\u0434
      \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641801
    m_Localized: "\u041F\u043B\u0430\u0432\u043D\u043E \u043F\u043B\u044B\u0432\u0443\u0449\u0438\u0435
      \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641802
    m_Localized: "\u0421\u043D\u0435\u0436\u0438\u043D\u043A\u0438 \u0438 \u0437\u0438\u043C\u043D\u0438\u0435
      \u043F\u0442\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641803
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u0437\u0432\u0451\u0437\u0434\u044B
      \u0438 \u043B\u0443\u043D\u043D\u044B\u0435 \u043C\u043E\u0442\u044B\u043B\u044C\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641804
    m_Localized: "\u041B\u0438\u0441\u0442\u044C\u044F \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641805
    m_Localized: "\u041F\u0435\u0440\u044C\u044F \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420276641806
    m_Localized: "\u041C\u0435\u0434\u044C \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 948420280836096
    m_Localized: "\u041B\u0443\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u043F\u043E
      \u043A\u0440\u0430\u044F\u043C \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 952944215187456
    m_Localized: "\u0424\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 978572045967360
    m_Localized: "\u0421\u0442\u044B\u043A \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.
      \u0410 \u043C\u043D\u0435 \u0432 \u043A\u0430\u0436\u0434\u043E\u043C \u0441\u043A\u0440\u0438\u043F\u0435
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0431\u0443\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161664
    m_Localized: "\u041C\u043D\u0435 \u0442\u043E\u0436\u0435. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0434\u043E\u0441\u043A\u0443
      \u0432\u043C\u0435\u0441\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161665
    m_Localized: "\u041F\u0435\u0442\u043B\u044F \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u0442\u0438\u0448\u0435. \u041C\u043E\u0438 \u043A\u043E\u043B\u0435\u043D\u0438
      \u0437\u0430\u0432\u0438\u0434\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161666
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043A\u043E\u043B\u0435\u043D\u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442. \u042F \u043F\u043E\u0431\u0443\u0434\u0443
      \u0443 \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161667
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u0443\u0436\u0435
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0412\u043E\u0442 \u0431\u044B \u0436\u0438\u0432\u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161668
    m_Localized: "\u041C\u043E\u0439 \u0442\u043E\u0436\u0435 \u0445\u043E\u0447\u0435\u0442
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F. \u0421\u043F\u0435\u0440\u0432\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A
      \u0431\u0435\u0437 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161669
    m_Localized: "\u041E\u0434\u043D\u0430 \u043B\u0430\u043C\u043F\u0430 \u0433\u043E\u0440\u0438\u0442.
      \u041F\u0435\u043A\u0430\u0440\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043E\u0442 \u0442\u0440\u0435\u0432\u043E\u0433 \u0445\u043B\u0435\u0431
      \u0433\u043E\u0440\u0438\u0442 \u0447\u0430\u0449\u0435, \u0447\u0435\u043C
      \u043E\u0442 \u043F\u0435\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161670
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u0443\u0441\u0442\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0435.
      \u041D\u0430 \u0432\u0442\u043E\u0440\u0443\u044E \u043B\u0430\u043C\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161671
    m_Localized: "\u0412\u0437\u044F\u043B \u0434\u0432\u0430 \u043E\u0431\u0435\u0434\u0430.
      \u041F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435. \u041D\u0435
      \u0437\u043D\u0430\u043B, \u0440\u0435\u0448\u0443\u0441\u044C \u043B\u0438
      \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u0445\u043E\u0442\u044F
      \u0431\u044B \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161672
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043C\u043E\u0439 \u043D\u0435
      \u043E\u0441\u0442\u044B\u043D\u0435\u0442, \u0412\u0430\u043B\u044C\u0442\u0435\u0440.
      \u0411\u0435\u0437 \u0442\u0435\u0431\u044F \u044F \u043D\u0435 \u043F\u043E\u0439\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161673
    m_Localized: "\u0417\u0430\u0446\u0435\u043F\u0438\u043B\u043E\u0441\u044C! \u0427\u0443\u0442\u044C
      \u043D\u0435 \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u043B \u043E\u0442
      \u0440\u0430\u0434\u043E\u0441\u0442\u0438 \u043F\u0440\u044F\u043C\u043E \u0432
      \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161674
    m_Localized: "\u042F \u0442\u043E\u0436\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0430.
      \u0422\u0432\u043E\u0435\u043C\u0443 \u0431\u0440\u0430\u0442\u0443 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0446\u0435\u043B\u044B\u0439
      \u043E\u0431\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161675
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0442\u043E\u043D\u043A\u0430\u044F
      \u0441\u0442\u0440\u0443\u0439\u043A\u0430. \u0420\u0430\u043D\u044C\u0448\u0435
      \u044F \u0431\u0440\u043E\u0441\u0430\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443,
      \u0435\u0434\u0432\u0430 \u043A\u043E\u043B\u0435\u0441\u043E \u0442\u0440\u043E\u0433\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161676
    m_Localized: "\u0414\u043E\u0439\u0434\u0451\u043C \u0434\u043E \u0432\u0435\u0434\u0440\u0430
      \u0442\u0432\u043E\u0435\u0433\u043E \u0431\u0440\u0430\u0442\u0430. \u0412\u043E\u0434\u0430
      \u0442\u043E\u0436\u0435 \u0434\u043E\u043B\u0436\u043D\u0430 \u0442\u0443\u0434\u0430
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161677
    m_Localized: "\u0411\u0440\u0430\u0442 \u0445\u043E\u0447\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0432\u043E\u0434\u0443. \u0410
      \u044F \u0432\u0441\u0451 \u0442\u044F\u043D\u0443\u0441\u044C \u043A \u0435\u0433\u043E
      \u0432\u0435\u0434\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161678
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442
      \u0433\u043E\u0442\u043E\u0432\u043E, \u0434\u0430\u0439 \u0435\u043C\u0443
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443. \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u0442\u043E\u044F\u0442\u044C \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161679
    m_Localized: "\u0417\u0430\u043B\u0430\u0442\u0430\u0435\u043C \u0448\u0432\u044B
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443. \u041E\u043D\u0430 \u0443\u0432\u0438\u0434\u0438\u0442,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0431\u0440\u043E\u0441\u0438\u043B
      \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161680
    m_Localized: "\u0420\u043E\u0437\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u043E\u0434\u043D\u0443 \u0447\u0430\u0448\u043A\u0443. \u042F \u0432\u0437\u044F\u043B
      \u0442\u0440\u0438. \u0423 \u043C\u0435\u043D\u044F \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u044F
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161681
    m_Localized: "\u0411\u0435\u0440\u0438 \u0447\u0430\u0448\u043A\u0438. \u042F
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0435\u0439, \u0447\u0442\u043E
      \u0442\u044B \u043D\u0435 \u0437\u0430\u0431\u044B\u043B \u043E \u0441\u0435\u043C\u0435\u043D\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161682
    m_Localized: "\u041E\u0434\u043D\u0430 \u0432\u0435\u0442\u043A\u0430 \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F.
      \u041C\u0430\u043B\u0438\u043D\u043E\u0432\u043A\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0433\u043D\u0435\u0437\u0434\u043E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043D\u0430\u043C
      \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161683
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F.
      \u0418 \u043C\u044B \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161684
    m_Localized: "\u042D\u0442\u043E\u0442 \u043A\u043E\u0440\u0435\u043D\u044C \u0441\u0442\u0430\u0440\u0448\u0435
      \u043C\u043E\u0435\u0433\u043E \u043C\u043E\u0441\u0442\u0430. \u041D\u0435
      \u0441\u0442\u0430\u043D\u0443 \u0440\u0435\u0437\u0430\u0442\u044C \u0435\u0433\u043E
      \u0440\u0430\u0434\u0438 \u043F\u0430\u0440\u044B \u0448\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161685
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u041A\u043E\u0440\u043D\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u0443\u0442\u044C \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161686
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044F.
      \u0411\u0430\u043D\u043A\u0438 \u0436\u0434\u0430\u043B\u0438 \u0442\u0430\u043A
      \u0434\u043E\u043B\u0433\u043E, \u0447\u0442\u043E \u044F \u0447\u0443\u0442\u044C
      \u043D\u0435 \u0441\u044A\u0435\u043B\u0430 \u0437\u0430\u043F\u0430\u0441
      \u043D\u0430 \u0437\u0438\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161687
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u043C \u043E\u0434\u043D\u0443
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435. \u041E\u043D\u0430 \u0437\u0430\u0445\u043E\u0447\u0435\u0442
      \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u044E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161688
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0442\u0435\u043F\u043B\u0430. \u041C\u043E\u0451 \u043F\u0435\u0440\u0432\u043E\u0435
      \u0434\u0435\u0440\u0435\u0432\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u043E\u0441\u044C
      \u0441 \u043A\u0440\u043E\u0448\u043A\u0438 \u043C\u0435\u043D\u044C\u0448\u0435
      \u0442\u0432\u043E\u0435\u0439 \u043F\u0443\u0433\u043E\u0432\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161689
    m_Localized: "\u0415\u0433\u043E \u0442\u0440\u0438 \u0441\u0435\u043C\u0435\u0447\u043A\u0430
      \u043F\u043E\u0431\u0443\u0434\u0443\u0442 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0423 \u0431\u0430\u0431\u0443\u0448\u043A\u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
      \u043E\u043A\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161690
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0448\u0430\u0440\u0444
      \u041D\u043E\u0440\u044B \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0441\u044F
      \u0437\u0430 \u0442\u0443 \u0432\u0435\u0442\u043A\u0443. \u041E\u043D\u0430
      \u043D\u0430\u0437\u0432\u0430\u043B\u0430 \u044D\u0442\u043E \u0432\u043D\u0435\u043F\u043B\u0430\u043D\u043E\u0432\u043E\u0439
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161691
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F,
      \u0441\u043A\u0430\u0436\u0438 \u0435\u0439: \u0432\u0435\u0442\u043A\u0430
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0432\u0441\u0451 \u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161692
    m_Localized: "\u041D\u0430\u0448\u043B\u0430 \u043F\u0438\u0441\u044C\u043C\u043E
      \u043C\u0430\u043B\u044B\u0448\u0443. \u042F \u043E\u043F\u043E\u0437\u0434\u0430\u043B\u0430
      \u043A \u0435\u0433\u043E \u0441\u0430\u043C\u043E\u043C\u0443 \u043F\u0435\u0440\u0432\u043E\u043C\u0443
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161693
    m_Localized: "\u041E\u043D \u0435\u0449\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u0442
      \u0441\u0432\u043E\u0439 \u043F\u0440\u0438\u0432\u0435\u0442. \u0410 \u043C\u044B
      \u043D\u0430\u0439\u0434\u0451\u043C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161694
    m_Localized: "\u0423 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0430 \u0434\u043B\u044F
      \u0431\u0430\u0431\u0443\u0448\u043A\u0438 \u0441\u0442\u0451\u0440\u043B\u0438\u0441\u044C
      \u0443\u0433\u043E\u043B\u043A\u0438. \u0422\u044B \u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u0435\u0433\u043E \u0441\u043A\u0432\u043E\u0437\u044C \u0432\u0441\u0435
      \u043F\u043E\u0440\u044B\u0432\u044B \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161695
    m_Localized: "\u041E\u0434\u043D\u0430 \u0434\u043E\u0441\u043A\u0430 \u0443\u0436\u0435
      \u043A\u0440\u0435\u043F\u043A\u0430\u044F. \u0420\u0430\u043D\u044C\u0448\u0435
      \u044F \u0434\u0443\u043C\u0430\u043B\u0430: \u0440\u0430\u0437 \u0443\u043C\u0435\u044E
      \u043B\u0435\u0442\u0430\u0442\u044C, \u043D\u0438\u043A\u0442\u043E \u043C\u043D\u0435
      \u043D\u0435 \u043D\u0443\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161696
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043F\u043E\u0441\u0430\u0434\u043A\u0438
      \u043D\u0443\u0436\u043D\u043E \u0432\u0441\u0435\u043C. \u0418 \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043E \u043D\u0451\u043C \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F,
      \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161697
    m_Localized: "\u041C\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0441\u0432\u0435\u0440\u0445\u0443. \u042F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u043D\u0430\u0445\u043E\u0436\u0443 \u043F\u043E\u0432\u043E\u0434 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043C\u0430\u0440\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161698
    m_Localized: "\u041C\u0430\u0440\u043A\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435
      \u043E\u0442\u0432\u0435\u0442\u0438\u0442, \u041D\u043E\u0440\u0430. \u0410
      \u043F\u043E\u0434\u0440\u0443\u0433\u0430 \u043C\u043E\u0436\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161699
    m_Localized: "\u0412\u0438\u0436\u0443 \u0431\u0435\u0440\u0435\u0433 \u041A\u043B\u0430\u0440\u044B.
      \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043C\u0430\u0445\u0430\u043B\u0430
      \u0441\u0432\u0435\u0440\u0445\u0443 \u0438 \u0441\u0447\u0438\u0442\u0430\u043B\u0430
      \u044D\u0442\u043E \u0432\u0438\u0437\u0438\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161700
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F, \u043F\u043E\u0431\u0443\u0434\u044C
      \u0441 \u043D\u0435\u0439. \u042F \u043F\u043E\u043D\u0435\u0441\u0443 \u0442\u0432\u043E\u044E
      \u0441\u0443\u043C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161701
    m_Localized: "\u042D\u0442\u0438 \u0434\u043E\u0441\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F.
      \u041C\u0430\u043C\u0430 \u0443\u0447\u0438\u043B\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u043E\u0433\u043E
      \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161702
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u044C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F.
      \u041C\u043D\u0435 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161703
    m_Localized: "\u041F\u043E\u043A\u0430 \u0434\u0432\u0435 \u043B\u0430\u043C\u043F\u044B.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u044E, \u0441\u043B\u044B\u0448\u0443,
      \u043A\u0430\u043A \u043C\u0430\u043C\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161704
    m_Localized: "\u041D\u0430\u0437\u043E\u0432\u0438 \u0438\u0445 \u0432\u0441\u043B\u0443\u0445.
      \u042F \u0445\u043E\u0447\u0443 \u0443\u0437\u043D\u0430\u0442\u044C \u0435\u0451
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043E\u0442 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161705
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C.
      \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u041B\u0438\u0441\u0442\u0438\u043A
      \u0441\u0442\u0443\u0447\u0438\u0442: \u0431\u0443\u0434\u0442\u043E \u044F
      \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u044E \u043A \u0443\u0436\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161706
    m_Localized: "\u041C\u044B \u0432\u0435\u0440\u043D\u0451\u043C \u043B\u043E\u0434\u043A\u0443
      \u0434\u043E\u043C\u043E\u0439. \u041F\u043E\u0434\u0435\u0440\u0436\u0438\u0448\u044C
      \u0435\u0451, \u043A\u043E\u0433\u0434\u0430 \u044F \u0431\u0443\u0434\u0443
      \u0441\u0430\u0434\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161707
    m_Localized: "\u041F\u0440\u0443\u0434\u043E\u0432\u043E\u0439 \u043E\u0433\u043E\u043D\u0451\u043A
      \u0434\u0440\u043E\u0433\u043D\u0443\u043B. \u041C\u0430\u043C\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u043B\u0430 \u0435\u0433\u043E
      \u043B\u0430\u043F\u0430\u043C\u0438, \u0432\u043E\u0442 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161708
    m_Localized: "\u042F \u043C\u043E\u0433\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0435\u0433\u043E \u0442\u0430\u043A. \u041F\u043E\u043A\u0430\u0436\u0438
      \u0435\u0449\u0451 \u0440\u0430\u0437, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043C\u044B \u0443\u0439\u0434\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161709
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043A \u0430\u0440\u0445\u0438\u0432\u0443
      \u044F\u0441\u043D\u0435\u0435. \u041E\u0441\u043A\u0430\u0440 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C, \u0447\u0442\u043E \u0442\u044B
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0448\u044C \u0437\u0430 \u0435\u0433\u043E
      \u043A\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161710
    m_Localized: "\u0421\u043F\u0435\u0440\u0432\u0430 \u0441\u0443\u0445\u0438\u0435
      \u043B\u0430\u043F\u044B. \u041F\u043E\u0442\u043E\u043C \u044F \u0441\u043F\u0440\u043E\u0448\u0443,
      \u0447\u0442\u043E \u0435\u043C\u0443 \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161711
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u0447\u0443\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F.
      \u042F \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B \u0432\u0441\u0435
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u0435\u0442\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161712
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0443\u0434\u0435\u043B\u0438\u043C
      \u043F\u0435\u0442\u043B\u0435 \u0445\u043E\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0442\u043E\u0433\u043E \u0436\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161713
    m_Localized: "\u041E\u0434\u043D\u0430 \u043F\u043E\u043B\u043A\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430.
      \u0410 \u044F \u0432\u0441\u0451 \u0442\u044F\u043D\u0443\u0441\u044C \u043A
      \u0443\u0437\u043B\u0443, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0443\u0436\u0435 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161714
    m_Localized: "\u041A\u043D\u0438\u0433\u0438 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
      \u041C\u043E\u0436\u043D\u043E \u0438 \u043B\u0430\u043F\u0430\u043C \u0434\u0430\u0442\u044C
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161715
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B
      \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u044B. \u041C\u043E\u0439
      \u0443\u0447\u0438\u0442\u0435\u043B\u044C \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445
      \u0437\u0430\u043C\u0435\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161716
    m_Localized: "\u042F \u0442\u043E\u0436\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u043C\u0435\u0441\u0442\u043E. \u042F \u0432\u0435\u0434\u044C \u043D\u0435
      \u0431\u0443\u0434\u0443 \u0437\u043D\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161717
    m_Localized: "\u0427\u0435\u0440\u043D\u0438\u043B\u0430 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F.
      \u042F \u0447\u0443\u0442\u044C \u043D\u0435 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0442\u0432\u043E\u0439 \u0448\u0430\u0440\u0444 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161718
    m_Localized: "\u0417\u0430 \u0448\u0430\u0440\u0444 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0431\u0430\u0431\u0443\u0448\u043A\u0443. \u041C\u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442
      \u0441\u0443\u0445\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161719
    m_Localized: "\u0423\u0436\u0435 \u043C\u043E\u0433\u0443 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u0443\u0433\u043E\u043B\u043E\u043A \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u043A\u0438. \u0421\u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0431\u0435\u0440\u0451\u0433 \u0435\u0451
      \u043E\u0442 \u0441\u044B\u0440\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161720
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
      \u041B\u0443\u0447\u0448\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0435\u0451 \u0441\u043B\u043E\u0432\u0430, \u0447\u0435\u043C \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0441\u043C\u0430\u0437\u0430\u0442\u044C \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161721
    m_Localized: "\u041D\u0430\u0448\u043B\u0438 \u0442\u0440\u0438 \u043B\u0430\u043C\u043F\u044B.
      \u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u0437\u043D\u0430\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0430 \u0441\u043D\u0435\u0433 \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0432\u0441\u0435 \u043C\u043E\u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161722
    m_Localized: "\u0422\u044B \u0437\u043D\u0430\u043B\u0430, \u0433\u0434\u0435
      \u0438\u0441\u043A\u0430\u0442\u044C. \u042F \u043F\u043E\u043C\u043E\u0433\u0443
      \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043C\u044B \u043E\u0431\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161723
    m_Localized: "\u0412 \u0443\u043A\u0440\u044B\u0442\u0438\u0438 \u043C\u0435\u043D\u044C\u0448\u0435
      \u0441\u043A\u0432\u043E\u0437\u0438\u0442. \u041F\u0440\u043E\u0441\u0442\u0438,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
      \u0431\u0443\u0434\u0442\u043E \u043B\u0430\u043F\u0430\u043C \u0442\u0435\u043F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161724
    m_Localized: "\u041C\u043E\u0438\u043C \u0442\u043E\u0436\u0435 \u0431\u044B\u043B\u043E
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0441\u043A\u0430\u0436\u0435\u043C \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161725
    m_Localized: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u043A\u0440\u0430\u0439
      \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D. \u041C\u043D\u0435 \u043D\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0445\u043E\u0434,
      \u043A\u043E\u043D\u0446\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0438\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161726
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u043C,
      \u043F\u043E\u043A\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u0432\u0438\u0434\u043D\u043E.
      \u042F \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u0441\u043C\u0435\u043B\u043E\u0439
      \u0438 \u043F\u043E\u0441\u043B\u0435 \u043E\u0442\u0434\u044B\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161727
    m_Localized: "\u0411\u0435\u043D \u043F\u043B\u043E\u0445\u043E \u0441\u043B\u043E\u0436\u0438\u043B
      \u043E\u0434\u0435\u044F\u043B\u043E. \u042D\u0442\u043E\u0442 \u043A\u0440\u0438\u0432\u043E\u0439
      \u0443\u0433\u043E\u043B\u043E\u043A \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
      \u0433\u0440\u0435\u043B \u043C\u043D\u0435 \u043B\u0430\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161728
    m_Localized: "\u0414\u0432\u043E\u0438\u043C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0445\u0432\u0430\u0442\u0438\u0442. \u0411\u0435\u043D \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0441\u044F
      \u043E \u0431\u043E\u043B\u044C\u0448\u0435\u043C, \u0447\u0435\u043C \u0434\u0443\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161729
    m_Localized: "\u041E\u043A\u043D\u043E \u0432\u0438\u0434\u043D\u043E \u043C\u0435\u0436\u0434\u0443
      \u043F\u043E\u0440\u044B\u0432\u0430\u043C\u0438. \u042F \u0437\u043D\u0430\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443, \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0443\u0433\u043E\u043C\u043E\u043D\u0438\u0442\u044C \u043D\u0435\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161730
    m_Localized: "\u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439.
      \u0423 \u0431\u0430\u0431\u0443\u0448\u043A\u0438 \u043B\u0430\u043C\u043F\u0430
      \u0433\u043E\u0440\u0438\u0442; \u043F\u0443\u0441\u0442\u044C \u0438 \u043C\u043E\u044F
      \u0433\u043E\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161731
    m_Localized: "\u0422\u044B \u0447\u0438\u043D\u0438\u0448\u044C \u0441\u0442\u044B\u043A,
      \u043A\u0430\u043A \u0412\u0430\u043B\u044C\u0442\u0435\u0440. \u0410 \u044F
      \u043F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u0442\u0432\u043E\u0438
      \u043B\u0430\u043F\u044B \u0435\u0434\u0432\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438
      \u0434\u043E \u043C\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161732
    m_Localized: "\u041D\u0430 \u0435\u0433\u043E \u043C\u043E\u0441\u0442\u0443
      \u043E\u043D\u0438 \u0434\u0440\u043E\u0436\u0430\u043B\u0438, \u0431\u0430\u0431\u0443\u0448\u043A\u0430.
      \u041E\u043D \u0436\u0434\u0430\u043B, \u043F\u043E\u043A\u0430 \u044F \u043D\u0435
      \u0441\u043C\u043E\u0433\u043B\u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0448\u0430\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161733
    m_Localized: "\u041E\u0434\u0438\u043D \u0431\u043B\u043E\u043A \u0443\u0436\u0435
      \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0441\u043A\u043E\u0440\u043E \u043C\u043E\u044F \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u044F
      \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u043A \u0441\u0432\u043E\u0435\u0439
      \u0440\u0430\u0431\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161734
    m_Localized: "\u0411\u0435\u043D \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u0431\u044B \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u043A\u043E\u043D\u0435\u0446.
      \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E, \u043F\u043E\u0442\u043E\u043C
      \u043F\u043E\u043C\u0435\u0448\u0430\u044E \u0441\u0443\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161735
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438
      \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F. \u042F \u0432\u0441\u0451
      \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u0430
      \u043D\u0435\u0441\u0442\u0438 \u0442\u0435\u0431\u044F, \u043A\u0430\u043A
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161736
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F \u043F\u043E\u043D\u0435\u0441\u0443
      \u0441\u0432\u0435\u0442. \u0415\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u043E,
      \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u043F\u0435\u0440\u0435\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161737
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u044C \u043F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F. \u0422\u044B
      \u043F\u0440\u043E\u043D\u0435\u0441\u043B\u0430 \u0435\u0433\u043E \u0442\u0430\u043A
      \u0434\u0430\u043B\u0435\u043A\u043E \u0438 \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B\u0430
      \u0438\u0437 \u043B\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161738
    m_Localized: "\u041D\u0435 \u043E\u0434\u043D\u0430. \u041A\u043B\u0430\u0440\u0430
      \u0434\u0435\u0440\u0436\u0430\u043B\u0430 \u043B\u043E\u0434\u043A\u0443,
      \u0430 \u041B\u044E\u043C\u0438 \u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161739
    m_Localized: "\u0412 \u043B\u0438\u043D\u0437\u0435 \u0441\u043B\u0430\u0431\u044B\u0439
      \u043E\u0442\u0431\u043B\u0435\u0441\u043A. \u042F \u0432\u0441\u0451 \u0441\u043C\u043E\u0442\u0440\u044E
      \u0432 \u043E\u043A\u043D\u043E, \u0445\u043E\u0442\u044F \u0442\u044B \u0443\u0436\u0435
      \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161740
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451 \u043C\u043E\u0436\u0435\u0442
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E\u043C\u043E\u0439.
      \u041E\u0441\u0442\u0430\u0432\u0438\u043C \u0441\u0432\u0435\u0442 \u0438
      \u0434\u043B\u044F \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161741
    m_Localized: "\u0414\u0432\u0430 \u0443\u0434\u0430\u0440\u0430 \u0441\u043E\u0432\u043F\u0430\u043B\u0438.
      \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0432\u0435\u0440\u0438\u043B
      \u0447\u0438\u0441\u043B\u0443 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u0430\u0440\u0435 \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161742
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0432\u0435\u0440\u0438\u0442\u044C
      \u043E\u0431\u043E\u0438\u043C. \u041C\u043E\u0438 \u0433\u043B\u0430\u0437\u0430
      \u0442\u043E\u0436\u0435 \u0443\u0441\u0442\u0430\u044E\u0442; \u0431\u0443\u0434\u0435\u043C
      \u0441\u043C\u0435\u043D\u044F\u0442\u044C \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161743
    m_Localized: "\u0414\u043E\u0441\u043A\u0430 \u0435\u0449\u0451 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043F\u043E\u0447\u0438\u043D\u043A\u0438. \u042F \u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0438\u0439 \u043A\u0440\u0430\u0439,
      \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161744
    m_Localized: "\u0422\u0432\u043E\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A
      \u043F\u043E\u043C\u043E\u0433 \u043D\u0430\u043C \u043D\u0430\u0439\u0442\u0438
      \u0435\u0451. \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043F\u043E\u0434\u0435\u0440\u0436\u0443
      \u0444\u043E\u043D\u0430\u0440\u044C, \u043F\u043E\u043A\u0430 \u0442\u044B
      \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C \u0434\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161745
    m_Localized: "\u042F \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B \u0447\u0430\u0441\u0442\u0438.
      \u0415\u0449\u0451 \u0435\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u0435\u043B
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u044F \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u0443\u0433\u0430\u0434\u0430\u043B \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161746
    m_Localized: "\u041E\u0442\u043C\u0435\u0442\u044C \u043F\u0440\u043E\u0431\u0435\u043B.
      \u041D\u043E\u0440\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0443\u0434\u0430
      \u043B\u0435\u0442\u0435\u0442\u044C, \u043D\u043E \u0438 \u043A\u0443\u0434\u0430
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161747
    m_Localized: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u043E\u0431\u043E\u0439. \u041E\u0441\u0442\u0430\u0432\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F
      \u043C\u043E\u0435\u0433\u043E \u0447\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161748
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0448\u0435\u0432\u0435\u043B\u044C\u043D\u0443\u043B\u0438\u0441\u044C.
      \u042F \u0432\u0441\u0451 \u0440\u0435\u043F\u0435\u0442\u0438\u0440\u0443\u044E,
      \u0447\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043F\u0443\u0442\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161749
    m_Localized: "\u041D\u0430\u0447\u043D\u0438 \u0441 \xAB\u0441\u0430\u0434\u0438\u0441\u044C
      \u0440\u044F\u0434\u043E\u043C\xBB. \u0421 \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0438\u0441\u044C
      \u043C\u043E\u0438 \u043B\u0443\u0447\u0448\u0438\u0435 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161750
    m_Localized: "\u041F\u043E\u043B\u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0437\u0430\u043B\u0430\u0442\u0430\u043D\u043E.
      \u042F \u043E\u0431\u0435\u0449\u0430\u043B \u041D\u043E\u0440\u0435 \u043B\u043E\u0434\u043A\u0443,
      \u0430 \u043D\u0435 \u043F\u043B\u0430\u0432\u0443\u0447\u0435\u0435 \u0440\u0435\u0448\u0435\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161751
    m_Localized: "\u0412\u0441\u044E \u043D\u043E\u0447\u044C \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u043B\u0430
      \u0441\u043B\u043E\u0432\u0430. \u0410 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E, \u0447\u0442\u043E \u0441\u043A\u0443\u0447\u0430\u044E
      \u043F\u043E \u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 978572050161752
    m_Localized: "\u041E\u0434\u0438\u043D \u0443\u0437\u043E\u0440 \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F.
      \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0443\u0431\u0435\u0436\u0434\u0430\u043B
      \u0441\u0435\u0431\u044F, \u0447\u0442\u043E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      \u043F\u043E\u043C\u0435\u0448\u0430\u0435\u0442 \u0442\u0438\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 988271629819904
    m_Localized: "\u0413\u0440\u0438\u0431\u043D\u0430\u044F \u0448\u043B\u044F\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014208
    m_Localized: "\u041A\u043E\u0441\u0442\u044E\u043C \u043F\u0447\u0435\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014209
    m_Localized: "\u0417\u0438\u043C\u043D\u0438\u0439 \u043A\u0430\u043F\u044E\u0448\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014210
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0439 \u043F\u0438\u0440\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014211
    m_Localized: "\u041E\u0431\u043B\u0430\u0447\u043D\u044B\u0439 \u0448\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014212
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439 \u043C\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014213
    m_Localized: "\u041B\u0438\u0441\u0442\u044C\u044F \u043D\u0430 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014214
    m_Localized: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F \u043F\u044B\u043B\u044C\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014215
    m_Localized: "\u0422\u0438\u0445\u0438\u0439 \u0441\u043D\u0435\u0433\u043E\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014216
    m_Localized: "\u041F\u0435\u0440\u044C\u044F \u0432 \u043D\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014217
    m_Localized: "\u0422\u0430\u043D\u0446\u0443\u044E\u0449\u0438\u0435 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014218
    m_Localized: "\u041C\u0435\u0440\u0446\u0430\u044E\u0449\u0438\u0435 \u0437\u0432\u0451\u0437\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014219
    m_Localized: "\u041B\u0435\u043D\u0442\u043E\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u043D\u0430\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014220
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u0430 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014221
    m_Localized: "\u0421\u043D\u044B \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014222
    m_Localized: "\u0412\u0443\u0430\u043B\u044C \u0441\u0438\u044F\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014223
    m_Localized: "\u041B\u0435\u043D\u0442\u044B \u043D\u0430 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014224
    m_Localized: "\u0411\u0443\u043C\u0430\u0436\u043D\u044B\u0435 \u043A\u0440\u044B\u043B\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014225
    m_Localized: "\u041F\u0435\u0440\u043B\u0430\u043C\u0443\u0442\u0440\u043E\u0432\u044B\u0435
      \u043F\u0443\u0437\u044B\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 988271634014226
    m_Localized: "\u0412\u043E\u043B\u043D\u044B \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u0441\u0438\u044F\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382117916672
    m_Localized: "\u042F \u043E\u0442\u043C\u0435\u0442\u0438\u043B \u043A\u0440\u0435\u043F\u043A\u0438\u0435
      \u0434\u043E\u0441\u043A\u0438. \u0417\u0430\u0432\u0442\u0440\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E
      \u043F\u0440\u043E\u0439\u0442\u0438, \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044F
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382122110976
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u044C \u043E\u0442\u043C\u0435\u0442\u043A\u0438.
      \u0421\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382122110977
    m_Localized: "\u042F \u0441\u0434\u0435\u043B\u0430\u043B \u044D\u0442\u0438
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0434\u043B\u044F \u0411\u0435\u043D\u0430.
      \u041E\u043D \u043D\u0430\u043F\u0435\u0440\u0435\u0433\u043E\u043D\u043A\u0438
      \u0431\u0435\u0433\u0430\u043B \u0441 \u0438\u0445 \u0442\u0435\u043D\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382122110978
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043A \u0435\u0433\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E
      \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382122110979
    m_Localized: "\u041C\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A
      \u0432\u0451\u0437 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0438\u043D\u0443.
      \u041F\u0430\u043F\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305280
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0445\u0440\u0430\u0431\u0440\u0430\u044F
      \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u0438\u043D\u0430. \u041C\u044B
      \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C
      \u0441 \u043C\u0430\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305281
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0431\u0443\u0440\u0438 \u0440\u044B\u043D\u043E\u043A
      \u043F\u0440\u0438\u0442\u0438\u0445. \u0421\u043A\u0443\u0447\u0430\u044E
      \u043F\u043E \u043F\u0440\u043E\u0441\u044C\u0431\u0430\u043C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305282
    m_Localized: "\u042F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443, \u043A\u0442\u043E
      \u0432\u0435\u0440\u043D\u0443\u043B \u0444\u043E\u043D\u0430\u0440\u0438.
      \u0417\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438
      \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305283
    m_Localized: "\u0421\u043A\u0430\u0436\u0438 \u0411\u0435\u043D\u0443: \u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B \u043A\u0430\u0436\u0434\u044B\u0439
      \u0431\u043E\u043B\u0442. \u041D\u0435\u0442, \u0441\u043A\u0430\u0436\u0438,
      \u0447\u0442\u043E \u044F \u0441\u0430\u043C \u043F\u0440\u0438\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305284
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0435\u043C\u0443 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435. \u041C\u043D\u0435 \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305285
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \u043A\u043E\u043B\u0435\u0441\u043E \u043D\u0430\u0434\u043E \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u0430 \u043D\u0435 \u043F\u043E\u0434\u0433\u043E\u043D\u044F\u0442\u044C.
      \u042F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0442\u0438\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305286
    m_Localized: "\u042F \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u044E \u0441
      \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0421\u043A\u0430\u0436\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C
      \u0441\u0442\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305287
    m_Localized: "\u042F \u043E\u0431\u0435\u0449\u0430\u043B \u0432\u0441\u0435\u043C
      \u0432\u043E\u0434\u0443 \u043A \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0443.
      \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u0431\u044B\u043B\u043E \u0443\u0436\u0435
      \u0442\u0440\u0438 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305288
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E
      \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u043E. \u0416\u0434\u0430\u0442\u044C
      \u043B\u0435\u0433\u0447\u0435, \u043A\u043E\u0433\u0434\u0430 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u043A\u0430\u043A \u0438\u0434\u0443\u0442 \u0434\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305289
    m_Localized: "\u041E\u043D \u0441\u0430\u043C \u0437\u0430\u0432\u044F\u0437\u0430\u043B
      \u044D\u0442\u043E\u0442 \u0443\u0437\u0435\u043B. \u042F \u0447\u0443\u0442\u044C
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u043B, \u043D\u0435
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305290
    m_Localized: "\u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u041C\u043E\u0436\u0435\u0442,
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043E\u043D \u043F\u043E\u043A\u0430\u0436\u0435\u0442
      \u043D\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305291
    m_Localized: "\u041D\u043E\u0440\u0430 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0430
      \u0442\u0443\u0442 \u043F\u0442\u0438\u0447\u043A\u0443. \u042F \u0434\u0443\u043C\u0430\u043B,
      \u044D\u0442\u043E \u043F\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305292
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u043C \u0442\u0430\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0435\u0451. \u041D\u043E\u0440\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0443\u0437\u043D\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u043B\u043E\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305293
    m_Localized: "\u042F \u0437\u0430\u0431\u044B\u043B, \u0447\u0442\u043E \u0441\u0430\u0434\u0443
      \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u043D\u0430 \u0432\u043E\u0434\u0430.
      \u0412\u0438\u0434\u0435\u043B \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0448
      \u043F\u0443\u0441\u0442\u043E\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305294
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0437\u0430\u043C\u0435\u0442\u0438\u043B.
      \u041F\u0435\u0440\u0432\u044B\u0435 \u043A\u0440\u0443\u0436\u043A\u0438 \u043E\u0442\u043D\u0435\u0441\u0451\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305295
    m_Localized: "\u0413\u043D\u0451\u0437\u0434\u0430 \u0431\u044B\u043B\u0438 \u0437\u0434\u0435\u0441\u044C
      \u0434\u043E \u043C\u043E\u0438\u0445 \u0444\u043E\u043D\u0430\u0440\u0435\u0439.
      \u042F \u0432\u0435\u0434\u044C \u0442\u043E\u0436\u0435 \u0437\u0434\u0435\u0441\u044C
      \u0433\u043E\u0441\u0442\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305296
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0435\u043C \u0442\u0438\u0445\u0438\u0439
      \u0441\u0432\u0435\u0442. \u0427\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438
      \u0434\u043E\u043C, \u0430 \u043D\u0435 \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305297
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B
      \u043F\u0440\u044F\u043C\u043E\u0439 \u043C\u043E\u0441\u0442. \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0442\u0440\u043E\u043F\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305298
    m_Localized: "\u041E\u043D \u0432\u0438\u0434\u0435\u043B \u0433\u043D\u0451\u0437\u0434\u0430?
      \u041F\u043E\u043A\u0430\u0436\u0443 \u0435\u043C\u0443 \u0442\u0435, \u0447\u0442\u043E
      \u0443 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305299
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430 \u0431\u0430\u043D\u043A\u0438
      \u0441 \u0437\u0430\u043F\u0438\u0441\u043A\u043E\u0439 \u0432\u043D\u0443\u0442\u0440\u0438.
      \u042F \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305300
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043B\u043E\u0436\u0438\u0448\u044C
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0432 \u0435\u0451 \u0431\u0430\u043D\u043A\u0443?
      \u042F \u043E\u0442\u043D\u0435\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305301
    m_Localized: "\u0421\u0435\u043C\u0435\u043D\u0430 \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u044E\u0442
      \u0432\u044B\u0440\u0430\u0441\u0442\u0438. \u0410 \u044F \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u0441\u0430\u0436\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305302
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0448\u0443 \u0443 \u0431\u0430\u0431\u0443\u0448\u043A\u0438
      \u0433\u043E\u0440\u0448\u043E\u043A. \u041D\u0430\u043F\u0438\u0448\u0435\u043C
      \u0442\u0435\u0431\u0435 \u043E \u043F\u0435\u0440\u0432\u043E\u043C \u043B\u0438\u0441\u0442\u043E\u0447\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305303
    m_Localized: "\u041D\u043E\u0440\u0430 \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u0442
      \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u043F\u043E\u0447\u0442\u0443. \u0414\u0443\u043C\u0430\u0435\u0442, \u044F
      \u0441\u0435\u0440\u0436\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305304
    m_Localized: "\u0421\u043A\u0430\u0436\u0443 \u0435\u0439, \u0447\u0442\u043E
      \u0437\u0430 \u0442\u0432\u043E\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305305
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u0432\u0441\u0435 \u0430\u0434\u0440\u0435\u0441\u0430.
      \u0410 \u0442\u0435\u0445, \u043A\u0442\u043E \u0436\u0434\u0451\u0442 \u0437\u0430
      \u0434\u0432\u0435\u0440\u044F\u043C\u0438, \u043F\u043E\u0447\u0442\u0438
      \u043D\u0435 \u0437\u043D\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305306
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043F\u043E\u0441\u0442\u0443\u0447\u0438\u043C
      \u0438 \u0434\u043E\u0436\u0434\u0451\u043C\u0441\u044F \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305307
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u0443\u043C\u043D\u044B\u043C. \u0410 \u0442\u0432\u043E\u0451 \u043F\u043E\u0445\u043E\u0436\u0435
      \u043D\u0430 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305308
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043F\u043E\u0439\u043C\u0451\u0442,
      \u043A\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B, \u0435\u0449\u0451
      \u0434\u043E \u043F\u043E\u0434\u043F\u0438\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305309
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0433\u0432\u043E\u0437\u0434\u0438 \u043F\u0440\u043E \u0437\u0430\u043F\u0430\u0441.
      \u0421\u043A\u0430\u0437\u0430\u043B: \u043F\u043E\u0441\u0430\u0434\u043A\u0430
      \u2014 \u0442\u043E\u0436\u0435 \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u043B\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305310
    m_Localized: "\u041E\u043D \u0437\u043D\u0430\u0435\u0442 \u043E \u043D\u0435\u0431\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0434\u0443\u043C\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305311
    m_Localized: "\u0415\u0441\u043B\u0438 \u041A\u043B\u0430\u0440\u0430 \u043D\u0435
      \u043E\u0442\u0432\u0435\u0442\u0438\u0442, \u0442\u044B \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0441\u043E
      \u043C\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305312
    m_Localized: "\u0414\u0430. \u041D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u0430\u0434\u0438\u043C \u0435\u0439 \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305313
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043F\u043B\u044B\u0432\u0443
      \u043D\u0430 \u0442\u0438\u0445\u043E\u0439 \u043B\u043E\u0434\u043A\u0435.
      \u041D\u0435 \u0431\u0443\u0434\u0443 \u043C\u0430\u0445\u0430\u0442\u044C
      \u0438\u0437 \u043E\u0431\u043B\u0430\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305314
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043C\u0430\u0445\u0430\u0442\u044C \u0432 \u043E\u0442\u0432\u0435\u0442
      \u0438 \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305315
    m_Localized: "\u042F \u0434\u0435\u0440\u0436\u0430\u043B\u0430 \u043C\u0430\u043C\u0438\u043D\u0443
      \u043B\u043E\u0434\u043A\u0443 \u0443 \u043F\u0440\u0438\u0447\u0430\u043B\u0430.
      \u0411\u043E\u044F\u043B\u0430\u0441\u044C \u043D\u043E\u0432\u044B\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439
      \u0432 \u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305316
    m_Localized: "\u041D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u0430\u043B\u0435\u043A\u043E. \u041F\u0435\u0440\u0432\u043E\u0435
      \u043F\u043B\u0430\u0432\u0430\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C\u0441\u044F \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305317
    m_Localized: "\u042D\u0442\u043E \u0426\u0430\u043F\u043B\u0438\u043D \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u041C\u0430\u043C\u0430 \u043D\u0430\u0437\u0432\u0430\u043B\u0430 \u0435\u0433\u043E
      \u0432 \u0447\u0435\u0441\u0442\u044C \u043F\u0442\u0438\u0446\u044B, \u0443\u043A\u0440\u0430\u0432\u0448\u0435\u0439
      \u043E\u0431\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305318
    m_Localized: "\u042D\u0442\u043E\u0442 \u044F \u0437\u0430\u043F\u043E\u043C\u043D\u044E.
      \u0418 \u0441\u043F\u0440\u044F\u0447\u0443 \u043D\u0430\u0448 \u043E\u0431\u0435\u0434
      \u043F\u043E\u0434 \u0441\u0438\u0434\u0435\u043D\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305319
    m_Localized: "\u041D\u043E\u0440\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430,
      \u0447\u0442\u043E \u043F\u0440\u0438\u0435\u0434\u0435\u0442 \u043D\u0430
      \u043B\u043E\u0434\u043A\u0435. \u0420\u0430\u043D\u044C\u0448\u0435 \u0443
      \u043D\u0435\u0451 \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305320
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438 \u0432\u0442\u043E\u0440\u0443\u044E
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443. \u0427\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u043C\u043E\u0436\u043D\u043E \u0440\u0435\u0448\u0438\u0442\u044C \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305321
    m_Localized: "\u042F \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u0437\u0430\u0431\u044B\u0442\u044C
      \u0435\u0451 \u0433\u043E\u043B\u043E\u0441, \u0435\u0441\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E
      \u0435\u0449\u0451 \u0432\u044B\u0443\u0447\u0438\u0442 \u0435\u0451 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305322
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u044F \u0442\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u044E,
      \u0432\u0441\u043F\u043E\u043C\u043D\u044E, \u043A\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u043B
      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305323
    m_Localized: "\u0421\u043A\u0430\u0436\u0438 \u041E\u0441\u043A\u0430\u0440\u0443:
      \u0435\u0433\u043E \u043F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435 \u0443
      \u043C\u0435\u043D\u044F \u0432 \u043B\u043E\u0434\u043A\u0435. \u042F \u0434\u0432\u0430\u0436\u0434\u044B
      \u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0438\u0440\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305324
    m_Localized: "\u0412\u0435\u0440\u043D\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043C.
      \u0421\u0443\u0445\u043E\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
      \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305325
    m_Localized: "\u041A\u043E \u043C\u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u043F\u0440\u0430\u0432\u0438\u043B \u043E \u043A\u043D\u0438\u0433\u0430\u0445
      \u0441\u0442\u0430\u043B\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305326
    m_Localized: "\u041F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435 \u043E\u0441\u0442\u0430\u0432\u044C.
      \u0410 \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u0448\u0435\u043F\u0442\u0430\u0442\u044C
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435 \u043C\u043E\u0436\u043D\u043E
      \u0443\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305327
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0431\u0443\u0440\u0438 \u044F
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B \u0432\u0441\u0435 \u043F\u043E\u043B\u043A\u0438.
      \u0418 \u043D\u0435 \u043C\u043E\u0433 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043B\u044E\u0431\u0438\u043C\u0443\u044E \u043A\u043D\u0438\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305328
    m_Localized: "\u041A\u0430\u043A\u0430\u044F \u043E\u043D\u0430? \u041E\u0441\u0442\u0430\u0432\u0438\u043C
      \u0435\u0451 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043B\u0435\u0433\u043A\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305329
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u044F\u0445: \u043B\u0438\u0441\u0430
      \u043D\u0430\u0448\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443. \u0423\u0447\u0438\u0442\u0435\u043B\u044C
      \u0434\u043E\u0432\u0435\u0440\u044F\u043B \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305330
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043A\u0442\u043E-\u0442\u043E
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0434\u0430\u0442\u044C
      \u043B\u0438\u0441\u0435 \u043A\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305331
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043F\u0440\u043E\u043B\u0438\u043B\u0430
      \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0447\u0430\u0439.
      \u042F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B \u043F\u044F\u0442\u043D\u043E
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u043F\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305332
    m_Localized: "\u041E\u043D\u0430 \u0437\u0430\u0441\u043C\u0435\u0451\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443.
      \u0412\u0441\u0435\u0433\u0434\u0430 \u0432\u0438\u043D\u0438\u043B\u0430 \u0447\u0430\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305333
    m_Localized: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439, \u0430 \u043D\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0435\u0451. \u041F\u043E\u0437\u0434\u043D\u043E \u044F \u044D\u0442\u043E
      \u043F\u043E\u043D\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305334
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u0437\u0434\u0435\u0441\u044C.
      \u0414\u0430\u0448\u044C \u043A\u043E\u043F\u0438\u044E \u0434\u043B\u044F
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u0443\u0442\u043D\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305335
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430\u0441\u044C
      \u043F\u043E \u0441\u0432\u043E\u0438\u043C \u0441\u043B\u0435\u0434\u0430\u043C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u044F\u0434\u043E\u043C \u0442\u0432\u043E\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305336
    m_Localized: "\u0414\u0432\u0435 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u0431\u0443\u0434\u0435\u0442
      \u043B\u0435\u0433\u0447\u0435 \u043D\u0430\u0439\u0442\u0438 \u043D\u0430
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305337
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0435
      \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043E\u0434\u0435\u044F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305338
    m_Localized: "\u041C\u043D\u0435 \u043B\u0443\u0447\u0448\u0435 \u0438\u0434\u0442\u0438
      \u0437\u0430 \u0441\u043E\u0433\u0440\u0435\u0442\u043E\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0435\u0439.
      \u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438 \u044D\u0442\u043E\u0442
      \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305339
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043C\u043E\u0441\u0442 \u0437\u0432\u0435\u043D\u0435\u043B
      \u0437\u0438\u043C\u043E\u0439. \u041F\u043E \u0437\u0432\u0443\u043A\u0443
      \u044F \u0437\u043D\u0430\u043B\u0430, \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0436\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305340
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C\u0441\u044F
      \u0438 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305341
    m_Localized: "\u042F \u0434\u043E\u043B\u0436\u043D\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0411\u0435\u043D\u0443. \u0422\u0430\u043A \u0438 \u043D\u0435 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0430
      \u0437\u0430 \u043F\u043E\u0441\u044B\u043B\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305342
    m_Localized: "\u041D\u043E\u0440\u0430 \u043E\u0442\u043D\u0435\u0441\u0451\u0442.
      \u041E\u043D\u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0447\u0438\u0442\u0441\u044F
      \u0436\u0434\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305343
    m_Localized: "\u0414\u043E\u0432\u0435\u0434\u0443 \u0442\u0435\u0431\u044F \u0434\u043E
      \u0434\u0432\u0435\u0440\u0438. \u041F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C,
      \u043A\u0430\u043A \u043E\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305344
    m_Localized: "\u0417\u0430\u0445\u043E\u0434\u0438 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442 \u0435\u0449\u0451 \u0447\u0430\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305345
    m_Localized: "\u042F \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0431\u043E\u0434\u0440\u0443\u044E
      \u0432\u0441\u0442\u0440\u0435\u0447\u0443. \u0410 \u0445\u043E\u0442\u0435\u043B\u0430
      \u043B\u0438\u0448\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0442\u0432\u043E\u0438
      \u0448\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305346
    m_Localized: "\u0421\u043E \u043C\u043D\u043E\u0439 \u043D\u0435 \u043D\u0430\u0434\u043E
      \u0445\u0440\u0430\u0431\u0440\u0438\u0442\u044C\u0441\u044F, \u0431\u0430\u0431\u0443\u0448\u043A\u0430.
      \u042F \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305347
    m_Localized: "\u0413\u043E\u0434\u0430\u043C\u0438 \u0447\u0438\u043D\u0438\u043B\u0430
      \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u0441\u0430\u043C\u0430.
      \u041F\u043E\u0437\u0432\u0430\u0442\u044C \u0412\u0430\u043B\u044C\u0442\u0435\u0440\u0430
      \u2014 \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C
      \u0432\u043E\u0437\u0440\u0430\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305348
    m_Localized: "\u0415\u043C\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.
      \u0422\u044B \u0442\u043E\u0436\u0435 \u0435\u043C\u0443 \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305349
    m_Localized: "\u0422\u0432\u043E\u044F \u043B\u0430\u043F\u043A\u0430 \u0435\u0434\u0432\u0430
      \u043F\u043E\u043C\u0435\u0449\u0430\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u0442\u0443\u043F\u0435\u043D\u044C\u043A\u0435.
      \u0422\u044B \u0432\u0441\u0451 \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305350
    m_Localized: "\u0418 \u0441\u0435\u0439\u0447\u0430\u0441 \u0445\u043E\u0447\u0443.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u044E:
      \u043C\u043E\u0436\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u0435\u0431\u044F
      \u0437\u0430 \u043B\u0430\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305351
    m_Localized: "\u042F \u0431\u0435\u0440\u0435\u0433\u043B\u0430 \u044F\u0440\u043A\u0438\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C, \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0441\u044F, \u043A\u0430\u043A
      \u044F \u0443\u0441\u0442\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305352
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u044F \u043F\u043E\u0434\u0435\u0436\u0443\u0440\u044E.
      \u0410 \u0442\u044B \u0441\u044F\u0434\u044C \u0442\u0430\u043C, \u043E\u0442\u043A\u0443\u0434\u0430
      \u0435\u0433\u043E \u0432\u0438\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305353
    m_Localized: "\u0417\u0430 \u043C\u0430\u044F\u043A\u043E\u043C \u0424\u0435\u043B\u0438\u043A\u0441
      \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u043E\u0434\u0438\u043D. \u041D\u0430\u0434\u043E
      \u0431\u044B\u043B\u043E \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
      \u0435\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305354
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0451\u043C \u0435\u043C\u0443 \u0447\u0430\u0439.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0441\u0432\u0435\u0442 \u043F\u0440\u0438\u0434\u0451\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0433\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305355
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B, \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
      \u043D\u0435\u0431\u043E. \u041C\u043E\u0436\u0435\u0442, \u044F \u0440\u0430\u0437\u0443\u0447\u0438\u043B\u0441\u044F
      \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305356
    m_Localized: "\u042F \u0432\u0441\u0442\u0430\u043D\u0443 \u0437\u0434\u0435\u0441\u044C.
      \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0448\u044C,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
      \u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305357
    m_Localized: "\u042D\u0442\u043E\u0442 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F
      \u0441\u0435\u0441\u0442\u0440\u044B. \u041E\u043D\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305358
    m_Localized: "\u0427\u0442\u043E \u043E\u043D\u0430 \u043B\u044E\u0431\u0438\u043B\u0430
      \u0438\u0441\u043A\u0430\u0442\u044C? \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C
      \u0432 \u0435\u0451 \u043B\u044E\u0431\u0438\u043C\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305359
    m_Localized: "\u041E\u0441\u043A\u0430\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u043D\u0430
      \u043A\u0430\u0440\u0442\u0435. \u042F \u0447\u0443\u0442\u044C \u043D\u0435
      \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B \u0435\u0433\u043E, \u043D\u0435
      \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0432 \u0432\u0432\u0435\u0440\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305360
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u043C \u043C\u0435\u0441\u0442\u043E
      \u0442\u043E\u043C\u0443, \u0447\u0435\u0433\u043E \u043C\u044B \u043E\u0431\u0430
      \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305361
    m_Localized: "\u041C\u043D\u0435 \u044D\u0442\u0430 \u0433\u0440\u0443\u043F\u043F\u0430
      \u0437\u0432\u0451\u0437\u0434 \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430
      \u0447\u0430\u0439\u043D\u0438\u043A. \u0412 \u043A\u043D\u0438\u0433\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E: \u043A\u043E\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305362
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0432\u044B\u0431\u0440\u0430\u043B\u0430
      \u0431\u044B \u0447\u0430\u0439\u043D\u0438\u043A. \u0423 \u043D\u0435\u0431\u0430
      \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0434\u0432\u0430
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 1027382126305363
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u0437\u0430\u043F\u0440\u0443
      \u0434\u0432\u0435\u0440\u044C. \u0412\u0434\u0440\u0443\u0433 \u043A\u0442\u043E-\u0442\u043E
      \u0437\u0430\u0445\u043E\u0447\u0435\u0442 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u043D\u0430\u0448\u0443 \u043D\u0430\u0445\u043E\u0434\u043A\u0443."
