  - m_Id: 570283323809793
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809794
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809795
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0431\u0435\u0437
      \u043E\u0448\u0438\u0431\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809796
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0445\u043E\u0434\u043E\u0432
      \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0432\u0451\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809797
    m_Localized: "\u0425\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809798
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809799
    m_Localized: "\u0412\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 584621170352128
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u044B \u0438 \u0440\u0435\u043A\u043E\u0440\u0434
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0440\u0435\u0436\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057918808064
    m_Localized: "\u0411\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196672
    m_Localized: "\u0421\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196673
    m_Localized: "\u041D\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196674
    m_Localized: "\u0422\u043E\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196675
    m_Localized: "\u041B\u044E\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196676
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196677
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196678
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196679
    m_Localized: "\u041A \u043A\u0430\u0440\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196680
    m_Localized: "\u042F \u0411\u0440\u0430\u043C. \u0411\u0443\u0440\u044F \u0441\u043B\u043E\u043C\u0430\u043B\u0430
      \u043C\u043E\u0441\u0442\u044B. \u042F \u043F\u043E\u0447\u0438\u043D\u044E
      \u0434\u043E\u0441\u043A\u0438, \u0430 \u0442\u044B \u043F\u043E\u043C\u043E\u0433\u0438
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043E\u0433\u043E\u043D\u044C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196681
    m_Localized: "\u042F \u041F\u0438\u043F. \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0432\u0441\u0442\u0430\u043B\u0430. \u0411\u0435\u0437 \u043D\u0435\u0451
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0435\u0442 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196682
    m_Localized: "\u042F \u0420\u0443. \u0414\u0435\u0440\u0435\u0432\u044C\u044F-\u0444\u043E\u043D\u0430\u0440\u0438
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438. \u0414\u0430\u0436\u0435 \u043F\u0442\u0438\u0446\u044B
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438
      \u0433\u043D\u0451\u0437\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196683
    m_Localized: "\u0421\u043E\u0440\u0430, \u043D\u0435\u0431\u0435\u0441\u043D\u0430\u044F
      \u043F\u043E\u0447\u0442\u0430! \u0425\u043E\u0442\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u044F \u043F\u0435\u0448\u043A\u043E\u043C. \u0412\u0435\u0442\u0435\u0440
      \u0440\u0430\u0437\u043D\u0451\u0441 \u0432\u0441\u0435 \u043F\u0438\u0441\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196684
    m_Localized: "\u042F \u041D\u0435\u0440\u0438. \u0424\u043E\u043D\u0430\u0440\u0438
      \u0443 \u043F\u0440\u0443\u0434\u0430 \u043F\u043E\u0433\u0430\u0441\u043B\u0438.
      \u041C\u043E\u0438 \u043B\u043E\u0434\u043E\u0447\u043A\u0438 \u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196685
    m_Localized: "\u042F \u0422\u043E\u043C\u0430, \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043A\u0430\u0440\u0442. \u0411\u0443\u0440\u044F \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043A \u043C\u0430\u044F\u043A\u0443
      \u0441\u0440\u0435\u0434\u0438 \u044D\u0442\u0438\u0445 \u043F\u043E\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196686
    m_Localized: "\u042F \u041B\u044E\u043C\u0438. \u042F \u0437\u043D\u0430\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u0441\u043D\u0435\u0433.
      \u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435,
      \u043E\u0442 \u043E\u0433\u043E\u043D\u044C\u043A\u0430 \u043A \u043E\u0433\u043E\u043D\u044C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196687
    m_Localized: "\u041C\u0438\u043A\u0430! \u0412\u043E\u0442 \u0438 \u0442\u044B.
      \u041C\u0430\u044F\u043A \u043F\u043E\u0433\u0430\u0441, \u043D\u043E \u044F
      \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430 \u0434\u043B\u044F \u0442\u0435\u0431\u044F
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196688
    m_Localized: "\u042F \u041C\u0438\u043A\u0430. \u042F \u043D\u0435\u0441\u0443
      \u043E\u0433\u043E\u043D\u0451\u043A \u0431\u0430\u0431\u0443\u0448\u043A\u0435
      \u043D\u0430 \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u044F\u043A.
      \u041D\u0430\u0447\u043D\u0451\u043C \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196689
    m_Localized: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u043C \u0435\u0451.
      \u0425\u043E\u0447\u0443 \u0441\u043D\u043E\u0432\u0430 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196690
    m_Localized: "\u0417\u0430\u0436\u0436\u0451\u043C \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0434\u043D\u043E \u0434\u0435\u0440\u0435\u0432\u043E. \u0422\u043E\u0433\u0434\u0430
      \u043F\u0442\u0438\u0446\u044B \u043F\u043E\u043A\u0430\u0436\u0443\u0442 \u043D\u0430\u043C
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196691
    m_Localized: "\u041E\u0434\u043D\u043E \u0438\u0437 \u044D\u0442\u0438\u0445
      \u043F\u0438\u0441\u0435\u043C \u0434\u043B\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0438.
      \u041D\u0430\u0439\u0434\u0451\u043C \u0435\u0433\u043E \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196692
    m_Localized: "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0441 \u0444\u043E\u043D\u0430\u0440\u044F\u043C\u0438.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0431\u0435\u0440\u0435\u0433\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196693
    m_Localized: "\u041C\u044B \u0443\u0436\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0430\u0432\u0430\u0439 \u043D\u0430\u0439\u0434\u0451\u043C
      \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196694
    m_Localized: "\u041B\u0430\u043F\u043A\u0438 \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0438,
      \u0437\u0430\u0442\u043E \u0444\u043E\u043D\u0430\u0440\u044C \u0435\u0449\u0451
      \u0442\u0451\u043F\u043B\u044B\u0439. \u0412\u0435\u0434\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196695
    m_Localized: "\u0418 \u044F \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430
      \u0441\u0432\u043E\u0439, \u0431\u0430\u0431\u0443\u0448\u043A\u0430. \u0414\u0430\u0432\u0430\u0439
      \u0432\u0435\u0440\u043D\u0451\u043C \u0438\u0445 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196696
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u043E\u0431\u043B\u0430\u0447\u043D\u044B\u0439
      \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196697
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B
      \u041F\u0438\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196698
    m_Localized: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438 \u043A\u043E\u043B\u0435\u0441\u043E
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196699
    m_Localized: "\u041D\u0430\u043F\u043E\u043B\u043D\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u043A\u043E\u043B\u043E\u0434\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196700
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u0441\u0430\u0434\u0430
      \u0420\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196701
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F-\u0444\u043E\u043D\u0430\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196702
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438 \u043C\u043E\u0441\u0442 \u0438\u0437
      \u0432\u0435\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196703
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0442\u0440\u043E\u043F\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0441\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196704
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u0434\u043E\u043C\u0438\u043A \u0434\u043B\u044F
      \u0441\u0435\u043C\u044F\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196705
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439
      \u043F\u043E\u0447\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196706
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196707
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438 \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439
      \u043C\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196708
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u043E\u0439
      \u043B\u0430\u0433\u0443\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196709
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u0444\u043E\u043D\u0430\u0440\u0438
      \u0443 \u043F\u0440\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196710
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0432\u043E\u0434\u044F\u043D\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196711
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u0430\u0440\u0445\u0438\u0432 \u0422\u043E\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196712
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043C\u043E\u0441\u0442 \u0433\u043E\u0440\u0438\u0442.
      \u042F \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0436\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196713
    m_Localized: "\u0418 \u044F \u0432\u0438\u0436\u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0448\u0430\u0433. \u0423\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196714
    m_Localized: "\u0412\u0435\u0442\u0440\u043E\u0432\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0414\u0435\u0440\u0436\u0438
      \u0448\u0430\u0440\u0444, \u041C\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196715
    m_Localized: "\u0414\u0435\u0440\u0436\u0443! \u0422\u0435\u043F\u0435\u0440\u044C
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196716
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u043D\u0435
      \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F \u0441 \u0441\u0430\u043C\u043E\u0439
      \u0431\u0443\u0440\u0438. \u0423 \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390976
    m_Localized: "\u0423 \u043D\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u0422\u0432\u043E\u0438 \u043D\u043E\u0432\u044B\u0435 \u0434\u043E\u0441\u043A\u0438
      \u043C\u0435\u043D\u044F \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390977
    m_Localized: "\u0420\u044B\u043D\u043E\u043A \u0441\u043D\u043E\u0432\u0430 \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F.
      \u042F \u0441\u043A\u0443\u0447\u0430\u043B \u043F\u043E \u0437\u0430\u043F\u0430\u0445\u0443
      \u0442\u0451\u043F\u043B\u043E\u0433\u043E \u0445\u043B\u0435\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390978
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u043C \u0445\u043B\u0435\u0431
      \u0434\u043B\u044F \u041F\u0438\u043F\u0430. \u041E\u043D \u043D\u0430\u0441
      \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390979
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435
      \u0433\u043E\u0442\u043E\u0432\u0430. \u042F \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u044E
      \u0437\u0430 \u043C\u043E\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390980
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0411\u0440\u0430\u043C.
      \u041A\u043E\u0433\u0434\u0430 \u043C\u0430\u044F\u043A \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F,
      \u0442\u044B \u0443\u0432\u0438\u0434\u0438\u0448\u044C \u0435\u0433\u043E
      \u043E\u0442\u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390981
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439! \u041A\u043E\u043B\u0435\u0441\u043E
      \u0441\u043D\u043E\u0432\u0430 \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390982
    m_Localized: "\u0411\u0443\u0434\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390983
    m_Localized: "\u0412\u043E\u0434\u0430 \u0441\u043D\u043E\u0432\u0430 \u0438\u0434\u0451\u0442
      \u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0434\u043E\u043C\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390984
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u043D\u043E\u0441\u0438\u0442\u044C \u0435\u0451 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390985
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0446\u044B \u043F\u043E\u043B\u043D\u044B.
      \u0414\u0430\u0436\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435
      \u0432\u0435\u0434\u0440\u043E \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0434\u043E
      \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390986
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0438 \u0442\u0432\u043E\u0439
      \u043C\u043B\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442 \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390987
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043F\u043B\u044B\u0432\u0451\u0442. \u041D\u0430
      \u043D\u0435\u0439 \u043F\u0438\u0441\u044C\u043C\u043E \u0442\u0432\u043E\u0435\u0439
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390988
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u043B\u0435\u0436\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u043E \u0434\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390989
    m_Localized: "\u0420\u0443 \u0436\u0434\u0451\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442
      \u0441\u0430\u0434\u0430. \u0421\u043A\u0430\u0436\u0438 \u0435\u0439, \u0447\u0442\u043E
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390990
    m_Localized: "\u0421\u043A\u0430\u0436\u0443. \u041E\u0441\u0442\u0430\u0432\u044C
      \u043D\u0430\u043C \u0447\u0430\u044E \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390991
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u044C\u044F-\u0444\u043E\u043D\u0430\u0440\u0438
      \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F. \u0421\u043C\u043E\u0442\u0440\u0438,
      \u043F\u0442\u0438\u0446\u044B \u043D\u0430\u0448\u043B\u0438 \u0433\u043D\u0451\u0437\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390992
    m_Localized: "\u041E\u043D\u0438 \u043F\u043E\u044E\u0442 \u0433\u0440\u043E\u043C\u0447\u0435,
      \u0447\u0435\u043C \u0441\u0432\u0435\u0442\u0438\u0442 \u043C\u043E\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390993
    m_Localized: "\u041C\u043E\u0441\u0442 \u0438\u0437 \u0432\u0435\u0442\u043E\u043A
      \u043A\u0440\u0435\u043F\u043A\u0438\u0439. \u041A\u043E\u0440\u0437\u0438\u043D\u044B
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043A\u0430\u0447\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390994
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u042F \u0447\u0443\u0442\u044C
      \u043D\u0435 \u0443\u0440\u043E\u043D\u0438\u043B\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E
      \u043F\u0438\u0441\u044C\u043C\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390995
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.
      \u0421\u043D\u043E\u0432\u0430 \u0441\u043C\u043E\u0433\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u0432\u0430\u0440\u0435\u043D\u044C\u0435 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390996
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442
      \u0440\u0435\u0446\u0435\u043F\u0442. \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390997
    m_Localized: "\u0421\u0435\u043C\u0435\u043D\u0430\u043C \u0442\u0435\u043F\u043B\u043E
      \u0438 \u0441\u0443\u0445\u043E. \u0421\u043A\u043E\u0440\u043E \u0432\u044B\u0440\u0430\u0441\u0442\u0443\u0442
      \u043D\u043E\u0432\u044B\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390998
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043E\u0433\u043E\u043D\u044C\u043A\u0438
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u0439\u0434\u0451\u0442
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390999
    m_Localized: "\u0418\u0434\u0438 \u0437\u0430 \u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u0448\u0430\u0440\u0444\u043E\u043C. \u0421\u043E\u0440\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u0442\u0435\u0431\u044F \u043A \u043F\u043E\u0447\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391000
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0434\u0440\u0443\u0433
      \u0432 \u043F\u0443\u0442\u0438. \u041C\u043D\u0435 \u044D\u0442\u043E \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391001
    m_Localized: "\u0412\u0441\u0435 \u043F\u0438\u0441\u044C\u043C\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u044B.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391002
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435
      \u2014 \u0431\u0430\u0431\u0443\u0448\u043A\u0435. \u0411\u0435\u0440\u0435\u0433\u0438
      \u0435\u0433\u043E \u043E\u0442 \u0434\u043E\u0436\u0434\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391003
    m_Localized: "\u0422\u0432\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u0432
      \u043F\u0443\u0442\u0438. \u042F \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430
      \u0435\u0433\u043E \u0432 \u0441\u0430\u043C\u0443\u044E \u043D\u0430\u0434\u0451\u0436\u043D\u0443\u044E
      \u0441\u0443\u043C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391004
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u044F \u0438\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391005
    m_Localized: "\u042D\u0442\u043E\u0442 \u043C\u043E\u0441\u0442 \u0441\u043D\u043E\u0432\u0430
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0432\u0435\u0441\u044C
      \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391006
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443 \u043E\u0442 \u0434\u0440\u0443\u0437\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391007
    m_Localized: "\u041A\u043E\u0440\u0437\u0438\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C!
      \u041C\u043D\u0435 \u0431\u044B \u0442\u043E\u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u043D\u0430\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391008
    m_Localized: "\u041D\u0430\u043F\u0438\u0448\u0438: \xAB\u042F \u0441\u043A\u0443\u0447\u0430\u043B\u0430\xBB.
      \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0447\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391009
    m_Localized: "\u041D\u0435\u0440\u0438 \u0436\u0434\u0451\u0442 \u0443 \u043B\u0430\u0433\u0443\u043D\u044B.
      \u041E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u043B\u043E\u0434\u043A\u0438
      \u0438\u0437 \u043B\u0438\u0441\u0442\u044C\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391010
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443 \u043C\u043E\u0435\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0432\u0441\u0435\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043F\u0430\u0440\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391011
    m_Localized: "\u041F\u0440\u0438\u0447\u0430\u043B \u0441\u043D\u043E\u0432\u0430
      \u0446\u0435\u043B\u044B\u0439. \u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u0431\u043B\u0438\u0436\u0435, \u041C\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973888
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C.
      \u041E\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0432\u043E\u0434\u044B
      \u043B\u0430\u043F\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973889
    m_Localized: "\u0423 \u043D\u0430\u0448\u0438\u0445 \u0444\u043E\u043D\u0430\u0440\u0435\u0439
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0434\u0432\u043E\u0439\u043D\u0438\u043A\u0438
      \u0432 \u0432\u043E\u0434\u0435. \u0412\u0438\u0434\u0438\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973890
    m_Localized: "\u0414\u0432\u0430 \u043E\u0433\u043E\u043D\u044C\u043A\u0430 \u0438\u0437
      \u043E\u0434\u043D\u043E\u0433\u043E. \u0411\u0430\u0431\u0443\u0448\u043A\u0435
      \u0431\u044B \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168192
    m_Localized: "\u0412\u043E\u0434\u044F\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u041B\u043E\u0434\u043E\u0447\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168193
    m_Localized: "\u041C\u0430\u044F\u043A \u0435\u0449\u0451 \u0442\u0451\u043C\u043D\u044B\u0439.
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0431\u0430\u0431\u0443\u0448\u043A\u0430
      \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168194
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0443 \u043F\u0440\u0443\u0434\u0430
      \u0433\u043E\u0440\u0438\u0442 \u0440\u043E\u0432\u043D\u043E. \u0414\u0430\u0436\u0435
      \u0440\u044B\u0431\u044B \u043F\u0440\u0438\u043F\u043B\u044B\u043B\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168195
    m_Localized: "\u0411\u0443\u0434\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B \u043F\u043B\u0430\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168196
    m_Localized: "\u0423 \u0422\u043E\u043C\u044B \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0442\u0430
      \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0415\u0433\u043E \u0430\u0440\u0445\u0438\u0432 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168197
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u041D\u0435\u0440\u0438.
      \u0412\u0435\u0440\u043D\u0443\u0441\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u0444\u043E\u043D\u0430\u0440\u0438 \u0437\u0430\u0433\u043E\u0440\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168198
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u0438\u0437 \u043B\u0438\u0441\u0442\u044C\u0435\u0432
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430. \u0412\u044B\u0442\u0440\u0438
      \u043B\u0430\u043F\u043A\u0438, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u041A\u0430\u0440\u0442\u044B \u0441\u0442\u0430\u0440\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168199
    m_Localized: "\u0411\u0443\u0434\u0443 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430.
      \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u0430 \u0432\u0441\u0435\u0433\u043E
      \u043E\u0434\u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168200
    m_Localized: "\u041F\u043E\u043B\u043A\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B.
      \u042F \u0441\u043D\u043E\u0432\u0430 \u043C\u043E\u0433\u0443 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043B\u044E\u0431\u0438\u043C\u0443\u044E \u043A\u043D\u0438\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168201
    m_Localized: "\u041E \u0447\u0451\u043C \u043E\u043D\u0430? \u042F \u0431\u044B
      \u043F\u043E\u0447\u0438\u0442\u0430\u043B\u0430 \u0435\u0451 \u0441 \u0431\u0430\u0431\u0443\u0448\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168202
    m_Localized: "\u0412\u043E\u0442 \u043A\u0430\u0440\u0442\u0430 \u0431\u0443\u0440\u0438.
      \u0421\u043D\u0435\u0436\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432\u0435\u0434\u0451\u0442 \u043F\u0440\u044F\u043C\u043E \u043A \u043C\u0430\u044F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168203
    m_Localized: "\u041D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0434\u0430\u043B\u0435\u043A\u043E.
      \u041D\u043E \u043F\u043E\u0439\u0434\u0451\u043C \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
      \u0448\u0430\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168204
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0441\u0443\u0445\u0430\u044F.
      \u0422\u0432\u043E\u0439 \u0448\u0430\u0440\u0444 \u0441\u043F\u0430\u0441
      \u0447\u0435\u0440\u043D\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168205
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0435\u0433\u043E \u0441\u0432\u044F\u0437\u0430\u043B\u0430.
      \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u043D\u0430\u043B\u0430,
      \u0447\u0442\u043E \u043E\u043D \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168206
    m_Localized: "\u042D\u0442\u043E \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0438:
      \xAB\u042F \u0436\u0434\u0443. \u041D\u0430 \u043F\u043B\u0438\u0442\u0435
      \u0441\u0443\u043F\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168207
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0435 \u0434\u0430\u0434\u0438\u043C
      \u0435\u043C\u0443 \u043E\u0441\u0442\u044B\u0442\u044C. \u0413\u0434\u0435
      \u041B\u044E\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168208
    m_Localized: "\u0421\u0442\u0443\u043F\u0435\u043D\u0438 \u0432 \u0441\u043D\u0435\u0433\u0443
      \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F. \u0414\u0435\u0440\u0436\u0438\u0441\u044C
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362496
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0432\u0438\u0436\u0443
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0434\u0430\u0436\u0435 \u0441\u0440\u0435\u0434\u0438
      \u044D\u0442\u043E\u0439 \u0431\u0435\u043B\u0438\u0437\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362497
    m_Localized: "\u0412 \u043F\u0440\u0438\u044E\u0442\u0435 \u0441\u043D\u043E\u0432\u0430
      \u0442\u0435\u043F\u043B\u043E. \u041C\u043E\u0436\u043D\u043E \u0434\u0430\u0442\u044C
      \u043B\u0430\u043F\u043A\u0430\u043C \u043E\u0442\u0434\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362498
    m_Localized: "\u0421\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
      \u0425\u043E\u0447\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435 \u043E\u0431\u043E \u0432\u0441\u0435\u0445,
      \u043A\u043E\u0433\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362499
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u0430\u0440\u043A\u0430
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0422\u044B \u043F\u0440\u043E\u0448\u043B\u0430
      \u0438 \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
      \u0432\u043D\u0438\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362500
    m_Localized: "\u042F \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u043D\u0430
      \u0442\u0432\u043E\u0439 \u0448\u0430\u0440\u0444. \u042D\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362501
    m_Localized: "\u041E\u0434\u0435\u044F\u043B\u043E \u041F\u0438\u043F\u0430 \u0441\u0443\u0445\u043E\u0435.
      \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u043B, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u043D\u0435 \u043C\u0451\u0440\u0437\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362502
    m_Localized: "\u041E\u043D \u043F\u043E\u043C\u043D\u0438\u043B. \u0412\u0435\u0440\u043D\u0443
      \u0435\u0433\u043E \u0441 \u0437\u0430\u043F\u0438\u0441\u043A\u043E\u0439
      \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362503
    m_Localized: "\u0412\u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0430 \u043A
      \u043C\u0430\u044F\u043A\u0443. \u041E\u0442\u0441\u044E\u0434\u0430 \u0432\u0438\u0434\u043D\u043E
      \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E \u043E\u043A\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362504
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0432 \u043E\u043A\u043D\u0435!
      \u041E\u043D\u0430 \u043F\u0440\u0430\u0432\u0434\u0430 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362505
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u043E\u0441\u0442
      \u0433\u043E\u0440\u0438\u0442. \u0418\u0434\u0438 \u0441\u044E\u0434\u0430,
      \u0434\u0430\u0439 \u043D\u0430 \u0442\u0435\u0431\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362506
    m_Localized: "\u042F \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
      \u0431\u0430\u0431\u0443\u0448\u043A\u0430. \u0412 \u043E\u0434\u043D\u043E
      \u043F\u0438\u0441\u044C\u043C\u043E \u043D\u0435 \u043F\u043E\u043C\u0435\u0441\u0442\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362507
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u0444\u043E\u043D\u0430\u0440\u044F
      \u0433\u043E\u0442\u043E\u0432. \u041A\u0442\u043E \u043F\u043E\u043C\u043E\u0433
      \u0442\u0435\u0431\u0435 \u0434\u043E\u0439\u0442\u0438 \u0441\u044E\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362508
    m_Localized: "\u0411\u0440\u0430\u043C, \u041F\u0438\u043F, \u0420\u0443... \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0440\u0443\u0437\u0435\u0439. \u0425\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u043D\u0430\u0441 \u0443\u0432\u0438\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362509
    m_Localized: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044D\u0442\u0438
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0435\u0431\u0435 \u0442\u0430\u043A\u0438\u043C\u0438 \u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362510
    m_Localized: "\u0418 \u0441\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u0436\u0443\u0442\u0441\u044F.
      \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0437\u043D\u0430\u044E,
      \u043A\u0430\u043A \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362511
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0439 \u0444\u043E\u043D\u0430\u0440\u044C
      \u043F\u043E\u0434\u043D\u044F\u0442. \u0422\u0432\u043E\u0439 \u043E\u0433\u043E\u043D\u0451\u043A
      \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362512
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u0431\u044B\u043B\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u041D\u043E \u0434\u0440\u0443\u0437\u044C\u044F
      \u0431\u044B\u043B\u0438 \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556800
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u041C\u0438\u043A\u0430.
      \u041C\u0430\u044F\u043A \u0441\u0438\u044F\u0435\u0442. \u041D\u0430\u0441
      \u0432\u0438\u0434\u043D\u043E \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043E\u0441\u0442\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556801
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u043C\u0430\u0448\u0435\u043C
      \u0432\u0441\u0435\u043C. \u041C\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u043E\u043C\u043E\u0439 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556802
    m_Localized: "\u041B\u0430\u043F\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442.
      \u0414\u0430\u0432\u0430\u0439 \u0432\u044B\u0434\u043E\u0445\u043D\u0435\u043C
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0434\u043E\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556803
    m_Localized: "\u0412\u044B\u0434\u043E\u0445, \u043F\u043E\u0442\u043E\u043C
      \u0448\u0430\u0433. \u042D\u0442\u043E \u044F \u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556804
    m_Localized: "\u0414\u043E\u0441\u043A\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430.
      \u041C\u043E\u0439 \u043C\u043E\u043B\u043E\u0442\u043E\u043A \u0438 \u0442\u0432\u043E\u0451
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u2014 \u0445\u043E\u0440\u043E\u0448\u0430\u044F
      \u043A\u043E\u043C\u0430\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556805
    m_Localized: "\u0422\u0432\u043E\u0439 \u043C\u043E\u043B\u043E\u0442\u043E\u043A
      \u043A\u0443\u0434\u0430 \u0433\u0440\u043E\u043C\u0447\u0435 \u043C\u043E\u0435\u0433\u043E
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556806
    m_Localized: "\u042F \u0440\u0430\u043D\u044C\u0448\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u043B
      \u043A\u043E\u043B\u0435\u0441\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u043C\u043E\u043A\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556807
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0434\u0432\u0438\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751104
    m_Localized: "\u0421\u043B\u044B\u0448\u0438\u0448\u044C \u043E\u0442\u0441\u044E\u0434\u0430
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751105
    m_Localized: "\u0414\u0430. \u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751106
    m_Localized: "\u041F\u043E \u043E\u0434\u043D\u043E\u0439 \u0432\u0435\u0442\u043A\u0435.
      \u0422\u0430\u043A \u0440\u0430\u0441\u0442\u0451\u0442 \u0434\u0435\u0440\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751107
    m_Localized: "\u0410 \u043C\u044B \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751108
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u0442\u0438\u0446\u0430
      \u043B\u0435\u0442\u0438\u0442 \u0437\u0430 \u0442\u0432\u043E\u0438\u043C
      \u0444\u043E\u043D\u0430\u0440\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751109
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043B\u0435\u0442\u0438\u0442.
      \u0414\u043B\u044F \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u0440\u0443\u0433\u0430 \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751110
    m_Localized: "\u041B\u0435\u0442\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u043E
      \u044F \u0443\u043C\u0435\u044E. \u0421\u0435\u0441\u0442\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u2014 \u0432\u043E\u0442 \u0447\u0442\u043E \u0442\u0440\u0443\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751111
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0430\u043C \u043E\u0431\u0435\u0438\u043C
      \u0435\u0441\u0442\u044C \u0447\u0435\u043C\u0443 \u0443\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751112
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043F\u0438\u0441\u044C\u043C\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E: \xAB\u041F\u0440\u0438\u0445\u043E\u0434\u0438
      \u043D\u0430 \u0447\u0430\u0439\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751113
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u042F
      \u0431\u044B \u043F\u043E\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751114
    m_Localized: "\u041F\u0440\u0443\u0434 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0442\u0438\u0445\u0438\u0439. \u041C\u043E\u0436\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751115
    m_Localized: "\u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u0434\u0443\u043C\u0430\u044E
      \u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945408
    m_Localized: "\u041C\u043E\u044F \u0441\u0430\u043C\u0430\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u043B\u043E\u0434\u043A\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043B\u044B\u0432\u0451\u0442
      \u0434\u043B\u0438\u043D\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945409
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043B\u044E\u0431\u0443\u0435\u0442\u0441\u044F
      \u0432\u0438\u0434\u043E\u043C. \u042F \u0442\u043E\u0436\u0435 \u043B\u044E\u0431\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945410
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u044B\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041A\u0430\u043A \u0443 \u043A\u043D\u0438\u0433
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945411
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043C\u0435\u0448\u043D\u0443\u044E
      \u043A\u043D\u0438\u0433\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945412
    m_Localized: "\u042F \u043E\u0442\u043C\u0435\u0442\u0438\u043B \u043D\u0430\u0448\u0435
      \u043C\u0435\u0441\u0442\u043E. \u0414\u043E\u0440\u043E\u0433\u0443 \u043D\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945413
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044F \u0437\u0430\u0431\u044B\u0432\u0430\u044E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945414
    m_Localized: "\u0421\u043D\u0435\u0433 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439,
      \u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435
      \u0435\u0433\u043E \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945415
    m_Localized: "\u041E\u0434\u043D\u043E \u0441\u0443\u0445\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043B\u0430\u043F\u043E\u043A. \u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945416
    m_Localized: "\u0423\u0448\u0438 \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0432\u0435\u0442\u0435\u0440\u043E\u043A.
      \u041F\u043E\u0434\u043E\u0436\u0434\u0451\u043C, \u043F\u043E\u043A\u0430
      \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945417
    m_Localized: "\u041F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945418
    m_Localized: "\u042F \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u043B\u0430
      \u044D\u0442\u0438 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0441 \u0442\u043E\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945419
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0433\u043E\u043D\u044C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945420
    m_Localized: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F.
      \u042F \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945421
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u0441\u0434\u0435\u043B\u0430\u044E
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945422
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435: {0}. \u041D\u0430\u0447\u043D\u0451\u043C,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 593227919908864
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435.
      \u0418 \u043F\u043E\u0439\u0434\u0451\u043C \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 599985858011136
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0434\u0443\u0435\u0442
      \u0432\u0435\u0442\u0435\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 599985862205440
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0441\u0434\u0432\u0438\u043D\u0443\u043B
      \u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 600492383133696
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0432\u0435\u0441\u044C \u0440\u044F\u0434
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438,
      \u043A\u0430\u043A \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 605650634661888
    m_Localized: "\u041C\u043E\u0440\u043E\u0437\u043D\u0430\u044F \u043A\u043E\u043B\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856192
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u043A \u043A\u043E\u043B\u0431\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0436\u0435 \u0437\u043D\u0430\u043A. \u0411\u043E\u043C\u0431\u0430
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430.
      \u0414\u043E\u0441\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856193
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0430\u0434 \u043C\u043E\u0440\u043E\u0437\u043D\u043E\u0439
      \u043A\u043E\u043B\u0431\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u0443 \u0441
      \u0435\u0451 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438. \u0411\u043E\u043C\u0431\u0430
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442 \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u044D\u0442\u043E\u0442. \u0414\u043E\u0441\u043A\u0430
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856194
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443
      \u043A\u043E\u043B\u0431\u044B. \u0411\u043E\u043C\u0431\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442
      \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856195
    m_Localized: "\u0411\u043E\u043C\u0431\u0430 \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 613809549991936
    m_Localized: "\u0412\u0435\u0449\u0438 \u0434\u043B\u044F \u043F\u0443\u0442\u0438:
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0438 \u0442\u0440\u043E\u0444\u0435\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 613809554186240
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 643232689020928
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043E {0} \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186752
    m_Localized: "\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186753
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u0444\u0435\u0439 \u0438\u043B\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186754
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186755
    m_Localized: "\u041F\u0440\u043E\u0431\u0430: +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186756
    m_Localized: "\u041C\u043E\u043D\u0435\u0442 \u043F\u043E\u043A\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186757
    m_Localized: "\u0414\u0432\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B. \u0414\u0430\u043B\u044C\u0448\u0435
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186758
    m_Localized: "\u0414\u0432\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      \u0437\u0430 \u044D\u0442\u0430\u043F. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u2014 \u0434\u043E \u0434\u0432\u0443\u0445 \u0437\u0432\u0451\u0437\u0434.
      \u041F\u044F\u0442\u044C \u0437\u0432\u0451\u0437\u0434 \u2014 \u0437\u0430
      \u0441\u0432\u043E\u0451 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186759
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043D\u0435 \u0441\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186760
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043C\u043E\u0436\u043D\u043E
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0438\u0433\u0440\u0435.
      \u041F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0438\u0445 \u043D\u0435
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186761
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 644963959300096
    m_Localized: "\u041F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 644963963494400
    m_Localized: "\u0414\u043E 2 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u0437\u0430 \u044D\u0442\u0430\u043F. \u0421 \u043D\u0438\u043C\u0438 \u2014
      \u0434\u043E 2 \u0437\u0432\u0451\u0437\u0434 \u0437\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 644963963494401
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D
      \xB7 \u0431\u0435\u0437 \u043E\u043F\u043B\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 644963963494402
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u043D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 644963963494403
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043F\u043E\u043A\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 644963963494404
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043C\u043E\u0436\u043D\u043E
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 673947791122432
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 673947795316736
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 673947795316737
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u0440
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 673947795316738
    m_Localized: "\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439.
      \u0427\u0438\u0442\u0430\u0442\u044C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 673947795316739
    m_Localized: "\u0427\u0438\u0442\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 676262187098112
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 676262241624064
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043D\u0430
      \u0443\u0440\u043E\u0432\u043D\u0435 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 676262241624065
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0445\u043E\u0434\u043E\u0432
      \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0432\u0451\u0437\u0434.
      \u0418\u0433\u0440\u0430\u0439 \u0441\u043D\u043E\u0432\u0430 \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0439
      \u0440\u0435\u043A\u043E\u0440\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 689485263134720
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0440\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 689485288300544
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043E\u0431\u043C\u0435\u043D\u0430 \u0432\u0435\u0442\u0435\u0440 \u0441\u0434\u0432\u0438\u043D\u0435\u0442
      \u0440\u044F\u0434. \u0414\u043E\u0441\u043A\u0430 \u043C\u043E\u0436\u0435\u0442
      \u0442\u0440\u0435\u0441\u043D\u0443\u0442\u044C. \u041F\u0440\u043E\u0434\u0443\u043C\u0430\u0439
      \u0445\u043E\u0434 \u0438\u043B\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u0441\u044C
      \u0434\u043E \u043F\u043E\u0440\u044B\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 689485288300545
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043E\u0431\u043C\u0435\u043D\u0430
      \u2014 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0440\u044B\u0432.
      \u041C\u043E\u0436\u043D\u043E \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647616
    m_Localized: "\u0421\u0432\u0435\u0442 \u0432 \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647617
    m_Localized: "\u0411\u0443\u0440\u044F \u043F\u043E\u0433\u0430\u0441\u0438\u043B\u0430
      \u043E\u0433\u043D\u0438 \u043D\u0430\u0448\u0438\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432.
      \u042F \u0431\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C \u0443 \u0411\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u043C\u0430\u044F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647618
    m_Localized: "\u042F \u043E\u0442\u043D\u0435\u0441\u0443 \u0442\u0435\u0431\u0435
      \u043D\u0430\u0448 \u043E\u0433\u043E\u043D\u0451\u043A. \u0412\u043E\u0442
      \u0431\u044B \u043C\u043E\u0441\u0442\u044B \u0431\u044B\u043B\u0438 \u043F\u043E\u043D\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647619
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647620
    m_Localized: "\u042F \u0441\u0442\u0440\u043E\u0438\u043B \u044D\u0442\u0438
      \u043C\u043E\u0441\u0442\u044B. \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043E\u0431\u043B\u043E\u043C\u043A\u0438 \u2014 \u0441\u043B\u043E\u0432\u043D\u043E
      \u0442\u0435\u0440\u044F\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0445 \u0434\u0440\u0443\u0437\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647621
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043C\u044B \u0434\u0430\u0434\u0438\u043C
      \u0438\u043C \u043D\u043E\u0432\u044B\u0435 \u0434\u043E\u0441\u043A\u0438.
      \u041F\u043E\u0431\u0443\u0434\u0435\u0448\u044C \u0440\u044F\u0434\u043E\u043C,
      \u043F\u043E\u043A\u0430 \u044F \u043F\u0435\u0440\u0435\u0445\u043E\u0436\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647622
    m_Localized: "\u041E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647623
    m_Localized: "\u0411\u0440\u0430\u043C. \u041C\u0430\u0441\u0442\u0435\u0440,
      \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C \u0445\u043B\u0435\u0431\u0430
      \u0438 \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0440\u0443\u0433
      \u0432 \u043F\u0443\u0442\u0438. \u042F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647624
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0434\u0438\u043D
      \u043C\u043E\u0441\u0442. \u041C\u0430\u044F\u043A \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442,
      \u043F\u043E\u043A\u0430 \u043C\u044B \u0441\u0434\u0435\u043B\u0430\u0435\u043C
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0448\u0430\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647625
    m_Localized: "\u0422\u0438\u0445\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647626
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u041F\u0438\u043F\u0430 \u043F\u0435\u043B\u0430 \u0446\u0435\u043B\u044B\u0439
      \u0434\u0435\u043D\u044C. \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0451\u0434\u0440\u0430
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u043F\u0443\u0441\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647627
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0443 \u0434\u043E\u0436\u0434\u044C.
      \u0410 \u0432\u043E\u0434\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0442\u0435\u0447\u0451\u0442 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E,
      \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647628
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647629
    m_Localized: "\u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0432\u0441\u0451 \u0441\u0440\u0430\u0437\u0443. \u0411\u043E\u043B\u044C\u0448\u0435
      \u0432\u0441\u0435\u0433\u043E \u0432\u043E\u0434\u044B \u0434\u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043C\u043E\u0435\u043C\u0443 \u0431\u0440\u0430\u0442\u0438\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647630
    m_Localized: "\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0432\u0435\u0434\u0440\u043E\u043C.
      \u041E\u043D \u0432\u0435\u0440\u0438\u0442, \u0447\u0442\u043E \u0442\u044B
      \u0432\u0441\u0451 \u043F\u043E\u0447\u0438\u043D\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647631
    m_Localized: "\u0412\u043E\u0434\u0430 \u0434\u043B\u044F \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647632
    m_Localized: "\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u044D\u0442\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u0435. \u041F\u043E\u043C\u043E\u0433\u0438
      \u043D\u0430\u0447\u0430\u0442\u044C \u0441 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u0435\u0441\u0430, \u041C\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647633
    m_Localized: "\u041E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u0441\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043E\u0434\u0438\u043D \u043A\u043E\u043B\u043E\u0434\u0435\u0446.
      \u0411\u0443\u0434\u0435\u043C \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u043D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u0448\u0430\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647634
    m_Localized: "\u0421\u0430\u0434 \u0431\u0435\u0437 \u0444\u043E\u043D\u0430\u0440\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647635
    m_Localized: "\u0411\u0435\u0437 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0445\u0441\u044F
      \u043F\u043B\u043E\u0434\u043E\u0432 \u0420\u044E \u043F\u0442\u0438\u0446\u044B
      \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u044E\u0442 \u043C\u0438\u043C\u043E
      \u0441\u0432\u043E\u0438\u0445 \u0433\u043D\u0451\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647636
    m_Localized: "\u0414\u043E\u043C \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u043B\u0435\u0433\u043A\u043E \u043D\u0430\u0439\u0442\u0438. \u0414\u0430\u0432\u0430\u0439
      \u0437\u0430\u0436\u0436\u0451\u043C \u0434\u043B\u044F \u043D\u0438\u0445
      \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647637
    m_Localized: "\u0421\u0435\u043C\u0435\u043D\u0430 \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647638
    m_Localized: "\u042F \u0441\u043F\u0430\u0441\u043B\u0430 \u0441\u0435\u043C\u0435\u043D\u0430
      \u0440\u0430\u043D\u044C\u0448\u0435 \u043F\u043B\u043E\u0434\u043E\u0432.
      \u0417\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u043C\u0443 \u0434\u043D\u044E
      \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u043D\u0430 \u0437\u0430\u0431\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647639
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u044F \u043F\u043E\u043D\u0435\u0441\u0443
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E? \u0412 \u043A\u0430\u0440\u043C\u0430\u043D\u0435
      \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u044B\u043C \u043F\u0438\u0441\u044C\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647640
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0432\u0435\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647641
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u0438\u0445 \u0432 \u0442\u0435\u043F\u043B\u0435.
      \u0420\u0430\u0437\u0431\u0443\u0434\u0438\u043C \u043E\u0434\u043D\u043E \u0434\u0435\u0440\u0435\u0432\u043E,
      \u0430 \u043F\u0442\u0438\u0446\u044B \u0443\u043A\u0430\u0436\u0443\u0442
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647642
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0432\u0435\u0449\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0447\u0435\u043D\u044C
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607473647643
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u0430 \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841920
    m_Localized: "\u0421\u043E\u0440\u0430 \u0437\u043D\u0430\u0435\u0442 \u0432\u0441\u0435
      \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0411\u0443\u0440\u044F \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043B\u0430
      \u043F\u043E \u043D\u0438\u043C \u043F\u0438\u0441\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841921
    m_Localized: "\u0413\u0434\u0435-\u0442\u043E \u0442\u0430\u043C \u0435\u0441\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E \u0434\u043B\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0438.
      \u041C\u044B \u0435\u0433\u043E \u043D\u0430\u0439\u0434\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841922
    m_Localized: "\u041D\u0435\u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841923
    m_Localized: "\u042F \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0432\u0441\u0435\u043C
      \u043F\u0438\u0441\u044C\u043C\u0430. \u0410 \u043C\u043E\u0451 \u0443\u0436\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0441\u044F\u0446\u0435\u0432
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841924
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043D\u0430\u043F\u0438\u0448\u0435\u0448\u044C
      \u0435\u0433\u043E, \u043F\u043E\u043A\u0430 \u044F \u0447\u0438\u043D\u044E
      \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u043C\u043E\u0441\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841925
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043C\u0435\u0436\u0434\u0443
      \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841926
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043C
      \u044D\u0442\u0438 \u043F\u0438\u0441\u044C\u043C\u0430 \u0434\u043E\u043C\u043E\u0439.
      \u041F\u043E\u0442\u043E\u043C \u044F \u043D\u0430\u0439\u0434\u0443 \u043F\u0435\u0440\u0432\u0443\u044E
      \u0444\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841927
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C
      \u0441 \u0442\u043E\u0433\u043E, \u043F\u043E \u0447\u0435\u043C\u0443 \u0441\u043A\u0443\u0447\u0430\u0435\u0448\u044C.
      \u042F \u0442\u0430\u043A \u043D\u0430\u0447\u0430\u043B \u043F\u0438\u0441\u044C\u043C\u043E
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841928
    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0439 \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841929
    m_Localized: "\u041B\u0430\u0433\u0443\u043D\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0431\u043B\u0435\u0441\u0442\u0438\u0442, \u043A\u0430\u043A \u0441\u0442\u0435\u043A\u043B\u043E,
      \u043D\u043E \u043B\u043E\u0434\u043A\u0438 \u041D\u0435\u0440\u0438 \u043D\u0435
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841930
    m_Localized: "\u041E\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0432\u043E\u0434\u044B
      \u0443 \u043C\u0435\u043D\u044F \u0434\u0440\u043E\u0436\u0430\u0442 \u043B\u0430\u043F\u043A\u0438.
      \u041D\u043E \u044F \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C
      \u0441 \u043F\u0440\u0438\u0447\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841931
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u043B\u043E\u0434\u043E\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841932
    m_Localized: "\u041C\u0430\u043C\u0430 \u043F\u043E\u043C\u043E\u0433\u043B\u0430
      \u043C\u043D\u0435 \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u044D\u0442\u0443
      \u043B\u043E\u0434\u043A\u0443. \u042F \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u0431\u0435\u0440\u0435\u0447\u044C \u0435\u0451 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841933
    m_Localized: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0444\u043E\u043D\u0430\u0440\u044F. \u0414\u043E \u043D\u0435\u0433\u043E
      \u044F \u0434\u043E\u0431\u0435\u0440\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841934
    m_Localized: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841935
    m_Localized: "\u041D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u0442\u044C \u0445\u0440\u0430\u0431\u0440\u044B\u043C.
      \u042F \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0443 \u043B\u043E\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841936
    m_Localized: "\u0410 \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u043F\u0435\u0440\u0432\u0443\u044E
      \u043F\u0440\u0438\u0441\u0442\u0430\u043D\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
      \u0434\u043B\u044F \u043D\u0430\u0441 \u043E\u0431\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841937
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u043B\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841938
    m_Localized: "\u0422\u043E\u043C\u0430 \u0445\u0440\u0430\u043D\u0438\u0442 \u043A\u0430\u0440\u0442\u044B
      \u0432\u0441\u0435\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432 \u0432
      \u041C\u0448\u0438\u0441\u0442\u043E\u043C \u0430\u0440\u0445\u0438\u0432\u0435.
      \u0414\u043E\u0436\u0434\u044C \u043F\u0440\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841939
    m_Localized: "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043D\u0435\u0433. \u041F\u043E \u043F\u0443\u0442\u0438
      \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u043A\u0440\u044B\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841940
    m_Localized: "\u0421\u0431\u0435\u0440\u0435\u0436\u0451\u043D\u043D\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841941
    m_Localized: "\u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0432 \u043E\u0434\u043D\u043E\u043C \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0435.
      \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043D\u0430 \u043F\u043E\u043B\u043A\u0435,
      \u0435\u0441\u043B\u0438 \u0442\u044B \u0435\u0451 \u0437\u0430\u0431\u0435\u0440\u0451\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841942
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
      \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u044B \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841943
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0432 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841944
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u043F\u043E\u0434 \u0447\u044C\u0438\u043C\u0438-\u0442\u043E
      \u043B\u0430\u043F\u0430\u043C\u0438. \u041F\u043E\u043C\u043E\u0433\u0443
      \u0442\u0435\u0431\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u0443, \u041C\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841945
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0430\u0440\u0445\u0438\u0432
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441
      \u043D\u0430\u043C\u0438 \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841946
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841947
    m_Localized: "\u0421\u043D\u0435\u0433 \u0443\u043A\u0440\u044B\u043B \u0442\u0451\u043F\u043B\u044B\u0435
      \u043E\u0433\u043D\u0438 \u0442\u0440\u043E\u043F\u044B. \u0414\u0430\u0436\u0435
      \u041B\u044E\u043C\u0438 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0445\u0440\u0435\u0431\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841948
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0438
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u044E\u0442 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841949
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443 \u0442\u043E\u0436\u0435
      \u043D\u0443\u0436\u0435\u043D \u0434\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841950
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u044D\u0442\u0443 \u0433\u043E\u0440\u0443.
      \u041D\u043E \u043D\u0435 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u043D\u0435\u0436\u0438\u043D\u043A\u0443.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u0440\u0436\u0438\u0441\u044C
      \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841951
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0438\u0434\u0442\u0438
      \u0441 \u043E\u0434\u043D\u0438\u043C \u0444\u043E\u043D\u0430\u0440\u0451\u043C.
      \u0410 \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E\u0433\u043E \u0448\u0430\u0440\u0444\u0430
      \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u0434\u0432\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841952
    m_Localized: "\u041E\u0434\u0438\u043D \u0442\u0451\u043F\u043B\u044B\u0439 \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841953
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u0436\u0436\u0451\u043C
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438. \u0422\u043E\u0433\u0434\u0430
      \u0433\u043E\u0440\u0430 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
      \u043D\u0430\u043C \u0441\u0432\u043E\u0438 \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841954
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841955
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0432 \u043E\u043A\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841956
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u043B\u0430\u043C\u043F\u0443 \u0432 \u043E\u043A\u043D\u0435, \u043F\u043E\u043A\u0430
      \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u044F\u043A \u0431\u044B\u043B
      \u0442\u0451\u043C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841957
    m_Localized: "\u042F \u0443\u0432\u0438\u0434\u0435\u043B \u0435\u0451 \u0441\u043E
      \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0422\u044B \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u044F \u043F\u0440\u0438\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841958
    m_Localized: "\u0418\u0441\u0442\u043E\u0440\u0438\u0438 \u0443 \u043F\u043E\u0440\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841959
    m_Localized: "\u042F \u043D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C.
      \u041F\u043E\u0433\u0440\u0435\u0439 \u043B\u0430\u043F\u043A\u0438 \u0438
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438, \u043A\u0442\u043E \u0442\u0435\u0431\u0435
      \u043F\u043E\u043C\u043E\u0433\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841960
    m_Localized: "\u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0440\u0443\u0437\u0435\u0439.
      \u042F \u043F\u0440\u0438\u043D\u0451\u0441 \u0434\u043E\u043C\u043E\u0439
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0447\u0430\u0441\u0442\u0438\u0447\u043A\u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841961
    m_Localized: "\u0414\u0432\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F,
      \u043E\u0434\u0438\u043D \u0441\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841962
    m_Localized: "\u041C\u043E\u0438 \u043A\u043E\u043B\u0435\u043D\u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0435 \u043B\u044E\u0431\u044F\u0442 \u044D\u0442\u0438 \u0441\u0442\u0443\u043F\u0435\u043D\u0438.
      \u041F\u043E\u043D\u0435\u0441\u0451\u0448\u044C \u0441\u0432\u0435\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u043C\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841963
    m_Localized: "\u0414\u0430, \u0431\u0430\u0431\u0443\u0448\u043A\u0430. \u0417\u0430\u0436\u0436\u0451\u043C
      \u0441\u0432\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0432\u0438\u0434\u044F\u0442
      \u043D\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841964
    m_Localized: "\u041D\u0430\u0434 \u043C\u0430\u044F\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841965
    m_Localized: "\u041C\u0430\u044F\u043A \u0441\u0438\u044F\u0435\u0442. \u041D\u043E
      \u043D\u0430\u0434 \u0435\u0433\u043E \u043E\u0431\u043B\u0430\u043A\u0430\u043C\u0438
      \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0435\u043C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841966
    m_Localized: "\u0422\u0430\u043C \u0434\u0435\u0436\u0443\u0440\u0438\u0442 \u0410\u0441\u0442\u0435\u0440.
      \u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430
      \u0442\u044B \u043C\u043E\u0433 \u0431\u044B \u043E\u0442\u043D\u0435\u0441\u0442\u0438
      \u0435\u043C\u0443 \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841967
    m_Localized: "\u041D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841968
    m_Localized: "\u042F \u0410\u0441\u0442\u0435\u0440. \u0421 \u043C\u043E\u0438\u0445
      \u043A\u0430\u0440\u0442 \u0438\u0441\u0447\u0435\u0437\u043B\u0438 \u0437\u0432\u0451\u0437\u0434\u044B.
      \u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0432\u0441\u0451 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841969
    m_Localized: "\u0423 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0430 \u0435\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0434\u0432\u043E\u0438\u0445.
      \u041C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u043E\u0431\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841970
    m_Localized: "\u041F\u0443\u0442\u044C \u0434\u043B\u044F \u043D\u043E\u0447\u043D\u044B\u0445
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841971
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0435\u0449\u0451 \u043D\u0435
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430. \u041D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439,
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0430\u0442\u044C \u0441
      \u043B\u0443\u043D\u043D\u043E\u0433\u043E \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841972
    m_Localized: "\u0414\u043B\u044F \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430
      \u043D\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0432\u0441\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841973
    m_Localized: "\u041C\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u043C\u043E\u0441\u0442
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0431\u0435\u0437 \u0434\u043E\u0441\u043E\u043A.
      \u042F \u0441\u0431\u0435\u0440\u0451\u0433 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043B\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841974
    m_Localized: "\u0422\u044B \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C
      \u0434\u043E\u0441\u043A\u0438, \u0411\u0440\u0430\u043C. \u0410 \u044F \u043F\u0440\u0438\u043D\u0435\u0441\u0443
      \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841975
    m_Localized: "\u0412\u0435\u0442\u0440\u043E\u0432\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0441\u043A\u0440\u0438\u043F\u044F\u0442, \u043A\u0430\u043A \u043C\u043E\u0438
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043A\u043E\u043B\u0435\u043D\u0438.
      \u0422\u0443\u0442 \u043D\u0443\u0436\u043D\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430\u044F
      \u043B\u0430\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841976
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F
      \u0443\u0431\u0435\u0440\u0443 \u0448\u0430\u0440\u0444 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u043F\u0435\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841977
    m_Localized: "\u042F \u0434\u0432\u0430\u0436\u0434\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A.
      \u0418 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432\u043E\u043B\u043D\u0443\u044E\u0441\u044C
      \u0437\u0430 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841978
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0447\u0438\u043D\u0438\u043C
      \u0435\u0433\u043E, \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841979
    m_Localized: "\u041F\u0435\u043A\u0430\u0440\u044C \u0441 \u0440\u044B\u043D\u043A\u0430
      \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430 \u043D\u0430\u043C \u0445\u043B\u0435\u0431.
      \u0415\u0451 \u0444\u043E\u043D\u0430\u0440\u0438 \u0442\u043E\u0436\u0435
      \u043D\u0430\u0434\u043E \u0441\u043F\u0430\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841980
    m_Localized: "\u0422\u0451\u043F\u043B\u044B\u0439 \u0445\u043B\u0435\u0431 \u0438
      \u0441\u0432\u0435\u0442\u043B\u044B\u0439 \u043F\u043E\u0440\u043E\u0433.
      \u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841981
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u043E\u0441\u0442
      \u0432\u0435\u0434\u0451\u0442 \u043A \u041F\u0438\u043F\u0443. \u042F \u043D\u0435
      \u0445\u043E\u0434\u0438\u043B \u043F\u043E \u043D\u0435\u043C\u0443 \u043F\u043E\u0441\u043B\u0435
      \u0431\u0443\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841982
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E, \u043F\u0440\u043E\u0439\u0434\u0451\u0448\u044C
      \u043D\u0430\u0447\u0430\u043B\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E
      \u043C\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841983
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u0443 \u043D\u0443\u0436\u0435\u043D
      \u043F\u043B\u0430\u0432\u043D\u044B\u0439 \u0437\u0430\u043F\u0443\u0441\u043A.
      \u0410 \u043C\u043E\u0438 \u043B\u0430\u043F\u044B \u0432\u0441\u0451 \u043D\u043E\u0440\u043E\u0432\u044F\u0442
      \u0441\u043F\u0435\u0448\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841984
    m_Localized: "\u041C\u043E\u0436\u0435\u043C \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C, \u043A\u0430\u043A \u043E\u043D\u043E
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841985
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0430\u044F
      \u0442\u0440\u0443\u0431\u0430 \u0437\u0430\u0431\u0438\u0442\u0430. \u0411\u0440\u0430\u0442
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0435\u0434\u0440\u043E
      \u0443 \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E \u043A\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841986
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0434\u043E\u0432\u0435\u0434\u0451\u043C
      \u0432\u043E\u0434\u0443 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u0432\u0435\u0434\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841987
    m_Localized: "\u042D\u0442\u0438 \u043A\u043E\u043B\u043E\u0434\u0446\u044B \u043F\u043E\u044F\u0442
      \u0441\u0430\u043C\u044B\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0434\u043E\u043C\u0430. \u0418\u043C \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0436\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841988
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C \u0434\u043E\u043C\u0430\u043C
      \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u043D\u044B \u043F\u043E\u043B\u043D\u044B\u0435
      \u0432\u0451\u0434\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841989
    m_Localized: "\u042F \u043E\u0431\u0435\u0449\u0430\u043B \u0421\u043E\u0440\u0435
      \u043F\u043E\u0447\u0442\u043E\u0432\u0443\u044E \u043B\u043E\u0434\u043A\u0443.
      \u041E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0442\u044F\u0436\u0435\u043B\u0435\u0435
      \u0432\u0435\u0434\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841990
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0443
      \u043D\u0430\u0441 \u0434\u0432\u0435 \u043F\u0430\u0440\u044B \u043B\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841991
    m_Localized: "\u0420\u044E \u0436\u0434\u0451\u0442 \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438.
      \u041E\u043D\u0430 \u0434\u0430\u043B\u0430 \u043D\u0430\u043C \u0441\u0435\u043C\u0435\u043D\u0430
      \u0437\u0430 \u0447\u0430\u0448\u043A\u0443 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841992
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u044D\u0442\u0438\u043C
      \u043F\u0443\u0442\u0451\u043C \u043C\u044B \u0441\u043A\u0430\u0436\u0435\u043C
      \u0435\u0439 \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841993
    m_Localized: "\u041F\u0442\u0438\u0446\u044B \u043A\u0440\u0443\u0436\u0430\u0442
      \u0443 \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
      \u041E\u043D\u0438 \u043F\u043E\u043C\u043D\u044F\u0442 \u0435\u0433\u043E
      \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841994
    m_Localized: "\u041F\u043E\u043C\u043E\u0436\u0435\u043C \u0434\u0435\u0440\u0435\u0432\u0443
      \u0442\u043E\u0436\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841995
    m_Localized: "\u042F \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u043C\u043E\u0441\u0442
      \u0443\u0437\u043A\u0438\u043C, \u0447\u0442\u043E\u0431\u044B \u0441\u0431\u0435\u0440\u0435\u0447\u044C
      \u043A\u043E\u0440\u043D\u0438. \u0422\u0435\u043F\u0435\u0440\u044C \u0435\u0433\u043E
      \u043D\u0443\u0436\u043D\u043E \u0447\u0438\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841996
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E \u043A\u043E\u0440\u043D\u044F\u0445, \u0438 \u043E \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841997
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u044D\u0442\u043E \u0432\u0430\u0440\u0435\u043D\u044C\u0435. \u041B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u0435\u043B\u044E\u0441\u044C, \u0447\u0435\u043C \u0431\u0443\u0434\u0443
      \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0435\u0433\u043E \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841998
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u0440\u043E\u043F\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0431\u0430\u043D\u043E\u0447\u043A\u0430 \u043D\u0430
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u043E\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477841999
    m_Localized: "\u0412 \u0434\u043E\u043C\u0438\u043A\u0435 \u0434\u043B\u044F
      \u0441\u0435\u043C\u044F\u043D \u0445\u043E\u043B\u043E\u0434\u043D\u043E.
      \u042D\u0442\u0438 \u043A\u0440\u043E\u0445\u0438 \u2014 \u0441\u0430\u0434
      \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0433\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842000
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0441\u043E\u0433\u0440\u0435\u0435\u043C
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043C\u044B \u0435\u0449\u0451 \u043D\u0435
      \u0432\u0438\u0434\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842001
    m_Localized: "\u0421\u043E\u0440\u0430 \u043D\u043E\u0441\u0438\u043B\u0430 \u043F\u0438\u0441\u044C\u043C\u0430
      \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u0438 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041C\u043D\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0435\u0451 \u0448\u0443\u043C\u043D\u044B\u0445 \u043F\u043E\u0441\u0430\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842002
    m_Localized: "\u041C\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u0432\u043E\u0440\u043E\u0442\u0430.
      \u0410 \u0442\u044B \u0441\u0442\u0430\u0432\u044C \u0447\u0430\u0439\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842003
    m_Localized: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043A\u0442\u043E-\u0442\u043E \u0436\u0434\u0451\u0442.
      \u042F \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0434\u0443\u043C\u0430\u044E
      \u043E\u0431 \u044D\u0442\u0438\u0445 \u043B\u044E\u0434\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842004
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0451\u043C \u0438\u0445, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842005
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E \u043F\u0438\u0441\u044C\u043C\u043E
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435, \u043D\u043E \u0442\u044B
      \u043D\u0451\u0441 \u0435\u0433\u043E \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842006
    m_Localized: "\u042F \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0430 \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u044F
      \u0438\u0434\u0443. \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u043C \u0435\u0433\u043E
      \u043E\u0442\u0441\u044E\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842007
    m_Localized: "\u0411\u0435\u0437 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u0441\u0442\u0430
      \u044F \u0434\u043E\u0431\u0435\u0440\u0443\u0441\u044C \u0434\u043E \u043E\u0431\u043B\u0430\u043A\u043E\u0432,
      \u043D\u043E \u043D\u0435 \u0434\u043E \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842008
    m_Localized: "\u0414\u0430\u0436\u0435 \u0442\u043E\u043C\u0443, \u043A\u0442\u043E
      \u043B\u0435\u0442\u0430\u0435\u0442, \u043D\u0443\u0436\u043D\u0430 \u043D\u0430\u0434\u0451\u0436\u043D\u0430\u044F
      \u043F\u043E\u0441\u0430\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842009
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043A\u043E\u0440\u0437\u0438\u043D\u0430
      \u0442\u044F\u0436\u0451\u043B\u0430\u044F. \u042F \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
      \u0432\u043D\u0438\u0437\u0443 \u043D\u0435\u0434\u043E\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842010
    m_Localized: "\u041C\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u043C \u043A\u043E\u0440\u0437\u0438\u043D\u0443.
      \u0410 \u0442\u044B \u0434\u043E\u043F\u0438\u0448\u0435\u0448\u044C \u043E\u0434\u043D\u0443
      \u0444\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842011
    m_Localized: "\u0417\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0431\u0435\u0440\u0435\u0433
      \u041D\u0435\u0440\u0438. \u042F \u0434\u043E\u043B\u0436\u043D\u0430 \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
      \u0435\u0451, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842012
    m_Localized: "\u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u0435\u043C.
      \u041C\u043E\u0436\u0435\u0442, \u0443 \u043D\u0435\u0451 \u0435\u0441\u0442\u044C
      \u0447\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842013
    m_Localized: "\u041F\u0440\u0438\u0447\u0430\u043B \u0442\u0440\u0435\u0441\u043D\u0443\u043B.
      \u042F \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u0442\u0435\u0431\u0435
      \u0441\u0443\u0445\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F
      \u043B\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842014
    m_Localized: "\u041C\u044B \u0435\u0433\u043E \u0441\u0434\u0435\u043B\u0430\u0435\u043C.
      \u042F \u043D\u0430\u0447\u043D\u0443 \u0443 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0431\u0435\u0440\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842015
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0444\u043E\u043D\u0430\u0440\u044C
      \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u041C\u0430\u043C\u0438\u043D\u0430 \u043B\u043E\u0434\u043A\u0430 \u0437\u043D\u0430\u043B\u0430
      \u0438\u0445 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842016
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430\u0445,
      \u043F\u043E\u043A\u0430 \u043C\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C
      \u043E\u0433\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842017
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u043C\u043E\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043B\u043E\u0434\u043A\u0438.
      \u0421\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A \u0445\u043B\u043E\u043F\u0430\u044E\u0442
      \u043F\u0430\u0440\u0443\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842018
    m_Localized: "\u041C\u044B \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u0438\u043C \u043F\u0443\u0442\u044C
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842019
    m_Localized: "\u042D\u0442\u043E\u0442 \u043E\u0433\u043E\u043D\u0451\u043A \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u0435\u0442
      \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0435\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u043D\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842020
    m_Localized: "\u041F\u043E\u043D\u0435\u0441\u0443 \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C. \u0418\u043C \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842021
    m_Localized: "\u0417\u0430 \u044D\u0442\u043E\u0439 \u0442\u0440\u043E\u043F\u043E\u0439
      \u0422\u043E\u043C\u0430 \u0445\u0440\u0430\u043D\u0438\u0442 \u0441\u043D\u0435\u0436\u043D\u0443\u044E
      \u043A\u0430\u0440\u0442\u0443. \u041E\u043D \u043D\u0435 \u043B\u044E\u0431\u0438\u0442
      \u0434\u0430\u0432\u0430\u0442\u044C \u0446\u0435\u043D\u043D\u043E\u0435 \u0432\u0437\u0430\u0439\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842022
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0435\u043C\u0443,
      \u0447\u0435\u043C\u0443 \u043C\u0435\u043D\u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0430
      \u0437\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u0430\u044F \u043B\u043E\u0434\u043E\u0447\u043D\u0438\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842023
    m_Localized: "\u041B\u0438\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430 \u043E\u0442 \u0434\u043E\u0436\u0434\u044F.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u0430\u043C\u044B\u0435 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B \u2014 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842024
    m_Localized: "\u042F \u0432\u044B\u0442\u0440\u0443 \u043B\u0430\u043F\u044B,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0442\u0440\u043E\u043D\u0443\u0442\u044C
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842025
    m_Localized: "\u042D\u0442\u0438 \u043F\u043E\u043B\u043A\u0438 \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F
      \u0432\u043C\u0435\u0441\u0442\u0435. \u042F \u0441\u0432\u044F\u0437\u0430\u043B
      \u0438\u0445, \u0447\u0442\u043E\u0431\u044B \u043A\u043D\u0438\u0433\u0438
      \u043D\u0435 \u043F\u0430\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842026
    m_Localized: "\u041C\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043C
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u0441\u0431\u0435\u0440\u0435\u0436\u0451\u043C
      \u0432\u0441\u0435 \u043A\u043D\u0438\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842027
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0431\u0443\u0440\u0438 \u043B\u0435\u0436\u0438\u0442
      \u0437\u0430 \u044D\u0442\u0438\u043C \u0448\u043A\u0430\u0444\u043E\u043C.
      \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u043B
      \u0435\u0451 \u0432 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842028
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430 \u0442\u043E\u0436\u0435
      \u0436\u0434\u0430\u043B\u0430 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842029
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0434\u043E \u0447\u0435\u0440\u043D\u0438\u043B. \u042F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u0440\u044B\u0448\u0443
      \u0438 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443 \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842030
    m_Localized: "\u0422\u044B \u0434\u0435\u0440\u0436\u0438 \u043A\u0440\u044B\u0448\u0443.
      \u0410 \u043C\u043E\u0439 \u0448\u0430\u0440\u0444 \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F
      \u043E \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842031
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u0440\u0442\u0430\u043C\u0438.
      \u042F \u0441\u0431\u0435\u0440\u0451\u0433 \u0435\u0451 \u0434\u043E \u043D\u0443\u0436\u043D\u043E\u0433\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842032
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043E\u0442\u043A\u0440\u043E\u0435\u043C
      \u043A \u043D\u0435\u0439 \u043F\u0443\u0442\u044C. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0433\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842033
    m_Localized: "\u0421\u043D\u0435\u0436\u043D\u044B\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C. \u042F \u043F\u043E\u043C\u043D\u044E,
      \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u043B\u0438 \u0444\u043E\u043D\u0430\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842034
    m_Localized: "\u0422\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C \u043C\u0435\u0441\u0442\u0430.
      \u0410 \u044F \u043F\u0440\u0438\u043D\u0435\u0441\u0443 \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842035
    m_Localized: "\u042F \u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u044D\u0442\u043E
      \u0443\u043A\u0440\u044B\u0442\u0438\u0435 \u0434\u043B\u044F \u0434\u0440\u0443\u0433\u0438\u0445.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u043D\u0435 \u0442\u043E\u0436\u0435
      \u043D\u0443\u0436\u043D\u043E \u0435\u0433\u043E \u0442\u0435\u043F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842036
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0438\u043D\u0438\u043C
      \u0434\u043B\u044F \u043D\u0430\u0441 \u043E\u0431\u043E\u0438\u0445 \u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842037
    m_Localized: "\u0417\u0430 \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0430\u0440\u043A\u043E\u0439
      \u043D\u0435 \u0432\u0438\u0434\u043D\u043E \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u041C\u043D\u0435 \u044D\u0442\u043E
      \u0442\u043E\u0436\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842038
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u043F\u043E\u0441\u0430\u0434\u043A\u0438
      \u043F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842039
    m_Localized: "\u041F\u0438\u043F \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u0442\u0435\u0431\u0435
      \u043E\u0434\u0435\u044F\u043B\u043E. \u041E\u043D \u043F\u0440\u043E\u0441\u0438\u043B
      \u043D\u0435\u0441\u0442\u0438 \u0435\u0433\u043E \u0431\u0435\u0440\u0435\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842040
    m_Localized: "\u041F\u043E\u0434 \u043D\u0438\u043C \u0438 \u0434\u043B\u044F
      \u0442\u0432\u043E\u0438\u0445 \u043B\u0430\u043F \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842041
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043A \u043C\u0430\u044F\u043A\u0443.
      \u0421\u043A\u0432\u043E\u0437\u044C \u0441\u043D\u0435\u0433 \u0432\u0438\u0434\u043D\u043E
      \u043E\u0434\u043D\u043E \u043E\u043A\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842042
    m_Localized: "\u042D\u0442\u043E \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u0430
      \u043B\u0430\u043C\u043F\u0430. \u0414\u0430\u0432\u0430\u0439 \u043E\u0441\u0432\u0435\u0442\u0438\u043C
      \u0434\u043B\u044F \u043D\u0435\u0451 \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842043
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u043E\u0441\u0442
      \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0442\u0435\u0431\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C.
      \u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0435\u0433\u043E
      \u043B\u0430\u043C\u043F\u0443 \u0433\u043E\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842044
    m_Localized: "\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439.
      \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0443\u043C\u0435\u044E
      \u0447\u0438\u043D\u0438\u0442\u044C \u043C\u043E\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842045
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A
      \u0436\u0434\u0430\u043B \u0432\u0441\u044E \u0431\u0443\u0440\u044E. \u041E\u0434\u043D\u043E\u0439
      \u043C\u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842046
    m_Localized: "\u0422\u044B \u0436\u0434\u0430\u043B\u0430 \u043C\u0435\u043D\u044F.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043B\u0430\u043F \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842047
    m_Localized: "\u042F \u043D\u043E\u0441\u0438\u043B\u0430 \u0442\u0435\u0431\u044F
      \u043F\u043E \u044D\u0442\u0438\u043C \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u043C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0439\u0434\u0451\u043C
      \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842048
    m_Localized: "\u042F \u043F\u043E\u0434\u0435\u0440\u0436\u0443 \u0444\u043E\u043D\u0430\u0440\u044C,
      \u0430 \u0442\u044B \u0434\u0435\u0440\u0436\u0438\u0441\u044C \u0437\u0430
      \u043F\u0435\u0440\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842049
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u043E\u043C\u0443 \u0444\u043E\u043D\u0430\u0440\u044E
      \u043D\u0443\u0436\u043D\u044B \u043E\u0431\u0430 \u043E\u0433\u043E\u043D\u044C\u043A\u0430.
      \u041C\u043E\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439,
      \u043D\u043E \u044F \u0435\u0433\u043E \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842050
    m_Localized: "\u041C\u043E\u0439 \u043F\u0440\u043E\u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u0432\u0441\u0435 \u043E\u0441\u0442\u0440\u043E\u0432\u0430. \u041F\u043E\u0434\u043D\u0438\u043C\u0435\u043C
      \u0438\u0445 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842051
    m_Localized: "\u041B\u0438\u043D\u0437\u0430 \u043C\u0430\u044F\u043A\u0430 \u0433\u043E\u0442\u043E\u0432\u0430.
      \u0417\u0430\u0436\u0436\u0451\u0448\u044C \u0435\u0451, \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u041C\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842052
    m_Localized: "\u0414\u0430. \u041F\u0443\u0441\u0442\u044C \u0432\u0441\u0435,
      \u043A\u0442\u043E \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0433\u0430\u043B,
      \u043D\u0430\u0439\u0434\u0443\u0442 \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842053
    m_Localized: "\u041B\u0443\u043D\u043D\u044B\u0439 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442
      \u0441\u0431\u0438\u043B\u0441\u044F. \u042F \u0441\u0447\u0438\u0442\u0430\u043B
      \u043E\u0434\u0438\u043D \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842054
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435. \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043E\u0434\u0438\u043D \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0439
      \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842055
    m_Localized: "\u041D\u0430 \u043C\u043E\u0441\u0442\u0443 \u043A \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0443
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u043E\u0441\u043A\u0438.
      \u042F \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B \u0441 \u043F\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842056
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0447\u0438\u043D\u0438\u043C.
      \u0417\u0432\u0451\u0437\u0434\u044B \u0441\u0442\u043E\u0438\u0442 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842057
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B
      \u0440\u0430\u0437\u043B\u0435\u0442\u0435\u043B\u0438\u0441\u044C. \u042F
      \u0436\u0434\u0430\u043B, \u043F\u043E\u043A\u0430 \u043D\u0430\u0439\u0434\u0443
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0433\u043E\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842058
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C
      \u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0441\u0442\u044C,
      \u0410\u0441\u0442\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842059
    m_Localized: "\u042D\u0442\u0438 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F
      \u0432\u0435\u043B\u0438 \u043D\u043E\u0447\u043D\u044B\u0435 \u043F\u043B\u0430\u043D\u0435\u0440\u044B.
      \u041C\u043D\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0438\u0445 \u043A\u0440\u044B\u043B\u044C\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842060
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0434\u0430\u0434\u0438\u043C \u043F\u0435\u0440\u0432\u043E\u043C\u0443
      \u043F\u043B\u0430\u043D\u0435\u0440\u0443 \u0443\u0437\u043E\u0440, \u043F\u043E
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043E\u043D \u043F\u043E\u043B\u0435\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842061
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041F\u0443\u0441\u0442\u044C \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0435\u0449\u0451 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442 \u043C\u043E\u044E
      \u043A\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842062
    m_Localized: "\u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0442\u043E\u0431\u043E\u0439. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u043C\u0430\u0448\u0435\u043C
      \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842063
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842064
    m_Localized: "\u0410\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842065
    m_Localized: "\u042F \u0410\u0441\u0442\u0435\u0440. \u0421\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438. \u042F \u0437\u043D\u0430\u044E
      \u043D\u0435\u0431\u043E, \u043D\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430
      \u0435\u0449\u0451 \u043E\u0434\u043D\u0430 \u043F\u0430\u0440\u0430 \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842066
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0438\u043D \u043C\u0430\u044F\u043A
      \u0441\u0438\u044F\u0435\u0442. \u041F\u043E\u043C\u043E\u0436\u0435\u043C
      \u0435\u0433\u043E \u0441\u0432\u0435\u0442\u0443 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0438 \u0434\u043E \u043D\u043E\u0447\u043D\u044B\u0445 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842067
    m_Localized: "\u0420\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C \u043B\u0443\u043D\u043D\u044B\u0439
      \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842068
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043C\u043E\u0441\u0442
      \u043A \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842069
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842070
    m_Localized: "\u0417\u0430\u0436\u0435\u0447\u044C \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842071
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C
      \u043D\u043E\u0447\u043D\u044B\u043C \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842072
    m_Localized: "\u041B\u0443\u043D\u043D\u044B\u0439 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442
      \u0441\u043D\u043E\u0432\u0430 \u0438\u0434\u0451\u0442 \u0432\u0435\u0440\u043D\u043E.
      \u0421\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A \u043E\u043D \u0442\u0438\u0445\u043E
      \u0442\u0438\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842073
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443
      \u041F\u0438\u043F\u0430, \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043D\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842074
    m_Localized: "\u041C\u043E\u0441\u0442 \u043A \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0443
      \u043D\u0430\u0434\u0451\u0436\u0435\u043D. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F
      \u0434\u0432\u0443\u0445 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842075
    m_Localized: "\u0422\u0432\u043E\u0438 \u0437\u0432\u0451\u0437\u0434\u044B \u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u0431\u043B\u0438\u0436\u0435, \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043B\u0438\u0448\u044C\u0441\u044F
      \u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842076
    m_Localized: "\u041D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445 \u0435\u0441\u0442\u044C
      \u043F\u0440\u043E\u0431\u0435\u043B\u044B, \u043D\u043E \u043F\u0443\u0442\u0438
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F. \u042F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E\u0433\u043E
      \u0436\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842077
    m_Localized: "\u041C\u044B \u043D\u0430\u0448\u043B\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043D\u0435\u0431\u0430, \u0447\u0442\u043E\u0431\u044B \u0438\u0434\u0442\u0438
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842078
    m_Localized: "\u0421\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F \u0441\u0438\u044F\u044E\u0442.
      \u041F\u043B\u0430\u043D\u0435\u0440 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842079
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u0410\u0441\u0442\u0435\u0440.
      \u041A\u0442\u043E-\u0442\u043E \u043C\u0430\u0448\u0435\u0442 \u0438\u0437
      \u043E\u043A\u043E\u0448\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842080
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0443 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0442\u0430\u0431\u0443\u0440\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842081
    m_Localized: "\u0421\u0431\u0435\u0440\u0435\u0433\u0438 \u0435\u0433\u043E \u0434\u043B\u044F
      \u043C\u0435\u043D\u044F. \u042F \u043F\u0440\u0438\u0432\u0435\u0434\u0443
      \u0431\u0430\u0431\u0443\u0448\u043A\u0443 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0443
      \u0442\u0451\u043F\u043B\u044B\u0439 \u0447\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842082
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u043F\u0440\u0438\u043D\u044F\u043B
      \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u0430 \u0437\u0430 \u0437\u0432\u0435\u0437\u0434\u0443.
      \u0418 \u043E\u0447\u0435\u043D\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842083
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0442\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u0442\u0432\u043E\u044F \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842084
    m_Localized: "\u0414\u0430\u0436\u0435 \u043D\u0430 \u044F\u0441\u043D\u043E\u043C
      \u043D\u0435\u0431\u0435 \u0435\u0441\u0442\u044C \u043E\u0431\u043B\u0430\u043A\u0430.
      \u042F \u0443\u0447\u0443\u0441\u044C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842085
    m_Localized: "\u0418 \u043C\u0435\u0436\u0434\u0443 \u044D\u0442\u0438\u043C\u0438
      \u0434\u043E\u0441\u043A\u0430\u043C\u0438 \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0448\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842086
    m_Localized: "\u041C\u0430\u044F\u043A \u0441\u0438\u044F\u0435\u0442, \u043D\u043E
      \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0435\u0449\u0451 \u0442\u0435\u043C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842087
    m_Localized: "\u0410\u0441\u0442\u0435\u0440 \u0436\u0434\u0451\u0442 \u043D\u0430\u0434
      \u043E\u0431\u043B\u0430\u043A\u0430\u043C\u0438. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u043E\u0447\u044C\u044E \u043C\u044B \u0435\u043C\u0443 \u043F\u043E\u043C\u043E\u0436\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842088
    m_Localized: "\u041B\u0443\u043D\u043D\u044B\u0439 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442
      \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F. \u0415\u0433\u043E
      \u0441\u0432\u0435\u0442 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842089
    m_Localized: "\u0410\u0441\u0442\u0435\u0440 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B
      \u043E\u0434\u0438\u043D. \u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842090
    m_Localized: "\u042D\u0442\u0438 \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B \u0432\u044B\u043B\u0435\u0442\u0435\u043B\u0438
      \u0438\u0437 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430 \u0410\u0441\u0442\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842091
    m_Localized: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0443\u0433\u043E\u043B\u043A\u043E\u0432
      \u043D\u0435\u0442. \u041D\u043E \u0434\u043B\u044F \u0434\u043E\u0440\u043E\u0433\u0438
      \u0445\u0432\u0430\u0442\u0438\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842092
    m_Localized: "\u041E\u0434\u043D\u043E \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0435
      \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u043E\u0441\u044C. \u0412 \u0435\u0433\u043E
      \u0441\u0432\u0435\u0442\u0435 \u0432\u0438\u0434\u043D\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842093
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u044B \u0434\u0430\u043B\u0435\u043A\u043E
      \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430. \u0423\u0437\u043E\u0440
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u0438\u0445 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842094
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u043B\u0430\u043D\u0435\u0440
      \u043B\u0435\u0442\u0438\u0442 \u043F\u043E \u043D\u0430\u0448\u0435\u0439
      \u043D\u043E\u0432\u043E\u0439 \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842095
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0438\u043D \u043C\u0430\u044F\u043A
      \u0438 \u0437\u0432\u0451\u0437\u0434\u044B \u0410\u0441\u0442\u0435\u0440\u0430
      \u0441\u0438\u044F\u044E\u0442 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842096
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B, \u043D\u0430\u0434\u043E
      \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0432\u0441\u0435 \u043C\u043E\u0441\u0442\u044B,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0438\u0434\u0442\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842097
    m_Localized: "\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u043D\u0430\u0447\u0430\u043B\u043E
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044D\u0442\u043E\u0433\u043E \u0431\u044B\u043B\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842098
    m_Localized: "\u0411\u0440\u0430\u0442 \u0441\u0430\u043C \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B
      \u0432\u0435\u0434\u0440\u043E. \u041E\u043D \u0441\u043F\u0440\u043E\u0441\u0438\u043B,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u0440\u0438\u0434\u0451\u0448\u044C
      \u043D\u0430 \u0447\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842099
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0442\u043E\u0432\u0430\u044F
      \u043B\u043E\u0434\u043A\u0430 \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0442\u043E\u0432\u0430.
      \u0423 \u043D\u0430\u0441 \u0435\u0449\u0451 \u043E\u0434\u043D\u043E \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842100
    m_Localized: "\u0423 \u0442\u0435\u0431\u044F \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0442\u0435 \u0441\u0435\u043C\u0435\u043D\u0430. \u042F \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0442\u044B \u043C\u043E\u0433 \u043E \u043D\u0438\u0445 \u0437\u0430\u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842101
    m_Localized: "\u0418\u043C \u0442\u0435\u043F\u043B\u043E \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0438\u0441\u044C\u043C\u043E\u043C. \u0425\u043E\u0447\u0443
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0431\u0430\u0431\u0443\u0448\u043A\u0435
      \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0441\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842102
    m_Localized: "\u042F \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430 \u043F\u0435\u0440\u0432\u0443\u044E
      \u0444\u0440\u0430\u0437\u0443: \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E
      \u043D\u0430\u0448\u0435\u043C\u0443 \u0447\u0430\u044E. \u042D\u0442\u043E
      \u0431\u044B\u043B\u043E \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C
      \u044F \u0431\u043E\u044F\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842103
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0444\u0440\u0430\u0437\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442,
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u043C \u043A\u043E\u0440\u0437\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842104
    m_Localized: "\u041B\u043E\u0434\u043E\u0447\u043A\u0430 \u0434\u043E\u043F\u043B\u044B\u043B\u0430
      \u0434\u043E \u0444\u043E\u043D\u0430\u0440\u044F. \u041C\u0430\u043C\u0435
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0431\u044B
      \u0442\u0432\u043E\u044F \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430\u044F
      \u043F\u043E\u0441\u0430\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 730607477842105
    m_Localized: "\u041C\u043D\u0435 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0431\u044B\u043B\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u0422\u044B \u0438 \u044D\u0442\u043E\u043C\u0443
      \u043D\u0430\u0448\u043B\u0430 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036224
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430 \u043F\u043E\u043B\u043A\u0435
      \u043F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u041F\u043E\u0445\u043E\u0436\u0435
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u0434\u0432\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036225
    m_Localized: "\u0421\u0431\u0435\u0440\u0435\u0433\u0438 \u0435\u0433\u043E \u0434\u043B\u044F
      \u043D\u0430\u0441. \u042F \u0432\u0435\u0440\u043D\u0443 \u043A\u0430\u0440\u0442\u0443
      \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036226
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u043E \u044F \u043F\u0440\u043E\u0448\u0443
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0431\u044B\u0442\u044C \u0440\u044F\u0434\u043E\u043C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E
      \u0442\u044B \u0442\u043E\u0436\u0435 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036227
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430\u043C
      \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u0434\u0435\u043B\u0438\u0442\u044C
      \u043E\u0434\u0435\u044F\u043B\u043E. \u041F\u0438\u043F \u043F\u0440\u0438\u0441\u043B\u0430\u043B
      \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036228
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0440\u0430\u043D\u044C\u0448\u0435
      \u043F\u0440\u043E\u0441\u0438\u0448\u044C \u043F\u043E\u043C\u043E\u0449\u0438.
      \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044E \u0432\u0430\u0436\u043D\u043E
      \u044D\u0442\u043E\u043C\u0443 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036229
    m_Localized: "\u041C\u0435\u043D\u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0438
      \u0434\u0440\u0443\u0437\u044C\u044F \u0441\u043E \u0432\u0441\u0435\u0433\u043E
      \u043D\u0435\u0431\u0430. \u0418 \u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036230
    m_Localized: "\u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043D\u0435\u0434\u043E\u0434\u0435\u043B\u0430\u043D\u043D\u0443\u044E
      \u043A\u0430\u0440\u0442\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
      \u041F\u043E\u043A\u0430 \u043C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438,
      \u043A\u0442\u043E-\u0442\u043E \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u0437\u0432\u0435\u0437\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036231
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0434\u0440\u0443\u0433\u043E\u0439
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C \u0442\u043E\u0436\u0435
      \u0437\u0430\u0445\u043E\u0442\u0435\u043B \u043C\u0435\u0441\u0442\u043E \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u043E\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036232
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036233
    m_Localized: "\u0417\u0430\u043A\u043E\u043D\u0447\u0438 \u0442\u0435\u043A\u0443\u0449\u0438\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 730607482036234
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F"
