      \u0434\u043E\u043A\u0430\u0436\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362918
    m_Localized: "\u0421 \u043C\u0435\u0448\u043A\u0430\u043C\u0438 \u043C\u0443\u043A\u0438?
      \u0422\u043E\u0433\u0434\u0430 \u0432\u0441\u0442\u0430\u043D\u0443 \u0442\u0430\u043A,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0438\u0434\u0435\u0442\u044C \u043E\u0431\u0430
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362919
    m_Localized: "\u0426\u0430\u0440\u0430\u043F\u0438\u043D\u0430 \u0443\u0437\u043A\u0430\u044F.
      \u041F\u0440\u043E\u043F\u0430\u0432\u0448\u0430\u044F \u0441\u0442\u0430\u043C\u0435\u0441\u043A\u0430
      \u0432\u0434\u0432\u043E\u0435 \u0448\u0438\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362920
    m_Localized: "\u0418 \u0442\u0432\u043E\u044F \u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F.
      \u0410 \u043E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445
      \u043B\u0430\u0442\u0443\u043D\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362921
    m_Localized: "\u042D\u0442\u043E\u0442 \u0441\u0442\u0443\u043A \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439 \u0437\u0443\u0431\u0435\u0446.
      \u041E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E \u043A\u043E\u043B\u0435\u0441\u043E.
      \u0414\u0430, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362922
    m_Localized: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438. \u0420\u044F\u0434
      \u044F \u0434\u0435\u0440\u0436\u0443. \u041D\u0430\u0439\u0434\u0438 \u0437\u0443\u0431\u0435\u0446,
      \u043F\u043E\u043A\u0430 \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u0442\u043E\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362923
    m_Localized: "\u0421\u044E\u0434\u0430 \u0432\u043E\u0434\u0430 \u0434\u043E\u0448\u043B\u0430,
      \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u0442\u0435\u0447\u044C. \u0423
      \u0431\u0440\u0430\u0442\u0430 \u043A\u0440\u0430\u043D \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0441\u0443\u0445\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362924
    m_Localized: "\u041F\u043E\u0439\u0434\u0451\u043C \u0432\u0434\u043E\u043B\u044C
      \u0442\u0440\u0443\u0431\u044B. \u041F\u0443\u0441\u0442\u044C \u043E\u043D
