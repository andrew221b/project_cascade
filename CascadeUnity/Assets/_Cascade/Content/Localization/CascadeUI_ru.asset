    m_Metadata:
      m_Items: []
  - m_Id: 449412517060613
    m_Localized: "\u0425\u043E\u0434\u044B: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060614
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u044B: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060615
    m_Localized: "\u0422\u0432\u043E\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060616
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060617
    m_Localized: "\u041E\u0433\u043E\u043D\u044C\u043A\u0438: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060618
    m_Localized: "\u0418\u0433\u0440\u0430\u0439 \u0441\u043D\u043E\u0432\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u0440\u0435\u043A\u043E\u0440\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060619
    m_Localized: "\u0422\u0435\u0431\u044F \u0436\u0434\u0451\u0442 \u0442\u0440\u043E\u0444\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060620
    m_Localized: "\u0414\u043E \u0442\u0440\u043E\u0444\u0435\u044F: {0} \u0438\u0437
      3 \u043E\u0433\u043E\u043D\u044C\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060621
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u0442\u0440\u043E\u0444\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060622
    m_Localized: "\u042D\u0442\u043E \u0442\u0435\u0431\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060623
    m_Localized: "\u0422\u0432\u043E\u0439 \u0442\u0440\u043E\u0444\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060624
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060625
    m_Localized: "3 \u0434\u0435\u0442\u0430\u043B\u0438 \u2014 \u0442\u0440\u043E\u0444\u0435\u0439
      \u0434\u043B\u044F \u041C\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060626
    m_Localized: "\u042D\u0442\u0430\u043F {0} \u0438\u0437 3 \u043F\u0440\u043E\u0439\u0434\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060627
    m_Localized: "\u0412\u043D\u0438\u0437\u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u044D\u0442\u0430\u043F. \u041E\u043F\u0443\u0441\u0442\u0438 \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 449412517060628
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
