    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u0432 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 561463100956672
    m_Localized: "\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 561463105150976
    m_Localized: "\u0414\u043E 2 \u0437\u0432\u0451\u0437\u0434. \u0411\u0435\u0437
      \u0440\u0435\u043A\u043E\u0440\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 561463105150977
    m_Localized: "\u0420\u044F\u0434 \u043F\u043E\u043F\u0430\u0434\u0451\u0442 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 561463105150978
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0434\u043E\u0441\u043A\u0435 \u0440\u044F\u0434 \u0441\u043E\u0432\u043F\u0430\u0434\u0451\u0442
      \u0441 \u0446\u0435\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 564361234997248
    m_Localized: "\u041C\u0438\u0440 \u043F\u0440\u043E\u0439\u0434\u0435\u043D:
      {0}/{0} \u0443\u0440\u043E\u0432\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 564361239191552
    m_Localized: "\u0414\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u0438\u0440\u0430:
      {0}, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 564361239191553
    m_Localized: "\u0414\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u043C\u0438\u0440\u0430:
      {0}, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 566306465112064
    m_Localized: "\u0412\u044B \u0437\u0434\u0435\u0441\u044C: {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 570283319615488
    m_Localized: "\u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809792
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809793
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809794
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809795
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0431\u0435\u0437
      \u043E\u0448\u0438\u0431\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809796
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0445\u043E\u0434\u043E\u0432
      \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0432\u0451\u0437\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809797
    m_Localized: "\u0425\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809798
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 570283323809799
    m_Localized: "\u0412\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 584621170352128
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u044B \u0438 \u0440\u0435\u043A\u043E\u0440\u0434
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0440\u0435\u0436\u0438\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057918808064
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196672
    m_Localized: "\u041D\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196673
    m_Localized: "\u041A\u043B\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196674
    m_Localized: "\u041E\u0441\u043A\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196675
    m_Localized: "\u041B\u044E\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196676
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0410\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196677
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196678
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196679
    m_Localized: "\u041A \u043A\u0430\u0440\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196680
    m_Localized: "\u042F \u0412\u0430\u043B\u044C\u0442\u0435\u0440. \u0411\u0443\u0440\u044F
      \u0441\u043B\u043E\u043C\u0430\u043B\u0430 \u043C\u043E\u0441\u0442\u044B.
      \u042F \u043F\u043E\u0447\u0438\u043D\u044E \u0434\u043E\u0441\u043A\u0438,
      \u0430 \u0442\u044B \u043F\u043E\u043C\u043E\u0433\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043E\u0433\u043E\u043D\u044C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196681
    m_Localized: "\u042F \u0411\u0435\u043D. \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0432\u0441\u0442\u0430\u043B\u0430. \u0411\u0435\u0437 \u043D\u0435\u0451
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0435\u0442 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196682
    m_Localized: "\u042F \u0420\u043E\u0437\u0430. \u0414\u0435\u0440\u0435\u0432\u044C\u044F-\u0444\u043E\u043D\u0430\u0440\u0438
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438. \u0414\u0430\u0436\u0435 \u043F\u0442\u0438\u0446\u044B
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438
      \u0433\u043D\u0451\u0437\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196683
    m_Localized: "\u041D\u043E\u0440\u0430, \u043D\u0435\u0431\u0435\u0441\u043D\u0430\u044F
      \u043F\u043E\u0447\u0442\u0430! \u0425\u043E\u0442\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u044F \u043F\u0435\u0448\u043A\u043E\u043C. \u0412\u0435\u0442\u0435\u0440
      \u0440\u0430\u0437\u043D\u0451\u0441 \u0432\u0441\u0435 \u043F\u0438\u0441\u044C\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196684
    m_Localized: "\u042F \u041A\u043B\u0430\u0440\u0430. \u0424\u043E\u043D\u0430\u0440\u0438
      \u0443 \u043F\u0440\u0443\u0434\u0430 \u043F\u043E\u0433\u0430\u0441\u043B\u0438.
      \u041C\u043E\u0438 \u043B\u043E\u0434\u043E\u0447\u043A\u0438 \u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438 \u0431\u0435\u0440\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196685
    m_Localized: "\u042F \u041E\u0441\u043A\u0430\u0440, \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043A\u0430\u0440\u0442. \u0411\u0443\u0440\u044F \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043A \u043C\u0430\u044F\u043A\u0443
      \u0441\u0440\u0435\u0434\u0438 \u044D\u0442\u0438\u0445 \u043F\u043E\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196686
    m_Localized: "\u042F \u041B\u044E\u043C\u0438. \u042F \u0437\u043D\u0430\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u0441\u043D\u0435\u0433.
      \u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435,
      \u043E\u0442 \u043E\u0433\u043E\u043D\u044C\u043A\u0430 \u043A \u043E\u0433\u043E\u043D\u044C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196687
    m_Localized: "\u0420\u0438\u043D! \u0412\u043E\u0442 \u0438 \u0442\u044B. \u041C\u0430\u044F\u043A
      \u043F\u043E\u0433\u0430\u0441, \u043D\u043E \u044F \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196688
    m_Localized: "\u042F \u0420\u0438\u043D. \u042F \u043D\u0435\u0441\u0443 \u043E\u0433\u043E\u043D\u0451\u043A
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435 \u043D\u0430 \u043C\u0430\u044F\u043A
      \u0410\u0434\u044B. \u041D\u0430\u0447\u043D\u0451\u043C \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196689
    m_Localized: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u043C \u0435\u0451.
      \u0425\u043E\u0447\u0443 \u0441\u043D\u043E\u0432\u0430 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196690
    m_Localized: "\u0417\u0430\u0436\u0436\u0451\u043C \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0434\u043D\u043E \u0434\u0435\u0440\u0435\u0432\u043E. \u0422\u043E\u0433\u0434\u0430
      \u043F\u0442\u0438\u0446\u044B \u043F\u043E\u043A\u0430\u0436\u0443\u0442 \u043D\u0430\u043C
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196691
    m_Localized: "\u041E\u0434\u043D\u043E \u0438\u0437 \u044D\u0442\u0438\u0445
      \u043F\u0438\u0441\u0435\u043C \u0434\u043B\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0438.
      \u041D\u0430\u0439\u0434\u0451\u043C \u0435\u0433\u043E \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196692
    m_Localized: "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0441 \u0444\u043E\u043D\u0430\u0440\u044F\u043C\u0438.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0431\u0435\u0440\u0435\u0433\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196693
    m_Localized: "\u041C\u044B \u0443\u0436\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0430\u0432\u0430\u0439 \u043D\u0430\u0439\u0434\u0451\u043C
      \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196694
    m_Localized: "\u041B\u0430\u043F\u043A\u0438 \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0438,
      \u0437\u0430\u0442\u043E \u0444\u043E\u043D\u0430\u0440\u044C \u0435\u0449\u0451
      \u0442\u0451\u043F\u043B\u044B\u0439. \u0412\u0435\u0434\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196695
    m_Localized: "\u0418 \u044F \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430
      \u0441\u0432\u043E\u0439, \u0431\u0430\u0431\u0443\u0448\u043A\u0430. \u0414\u0430\u0432\u0430\u0439
      \u0432\u0435\u0440\u043D\u0451\u043C \u0438\u0445 \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196696
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438
      \u0440\u044B\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196697
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u0443\u0442\u044C
      \u043A \u0411\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196698
    m_Localized: "\u0417\u0430\u0436\u0435\u0447\u044C \u043D\u0438\u0436\u043D\u0438\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196699
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u0434\u0446\u044B,
      \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196700
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u0441\u043B\u0435\u0434\u044B
      \u044F\u0449\u0438\u043A\u0430 \u0420\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196701
    m_Localized: "\u0417\u0430\u0436\u0435\u0447\u044C \u0444\u043E\u043D\u0430\u0440\u044C
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196702
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043C\u043E\u0441\u0442 \u0441\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196703
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C
      \u0442\u0435\u043B\u0435\u0433\u0435 \u0441 \u0443\u0440\u043E\u0436\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196704
    m_Localized: "\u0421\u043E\u0433\u0440\u0435\u0442\u044C \u0440\u0430\u0441\u0441\u0430\u0434\u043D\u0438\u043A,
      \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196705
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C
      \u043A \u041D\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196706
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0447\u0442\u0443
      \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196707
    m_Localized: "\u041E\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C \u043F\u043E\u0447\u0442\u043E\u0432\u043E\u0439 \u0442\u0435\u043B\u0435\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196708
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044E
      \u0432 \u043B\u0430\u0433\u0443\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196709
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043B\u0430\u0433\u0443\u043D\u0443,
      \u0441\u0432\u0435\u0440\u0438\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196710
    m_Localized: "\u041E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u0440\u043E\u0445\u043E\u0434
      \u043F\u043E\u0434 \u043D\u0438\u0437\u043A\u043E\u0439 \u0431\u0430\u043B\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196711
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u0437\u0430\u043F\u0438\u0441\u044C
      \u043F\u0440\u0438\u043B\u0438\u0432\u0430 \u041E\u0441\u043A\u0430\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196712
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0440\u0438\u0442.
      \u041F\u043E\u0434\u043F\u0438\u0448\u0443 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435.
      \u0423\u0436 \u0435\u0433\u043E-\u0442\u043E \u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0438\u0437\u0443\u0447\u0438\u043B \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439
      \u0449\u0435\u043F\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196713
    m_Localized: "\u0418 \u044F \u0432\u0438\u0436\u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0448\u0430\u0433. \u0423\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196714
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0434\u0435\u0440\u0436\u0430\u0442
      \u0432\u0435\u0442\u0435\u0440. \u0414\u0430\u043B\u044C\u043D\u044E\u044E
      \u0437\u0430\u0449\u0451\u043B\u043A\u0443 \u0442\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C
      \u0443\u0436\u0435 \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196715
    m_Localized: "\u0410 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F
      \u0437\u043D\u0430\u044E, \u043A\u0443\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057927196716
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
      \u0423 \u0411\u0435\u043D\u0430 \u043A\u043E\u043B\u0435\u0441\u043E \u0432\u0441\u0442\u0430\u043B\u043E
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0441
      \u044D\u0442\u0438\u043C \u0440\u0435\u043B\u0435. \u041C\u043E\u0436\u0435\u0442,
      \u043E\u043D \u0432\u0438\u0434\u0435\u043B \u0431\u043E\u043B\u044C\u0448\u0435
      \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390976
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u043C \u0443 \u043D\u0435\u0433\u043E,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u0434\u043E\u0440\u043E\u0433\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0440\u044B\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390977
    m_Localized: "\u0420\u044B\u043D\u043E\u0447\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C
      \u0440\u043E\u0432\u043D\u044B\u0439. \u041F\u0435\u043A\u0430\u0440\u044C
      \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u0445\u043B\u0435\u0431. \u0412\u0435\u043B\u0435\u043B
      \u0435\u0441\u0442\u044C, \u043F\u043E\u043A\u0430 \u0442\u0451\u043F\u043B\u044B\u0439.
      \u0418 \u0431\u0435\u0437 \u043B\u0438\u043D\u0435\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390978
    m_Localized: "\u041E\u0442\u043B\u043E\u0436\u0438 \u043A\u0443\u0441\u043E\u043A
      \u0411\u0435\u043D\u0443. \u0410 \u0442\u044B \u043F\u043E\u0435\u0448\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u044F \u043F\u043E\u0434\u0435\u0440\u0436\u0443
      \u043A\u0430\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390979
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435
      \u0433\u043E\u0442\u043E\u0432\u0430. \u042F \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u044E
      \u0437\u0430 \u043C\u043E\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390980
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0441\u0442\u0430\u043C\u0435\u0441\u043A\u0430
      \u0442\u0443\u0442 \u043D\u0438 \u043F\u0440\u0438 \u0447\u0451\u043C. \u0411\u0435\u043D
      \u0441\u043B\u044B\u0448\u0430\u043B \u044F\u0449\u0438\u043A \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B.
      \u0421\u043F\u0440\u043E\u0441\u0438\u043C \u0435\u0433\u043E \u043F\u0440\u043E
      \u0442\u0443 \u043D\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390981
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u0438\u0434\u0451\u0442 \u0431\u0435\u0437
      \u0441\u0442\u0443\u043A\u0430. \u0411\u0440\u0430\u0442 \u0441\u043F\u0440\u043E\u0441\u0438\u043B,
      \u043A\u0442\u043E \u0441\u043B\u043E\u043C\u0430\u043B \u0442\u0440\u0443\u0431\u0443.
      \u042F \u0441\u043A\u0430\u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390982
    m_Localized: "\u0411\u0443\u0434\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390983
    m_Localized: "\u0418\u0437 \u0435\u0433\u043E \u043A\u0440\u0430\u043D\u0430
      \u0442\u0435\u0447\u0451\u0442. \u0417\u0430\u0441\u0442\u0430\u0432\u0438\u043B
      \u043C\u0435\u043D\u044F \u0441\u0442\u043E\u044F\u0442\u044C \u0440\u044F\u0434\u043E\u043C,
      \u043F\u043E\u043A\u0430 \u0441\u0430\u043C \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u043B
      \u0432\u0435\u0434\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390984
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u043D\u043E\u0441\u0438\u0442\u044C \u0435\u0451 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390985
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0446\u044B \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u044B.
      \u041D\u0430\u043A\u043B\u0430\u0434\u043D\u0430\u044F \u0443\u043F\u0430\u043B\u0430
      \u0441 \u044F\u0449\u0438\u043A\u0430. \u0412\u0440\u0435\u043C\u044F \u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0441 \u0447\u0430\u0441\u0430\u043C\u0438, \u0431\u0440\u0430\u0442 \u0432\u0438\u0434\u0435\u043B
      \u044F\u0449\u0438\u043A \u0434\u043E \u0434\u043E\u0436\u0434\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390986
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0438 \u0442\u0432\u043E\u0439
      \u043C\u043B\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442 \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390987
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043F\u043B\u044B\u0432\u0451\u0442. \u041D\u0430
      \u043D\u0435\u0439 \u043F\u0438\u0441\u044C\u043C\u043E \u0442\u0432\u043E\u0435\u0439
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390988
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u043B\u0435\u0436\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u043E \u0434\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390989
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0441\u0430\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B.
      \u0412\u043E\u0442 \u043F\u044B\u043B\u044C \u0438 \u043F\u0435\u0447\u0430\u0442\u044C
      \u0420\u043E\u0437\u044B, \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u044B
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390990
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0418 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u0443\u044E
      \u0432\u043E\u0437\u044C\u043C\u0443. \u041D\u043E\u0440\u0430 \u0441\u0432\u0435\u0440\u0438\u0442
      \u0435\u0451 \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u043B\u0451\u0442\u043D\u043E\u0439
      \u043A\u043D\u0438\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390991
    m_Localized: "\u0421\u0442\u0430\u0440\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043E. \u041A\u043E\u0440\u043D\u0438
      \u043D\u0435 \u0437\u0430\u0434\u0435\u043B\u0438. \u0417\u0430\u0432\u0442\u0440\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u044E, \u043D\u0435 \u043E\u0441\u044B\u043F\u0430\u043B\u0430\u0441\u044C
      \u043B\u0438 \u0437\u0435\u043C\u043B\u044F \u0443 \u043A\u0430\u043D\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390992
    m_Localized: "\u041E\u043D\u0438 \u043F\u043E\u044E\u0442 \u0433\u0440\u043E\u043C\u0447\u0435,
      \u0447\u0435\u043C \u0441\u0432\u0435\u0442\u0438\u0442 \u043C\u043E\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390993
    m_Localized: "\u041C\u043E\u0441\u0442 \u043E\u0441\u0432\u0435\u0449\u0451\u043D.
      \u0421\u0442\u0430\u043C\u0435\u0441\u043A\u0443 \u0441\u0430\u043C\u0430 \u0432\u0435\u0440\u043D\u0443
      \u0412\u0430\u043B\u044C\u0442\u0435\u0440\u0443, \u0430 \u0442\u043E \u043E\u043D
      \u043E\u043F\u044F\u0442\u044C \u043F\u0440\u0438\u0434\u0451\u0442 \u0435\u0451
      \u0438\u0441\u043A\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390994
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438 \u0435\u0433\u043E \u0437\u0430\u043E\u0434\u043D\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u043E\u0441\u0442.
      \u041E\u043D \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A\u043E\u0435
      \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B\u0430
      \u0431\u0443\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390995
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u0434\u043E\u0440\u043E\u0436\u043A\u0443. \u0411\u0435\u043D \u043F\u0440\u0438\u0441\u043B\u0430\u043B
      \u0442\u0435\u043B\u0435\u0436\u043A\u0443 \u0437\u0430 \u0431\u0430\u043D\u043A\u0430\u043C\u0438,
      \u0430 \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438
      \u043F\u0440\u0438\u0432\u0435\u0437\u0451\u0442 \u0432\u043E\u0434\u0443 \u0434\u043B\u044F
      \u0440\u0430\u0441\u0441\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390996
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043B\u0435\u0435\u043A.
      \u041F\u043E\u043C\u043E\u0433\u0443 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0431\u0430\u043D\u043A\u0438 \u043F\u0435\u0440\u0435\u0434 \u0443\u0445\u043E\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390997
    m_Localized: "\u0412\u043E\u0442: \u0432\u043E\u0439\u043B\u043E\u043A \u0434\u043B\u044F
      \u043D\u043E\u0432\u043E\u0439 \u043B\u0438\u043D\u0437\u044B \u0424\u0435\u043B\u0438\u043A\u0441\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u041D\u043E\u0440\u0430 \u043E\u0442\u0432\u0435\u0437\u043B\u0430
      \u043F\u0443\u0441\u0442\u043E\u0439 \u044F\u0449\u0438\u043A \u043A \u0410\u0434\u0435,
      \u0430 \u0442\u0430\u043C \u0437\u0430\u0431\u0440\u0430\u043B\u0430 \u0443\u0436\u0435
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390998
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043E\u0433\u043E\u043D\u044C\u043A\u0438
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u0439\u0434\u0451\u0442
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931390999
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0410\u0434\u0435 \u2014 \u0442\u0440\u0438
      \u0441\u0435\u043C\u0435\u0447\u043A\u0430. \u0422\u0435\u0431\u0435 \u2014
      \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043F\u0438\u044F
      \u0432\u044B\u0434\u0430\u0447\u0438 \u044F\u0449\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391000
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0434\u0440\u0443\u0433
      \u0432 \u043F\u0443\u0442\u0438. \u041C\u043D\u0435 \u044D\u0442\u043E \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391001
    m_Localized: "\u0412\u0441\u0435 \u043F\u0438\u0441\u044C\u043C\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u044B.
      \u0417\u0430 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u043E\u043C \u0431\u0435\u0437
      \u0430\u0434\u0440\u0435\u0441\u0430 \u043F\u0440\u0438\u0448\u043B\u0438 \u0441\u0430\u043C\u0438.
      \u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u043D\u0435 \u0443\u0433\u0430\u0434\u0430\u043B\u0438
      \u0437\u0430 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391002
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435
      \u2014 \u0431\u0430\u0431\u0443\u0448\u043A\u0435. \u0411\u0435\u0440\u0435\u0433\u0438
      \u0435\u0433\u043E \u043E\u0442 \u0434\u043E\u0436\u0434\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391003
    m_Localized: "\u0422\u0432\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u0432
      \u043F\u0443\u0442\u0438. \u042F \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430
      \u0435\u0433\u043E \u0432 \u0441\u0430\u043C\u0443\u044E \u043D\u0430\u0434\u0451\u0436\u043D\u0443\u044E
      \u0441\u0443\u043C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391004
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u044C \u043A\u043E\u043F\u0438\u044E
      \u0443 \u0441\u0435\u0431\u044F. \u042F \u0441\u043D\u0438\u043C\u0443 \u0435\u0451
      \u0434\u043B\u044F \u0410\u0434\u044B: \u043E\u043D\u0430 \u0441\u043A\u0430\u0436\u0435\u0442,
      \u0447\u0442\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391005
    m_Localized: "\u0422\u0435\u043B\u0435\u0433\u0430 \u043F\u0440\u043E\u0448\u043B\u0430.
      \u042F \u0448\u043B\u0430 \u0440\u044F\u0434\u043E\u043C. \u0414\u043B\u0438\u043D\u043D\u0435\u0435
      \u044D\u0442\u043E\u0442 \u043C\u043E\u0441\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0435\u0440\u0435\u043B\u0435\u0442\u0435\u0442\u044C
      \u0434\u044B\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391006
    m_Localized: "\u0415\u0449\u0451 \u0440\u0430\u0437 \u043F\u0440\u043E\u0439\u0434\u0451\u0448\u044C,
      \u0443\u0436\u0435 \u0441 \u043F\u043E\u0447\u0442\u043E\u0439? \u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E
      \u0437\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u043C \u043A\u043E\u043B\u0435\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391007
    m_Localized: "\u041A\u043E\u0440\u0437\u0438\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C!
      \u041C\u043D\u0435 \u0431\u044B \u0442\u043E\u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u043D\u0430\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391008
    m_Localized: "\u041D\u0430\u043F\u0438\u0448\u0438: \xAB\u042F \u0441\u043A\u0443\u0447\u0430\u043B\u0430\xBB.
      \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0447\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391009
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u0436\u0434\u0451\u0442 \u0443
      \u043B\u0430\u0433\u0443\u043D\u044B. \u041E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442
      \u043B\u043E\u0434\u043A\u0438 \u0438\u0437 \u043B\u0438\u0441\u0442\u044C\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391010
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443 \u043C\u043E\u0435\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0432\u0441\u0435\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043F\u0430\u0440\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 592057931391011
    m_Localized: "\u041F\u0440\u0438\u0447\u0430\u043B \u0441\u043D\u043E\u0432\u0430
      \u0446\u0435\u043B\u044B\u0439. \u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u0431\u043B\u0438\u0436\u0435, \u0420\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973888
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C.
      \u041E\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0432\u043E\u0434\u044B
      \u043B\u0430\u043F\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973889
    m_Localized: "\u041E\u0433\u043D\u0438 \u043A\u0430\u043D\u0430\u043B\u0430 \u0433\u043E\u0440\u044F\u0442
      \u0440\u043E\u0432\u043D\u043E. \u0417\u0430\u043F\u0438\u0441\u044C \u043E
      \u044F\u0449\u0438\u043A\u0435 \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B\u0430
      \u0434\u043B\u044F \u0410\u0434\u044B, \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057943973890
    m_Localized: "\u0414\u0432\u0430 \u043E\u0433\u043E\u043D\u044C\u043A\u0430 \u0438\u0437
      \u043E\u0434\u043D\u043E\u0433\u043E. \u0411\u0430\u0431\u0443\u0448\u043A\u0435
      \u0431\u044B \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168192
    m_Localized: "\u0412\u043E\u0434\u044F\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u041B\u043E\u0434\u043E\u0447\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168193
    m_Localized: "\u041C\u0430\u044F\u043A \u0435\u0449\u0451 \u0442\u0451\u043C\u043D\u044B\u0439.
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0431\u0430\u0431\u0443\u0448\u043A\u0430
      \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168194
    m_Localized: "\u0411\u0430\u043A \u043F\u043E\u043B\u043D\u044B\u0439, \u043B\u0438\u043D\u0437\u0430
      \u0447\u0438\u0441\u0442\u0430\u044F. \u0418 \u0432\u043E\u0437\u044C\u043C\u0438
      \u0434\u043B\u044F \u0410\u0434\u044B \u044D\u0442\u0438 \u0437\u0430\u043C\u0435\u0440\u044B.
      \u0424\u0435\u043B\u0438\u043A\u0441 \u043C\u0435\u0440\u0438\u043B \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043A\u0430\u043D\u0430\u043B \u0441 \u043C\u043E\u0435\u0439 \u043B\u043E\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168195
    m_Localized: "\u0411\u0443\u0434\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0437\u0432\u0451\u0437\u0434\u044B \u043F\u043B\u0430\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168196
    m_Localized: "\u041F\u0443\u0442\u044C \u043A \u0430\u0440\u0445\u0438\u0432\u0443
      \u043E\u0441\u0432\u0435\u0449\u0451\u043D. \u0421\u043A\u0430\u0436\u0438
      \u041E\u0441\u043A\u0430\u0440\u0443: \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0435
      \u043F\u0440\u043E\u0448\u0435\u043D\u0438\u044F. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043F\u043E\u043B\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168197
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u041A\u043B\u0430\u0440\u0430.
      \u0412\u0435\u0440\u043D\u0443\u0441\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u0444\u043E\u043D\u0430\u0440\u0438 \u0437\u0430\u0433\u043E\u0440\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168198
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0446\u0435\u043B\u0430.
      \u0424\u0435\u043B\u0438\u043A\u0441 \u0432\u0437\u044F\u043B \u043A\u043B\u044E\u0447
      \u0434\u043E \u0431\u0443\u0440\u0438. \u0417\u0430\u043F\u0438\u0441\u0438
      \u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0435 \u043F\u043E\u043A\u0430
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168199
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B
      \u043F\u0443\u0441\u0442\u044C \u043B\u0435\u0436\u0438\u0442 \u0437\u0434\u0435\u0441\u044C.
      \u0410\u0434\u0435 \u043E\u0442\u043D\u0435\u0441\u0443 \u043A\u043E\u043F\u0438\u044E
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0437\u0430\u043A\u0430\u0437\u043E\u043C
      \u041D\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168200
    m_Localized: "\u041F\u043E\u043B\u043A\u0438 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F.
      \u041A\u043B\u044E\u0447 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D \u043A
      \u0436\u0443\u0440\u043D\u0430\u043B\u0443. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445 \u0442\u0430\u0439\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168201
    m_Localized: "\u041E \u0447\u0451\u043C \u043E\u043D\u0430? \u042F \u0431\u044B
      \u043F\u043E\u0447\u0438\u0442\u0430\u043B\u0430 \u0435\u0451 \u0441 \u0431\u0430\u0431\u0443\u0448\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168202
    m_Localized: "\u0412\u043E\u0442 \u043A\u0430\u0440\u0442\u0430 \u0431\u0443\u0440\u0438.
      \u0421\u043D\u0435\u0436\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432\u0435\u0434\u0451\u0442 \u043F\u0440\u044F\u043C\u043E \u043A \u043C\u0430\u044F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168203
    m_Localized: "\u041D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0434\u0430\u043B\u0435\u043A\u043E.
      \u041D\u043E \u043F\u043E\u0439\u0434\u0451\u043C \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
      \u0448\u0430\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168204
    m_Localized: "\u041F\u0440\u043E\u0448\u0435\u043D\u0438\u044F \u0441\u0443\u0445\u0438\u0435.
      \u041F\u0435\u0440\u0432\u043E\u0439 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u041A\u043B\u0430\u0440\u0430. \u0424\u0435\u043B\u0438\u043A\u0441 \u043D\u0430\u0447\u0435\u0440\u0442\u0438\u043B
      \u043F\u0443\u0442\u044C. \u041E\u0431\u0430 \u043E\u0442\u0432\u0435\u0442\u0430:
      \xAB\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168205
    m_Localized: "\u0410\u0434\u0435 \u043D\u0430\u0434\u043E \u0441\u043D\u043E\u0432\u0430
      \u0438\u0445 \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C. \u041B\u043E\u0434\u043A\u0438
      \u041A\u043B\u0430\u0440\u044B \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
      \u0445\u043E\u0434\u044F\u0442 \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168206
    m_Localized: "\u042D\u0442\u043E \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0438:
      \xAB\u042F \u0436\u0434\u0443. \u041D\u0430 \u043F\u043B\u0438\u0442\u0435
      \u0441\u0443\u043F\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168207
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0435 \u0434\u0430\u0434\u0438\u043C
      \u0435\u043C\u0443 \u043E\u0441\u0442\u044B\u0442\u044C. \u0413\u0434\u0435
      \u041B\u044E\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057948168208
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0430.
      \u0421\u0442\u0430\u0440\u0443\u044E \u0437\u0430\u0447\u0435\u0440\u043A\u043D\u0443\u043B\u0430.
      \u041E\u0441\u043A\u0430\u0440\u0443 \u043F\u043E\u0434\u043F\u0438\u0448\u0443,
      \u0433\u0434\u0435 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0431\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362496
    m_Localized: "\u041F\u043E\u0434\u043F\u0438\u0448\u0438 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443.
      \u0412\u0435\u0440\u043D\u0443 \u041E\u0441\u043A\u0430\u0440\u0443 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362497
    m_Localized: "\u0412 \u043F\u0440\u0438\u044E\u0442\u0435 \u0441\u043D\u043E\u0432\u0430
      \u0442\u0435\u043F\u043B\u043E. \u041C\u043E\u0436\u043D\u043E \u0434\u0430\u0442\u044C
      \u043B\u0430\u043F\u043A\u0430\u043C \u043E\u0442\u0434\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362498
    m_Localized: "\u0421\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
      \u0425\u043E\u0447\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0431\u0430\u0431\u0443\u0448\u043A\u0435 \u043E\u0431\u043E \u0432\u0441\u0435\u0445,
      \u043A\u043E\u0433\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362499
    m_Localized: "\u0410\u0440\u043A\u0430 \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0422\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0448\u044C
      \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u043E\u0442 \u0443\u0436\u0435 \u0431\u0435\u0437
      \u043C\u043E\u0435\u0433\u043E \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362500
    m_Localized: "\u0417\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0448\u044C
      \u0442\u044B. \u0413\u043E\u0442\u043E\u0432\u0430 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362501
    m_Localized: "\u0417\u0430\u043F\u0430\u0441\u043D\u043E\u0435 \u043E\u0434\u0435\u044F\u043B\u043E
      \u0441\u0443\u0445\u043E\u0435 \u0432 \u043F\u0440\u0438\u044E\u0442\u0435.
      \u0415\u0433\u043E \u043E\u0433\u043E\u043D\u044C \u0432\u0438\u0434\u0435\u043D
      \u0441 \u043D\u0438\u0436\u043D\u0435\u0439 \u0442\u0440\u043E\u043F\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362502
    m_Localized: "\u041D\u0430\u043F\u0438\u0448\u0443 \u0411\u0435\u043D\u0443,
      \u0433\u0434\u0435 \u043E\u043D. \u0418 \u0447\u0442\u043E \u043F\u0435\u0440\u0432\u043E\u0435
      \u043E\u0434\u0435\u044F\u043B\u043E \u043D\u0430\u043C \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362503
    m_Localized: "\u0412\u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0430 \u043A
      \u043C\u0430\u044F\u043A\u0443. \u041E\u0442\u0441\u044E\u0434\u0430 \u0432\u0438\u0434\u043D\u043E
      \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E \u043E\u043A\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362504
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0432 \u043E\u043A\u043D\u0435!
      \u041E\u043D\u0430 \u043F\u0440\u0430\u0432\u0434\u0430 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362505
    m_Localized: "\u041C\u043E\u0441\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0435\u043D.
      \u0418\u0434\u0438 \u0441\u044E\u0434\u0430. \u0422\u044B \u0434\u043E\u0436\u0438\u0434\u0430\u0435\u0448\u044C\u0441\u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043E\u0431\u043E\u0438\u0445
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439. \u041A\u0430\u043A
      \u044F \u0443\u0447\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362506
    m_Localized: "\u041B\u0430\u043F\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043D\u0430 \u043F\u0435\u0440\u0438\u043B\u0430\u0445. \u0425\u043E\u0440\u043E\u0448\u043E.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0443\u043C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362507
    m_Localized: "\u0414\u0430. \u0424\u0435\u043B\u0438\u043A\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u043E\u0431\u0430, \u0432\u043E\u0442 \u0435\u0433\u043E \u043F\u043E\u0434\u043F\u0438\u0441\u044C.
      \u041E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0443 \u043D\u0435\u0433\u043E \u0432 \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362508
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0440\u0438\u043C
      \u0435\u0433\u043E \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0441
      \u0437\u0430\u043A\u0430\u0437\u043E\u043C \u041D\u043E\u0440\u044B. \u041A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u043C\u0435\u043D\u044F\u043B \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362509
    m_Localized: "\u0414\u0430, \u0433\u0438\u043B\u044C\u0437\u0430 \u043B\u0438\u043D\u0437\u044B
      \u043C\u043E\u0433\u043B\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0430\u043A\u043E\u0439 \u0441\u043B\u0435\u0434. \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043F\u0443\u0442\u044C \u0433\u0440\u0443\u0437\u0430, \u043D\u043E \u043D\u0435
      \u0430\u0432\u0442\u043E\u0440\u0430 \u0437\u0430\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362510
    m_Localized: "\u0418 \u0441\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u0436\u0443\u0442\u0441\u044F.
      \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0437\u043D\u0430\u044E,
      \u043A\u0430\u043A \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362511
    m_Localized: "\u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0439 \u0444\u043E\u043D\u0430\u0440\u044C
      \u043F\u043E\u0434\u043D\u044F\u0442. \u0422\u0432\u043E\u0439 \u043E\u0433\u043E\u043D\u0451\u043A
      \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057952362512
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u0431\u044B\u043B\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u041D\u043E \u0434\u0440\u0443\u0437\u044C\u044F
      \u0431\u044B\u043B\u0438 \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556800
    m_Localized: "\u041F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0438 \u043C\u0430\u044F\u043A\u0430
      \u0433\u043E\u0442\u043E\u0432\u044B. \u0412\u043E\u0437\u044C\u043C\u0438
      \u043C\u043E\u0439 \u0448\u043D\u0443\u0440 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044F,
      \u0420\u0438\u043D. \u042F \u043E\u0441\u0442\u0430\u044E\u0441\u044C \u043D\u0430
      \u0432\u0430\u0445\u0442\u0435, \u043D\u0435 \u043D\u0430 \u043A\u0430\u043D\u0430\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556801
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u043C\u0430\u0448\u0435\u043C
      \u0432\u0441\u0435\u043C. \u041C\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u043E\u043C\u043E\u0439 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556802
    m_Localized: "\u041B\u0430\u043F\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442.
      \u0414\u0430\u0432\u0430\u0439 \u0432\u044B\u0434\u043E\u0445\u043D\u0435\u043C
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0434\u043E\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556803
    m_Localized: "\u0412\u044B\u0434\u043E\u0445, \u043F\u043E\u0442\u043E\u043C
      \u0448\u0430\u0433. \u042D\u0442\u043E \u044F \u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556804
    m_Localized: "\u0414\u043E\u0441\u043A\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430.
      \u041C\u043E\u0439 \u043C\u043E\u043B\u043E\u0442\u043E\u043A \u0438 \u0442\u0432\u043E\u0451
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u2014 \u0445\u043E\u0440\u043E\u0448\u0430\u044F
      \u043A\u043E\u043C\u0430\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556805
    m_Localized: "\u0422\u0432\u043E\u0439 \u043C\u043E\u043B\u043E\u0442\u043E\u043A
      \u043A\u0443\u0434\u0430 \u0433\u0440\u043E\u043C\u0447\u0435 \u043C\u043E\u0435\u0433\u043E
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556806
    m_Localized: "\u041E\u043F\u044F\u0442\u044C \u0442\u044F\u043D\u0443\u0441\u044C
      \u043A \u0431\u044B\u0441\u0442\u0440\u043E\u043C\u0443 \u0440\u044B\u0447\u0430\u0433\u0443.
      \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u043D\u0438\u0442\u043A\u0430.
      \u0422\u043E\u0447\u043D\u043E. \u041B\u0430\u043F\u044B \u043F\u0440\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057956556807
    m_Localized: "\u041E\u0434\u043D\u0443 \u043B\u0430\u043F\u0443 \u0434\u0435\u0440\u0436\u0438
      \u043D\u0430 \u0442\u043E\u0440\u043C\u043E\u0437\u0435. \u041B\u0438\u0448\u043D\u044F\u044F
      \u043C\u0438\u043D\u0443\u0442\u0430 \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C.
      \u041B\u0438\u0448\u043D\u0435\u0439 \u0442\u0440\u0443\u0431\u044B \u2014
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751104
    m_Localized: "\u0421\u043B\u044B\u0448\u0438\u0448\u044C \u043E\u0442\u0441\u044E\u0434\u0430
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751105
    m_Localized: "\u0414\u0430. \u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751106
    m_Localized: "\u041F\u043E \u043E\u0434\u043D\u043E\u0439 \u0432\u0435\u0442\u043A\u0435.
      \u0422\u0430\u043A \u0440\u0430\u0441\u0442\u0451\u0442 \u0434\u0435\u0440\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751107
    m_Localized: "\u0410 \u043C\u044B \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751108
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u0442\u0438\u0446\u0430
      \u043B\u0435\u0442\u0438\u0442 \u0437\u0430 \u0442\u0432\u043E\u0438\u043C
      \u0444\u043E\u043D\u0430\u0440\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751109
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u043B\u0435\u0442\u0438\u0442.
      \u0414\u043B\u044F \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0434\u0440\u0443\u0433\u0430 \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751110
    m_Localized: "\u0423\u0441\u043F\u0435\u044E \u0441\u043B\u0435\u0442\u0430\u0442\u044C
      \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u043E\u043A\u043E\u0448\u043A\u0443
      \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E, \u043F\u043E\u043A\u0430
      \u043A\u043E\u0440\u0437\u0438\u043D\u0430 \u0441\u044F\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751111
    m_Localized: "\u041E\u0442\u0442\u0443\u0434\u0430 \u044F \u043D\u0435 \u0443\u0432\u0438\u0436\u0443
      \u0442\u0432\u043E\u0439 \u0441\u0438\u0433\u043D\u0430\u043B. \u041F\u043E\u0431\u0443\u0434\u044C,
      \u043F\u043E\u043A\u0430 \u043A\u043E\u0440\u0437\u0438\u043D\u0430 \u043D\u0435
      \u0441\u044F\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751112
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043F\u0438\u0441\u044C\u043C\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E: \xAB\u041F\u0440\u0438\u0445\u043E\u0434\u0438
      \u043D\u0430 \u0447\u0430\u0439\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751113
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u042F
      \u0431\u044B \u043F\u043E\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751114
    m_Localized: "\u041F\u0440\u0443\u0434 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0442\u0438\u0445\u0438\u0439. \u041C\u043E\u0436\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057960751115
    m_Localized: "\u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u0434\u0443\u043C\u0430\u044E
      \u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945408
    m_Localized: "\u042D\u0442\u0430 \u043B\u043E\u0434\u043E\u0447\u043A\u0430 \u0438\u0434\u0451\u0442
      \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u043A\u0430\u043D\u0430\u043B\u043E\u043C.
      \u0412 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0434\u043B\u044F
      \u0435\u0451 \u043A\u0438\u043B\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u0435\u043B\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945409
    m_Localized: "\u041E\u0442\u043C\u0435\u0447\u0443 \u043D\u0430 \u043A\u043E\u043F\u0438\u0438.
      \u0421 \u0431\u0435\u0440\u0435\u0433\u0430 \u044F \u0431\u044B \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0443\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945410
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u044B\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041A\u0430\u043A \u0443 \u043A\u043D\u0438\u0433
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945411
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043C\u0435\u0448\u043D\u0443\u044E
      \u043A\u043D\u0438\u0433\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945412
    m_Localized: "\u042F \u043E\u0442\u043C\u0435\u0442\u0438\u043B \u043D\u0430\u0448\u0435
      \u043C\u0435\u0441\u0442\u043E. \u0414\u043E\u0440\u043E\u0433\u0443 \u043D\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945413
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044F \u0437\u0430\u0431\u044B\u0432\u0430\u044E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945414
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044E \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u044B\u043C
      \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C, \u0447\u0442\u043E \u043F\u0440\u043E\u0439\u0434\u0443
      \u0441\u043F\u0443\u0441\u043A \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945415
    m_Localized: "\u0420\u0430\u0434\u0438 \u043C\u0435\u043D\u044F \u0434\u0435\u0440\u0436\u0438
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438. \u041C\u043D\u0435
      \u043D\u0430\u0434\u043E \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0441 \u0434\u0430\u043B\u044C\u043D\u0438\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945416
    m_Localized: "\u0423\u0448\u0438 \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0432\u0435\u0442\u0435\u0440\u043E\u043A.
      \u041F\u043E\u0434\u043E\u0436\u0434\u0451\u043C, \u043F\u043E\u043A\u0430
      \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945417
    m_Localized: "\u041F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945418
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0430
      \u0442\u0432\u043E\u0439 \u0443\u0437\u0435\u043B, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
      \u0442\u0435\u0431\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C.
      \u0412\u0441\u0451 \u0441\u043F\u0435\u0448\u0438\u043B\u0430 \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945419
    m_Localized: "\u0414\u0430\u0439 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
      \u044D\u0442\u043E\u0442. \u041F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u044C.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945420
    m_Localized: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F.
      \u042F \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945421
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u0441\u0434\u0435\u043B\u0430\u044E
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 592057964945422
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435: {0}. \u041D\u0430\u0447\u043D\u0451\u043C,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 593227919908864
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435.
      \u0418 \u043F\u043E\u0439\u0434\u0451\u043C \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 599985858011136
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0434\u0443\u0435\u0442
      \u0432\u0435\u0442\u0435\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 599985862205440
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0441\u0434\u0432\u0438\u043D\u0443\u043B
      \u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 600492383133696
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0432\u0435\u0441\u044C \u0440\u044F\u0434
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438,
      \u043A\u0430\u043A \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 605650634661888
    m_Localized: "\u041C\u043E\u0440\u043E\u0437\u043D\u0430\u044F \u043A\u043E\u043B\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856192
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u043A \u043A\u043E\u043B\u0431\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0436\u0435 \u0437\u043D\u0430\u043A. \u0411\u043E\u043C\u0431\u0430
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430.
      \u0414\u043E\u0441\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856193
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0430\u0434 \u043C\u043E\u0440\u043E\u0437\u043D\u043E\u0439
      \u043A\u043E\u043B\u0431\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u0443 \u0441
      \u0435\u0451 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438. \u0411\u043E\u043C\u0431\u0430
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442 \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u044D\u0442\u043E\u0442. \u0414\u043E\u0441\u043A\u0430
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 605650638856194
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443
