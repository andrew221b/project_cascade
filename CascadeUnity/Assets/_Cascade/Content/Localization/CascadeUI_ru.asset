    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362909
    m_Localized: "\u041F\u043E\u0434 \u043C\u0430\u044F\u043A\u043E\u043C \u043F\u043E\u0433\u0430\u0441
      \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u0444\u043E\u043D\u0430\u0440\u044C.
      \u0417\u0430\u0436\u0433\u0438 \u0435\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
      \u043D\u0438\u0436\u043D\u0438\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F.
      {0} \u0421\u043F\u0443\u0441\u043A \u0441\u043B\u043E\u0436\u043D\u0435\u0435
