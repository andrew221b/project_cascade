    m_Metadata:
      m_Items: []
  - m_Id: 472899617
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899618
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 472899619
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 472899620
    m_Localized: "\u041E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435. \u041E\u0442\u043F\u0443\u0441\u0442\u0438
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 472899621
    m_Localized: "\u041F\u043E\u0447\u0442\u0438! \u0412\u0435\u0440\u043D\u0438
      \u0445\u043E\u0434 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0435\u0449\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 472899622
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 472899623
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899624
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044C \u0444\u0438\u0433\u0443\u0440\u043A\u0438
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u044C \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 472899625
    m_Localized: "\u041E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0439
      \u043C\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 472899626
    m_Localized: "\u041C\u043E\u0441\u0442 \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 472899627
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 472899628
    m_Localized: "\u041F\u0430\u0443\u0437\u0430. \u041C\u043E\u0436\u043D\u043E
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 472899629
    m_Localized: "\u0415\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 472899630
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C \u0441 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 472899631
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C: {0} \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 472899632
    m_Localized: "\u0422\u043E\u0447\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 472899633
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 472899634
    m_Localized: "\u0420\u044F\u0434 \u0433\u043E\u0442\u043E\u0432. \u041F\u0440\u043E\u0432\u0435\u0440\u044C
      \u0434\u043E\u0441\u043A\u0443 \u043D\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472899635
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E! \u041D\u0430\u0436\u043C\u0438
