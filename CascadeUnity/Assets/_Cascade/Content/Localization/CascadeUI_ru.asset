      \u0434\u043E\u0448\u0451\u043B \u0434\u043E \u043D\u0443\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131328
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u043D\u0430\u043A \u043A \u043A\u043B\u044E\u0447\u0443.
      \u0412\u0435\u0442\u043A\u0430 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131329
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u043D\u0430\u043A \u043A \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C.
      \u041E\u043D\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u043E\u0447\u0438\u043D\u044F\u0442
      \u0434\u043E\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131330
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u043D\u0430\u043A \u043A \u043A\u0430\u0442\u0443\u0448\u043A\u0435.
      \u041F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u043E\u0434\u0438\u043D \u043E\u0431\u043C\u0435\u043D
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0434\u043D\u0443 \u0438\u043B\u0438
      \u0434\u0432\u0435 \u0434\u0435\u0442\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131331
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u043D\u0430\u043A \u043A \u043F\u0435\u0447\u0430\u0442\u0438.
      \u0417\u0430\u043A\u043E\u043D\u0447\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0438 \u0437\u0430\u0431\u0435\u0440\u0438 \u0431\u043E\u043D\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131332
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435 \u0437\u043D\u0430\u043A \u043A \u0447\u0430\u0441\u0430\u043C.
      \u0411\u043E\u043C\u0431\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442
      \u0434\u0432\u0430 \u0445\u043E\u0434\u0430. \u0414\u043E\u0441\u043A\u0430
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131333
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u044D\u0442\u043E\u0442 \u043C\u043E\u0441\u0442
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
      \u0434\u0435\u0442\u0430\u043B\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437.
      \u041F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0445\u043E\u0434 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131334
    m_Localized: "\u042D\u0442\u0438 \u043F\u0430\u0440\u044B \u0441\u0432\u044F\u0437\u0430\u043D\u044B.
      \u041C\u0435\u043D\u044F\u0435\u0448\u044C \u043E\u0434\u043D\u0443 \u2014
      \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0438 \u0434\u0440\u0443\u0433\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131335
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0443 \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u0442\u0440\u0430\u0442\u0438\u0442 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0434\u0435\u0440\u0435\u0432\u0430. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131336
    m_Localized: "\u0412\u0435\u0442\u043A\u0430 \u043C\u0435\u0448\u0430\u0435\u0442
      \u043E\u0431\u043C\u0435\u043D\u0443. \u0412\u044B\u0431\u0435\u0440\u0438
      \u0434\u0440\u0443\u0433\u0443\u044E \u043F\u0430\u0440\u0443 \u0438\u043B\u0438
      \u0441\u043F\u0443\u0441\u043A\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131337
    m_Localized: "\u041D\u0430 \u0434\u043E\u0441\u043A\u0435 \u0441 \u0440\u043E\u043B\u0438\u043A\u0430\u043C\u0438
      \u0432\u0435\u0441\u044C \u0440\u044F\u0434 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E. \u041A\u0440\u0430\u0439\u043D\u044F\u044F
      \u0434\u0435\u0442\u0430\u043B\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131338
    m_Localized: "\u041D\u0430 \u0437\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u043E\u0439
      \u0434\u043E\u0441\u043A\u0435 \u0440\u044F\u0434 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0434\u0435\u0442\u0430\u043B\u044C
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u0435\u0440\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131339
    m_Localized: "\u041F\u0440\u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0434\u0432\u0438\u043D\u0435\u0442 \u0432\u0435\u0441\u044C \u0440\u044F\u0434
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E. \u041F\u0435\u0440\u0435\u0434
      \u0441\u043F\u0443\u0441\u043A\u043E\u043C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 527816348131340
    m_Localized: "\u041F\u043E\u0440\u044B\u0432 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0434\u043E\u0441\u043A\u0438 \u0438 \u0434\u0435\u0442\u0430\u043B\u0438.
      \u041E\u043D\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F \u043D\u0430
      \u043C\u0435\u0441\u0442\u0430. \u0422\u0432\u043E\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
