  - m_Id: 643232714186752
    m_Localized: "\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186753
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u0444\u0435\u0439 \u0438\u043B\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186754
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186755
    m_Localized: "\u041F\u0440\u043E\u0431\u0430: +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186756
    m_Localized: "\u041C\u043E\u043D\u0435\u0442 \u043F\u043E\u043A\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186757
    m_Localized: "\u0414\u0432\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B. \u0414\u0430\u043B\u044C\u0448\u0435
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 643232714186758
    m_Localized: "\u0414\u0432\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      \u0437\u0430 \u044D\u0442\u0430\u043F. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u2014 \u0434\u043E \u0434\u0432\u0443\u0445 \u0437\u0432\u0451\u0437\u0434.
