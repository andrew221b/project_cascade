      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362927
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u0421 \u043F\u043E\u0447\u0442\u043E\u0439
      \u044D\u0442\u043E\u0442 \u0448\u043E\u0432 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0434 \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362928
    m_Localized: "\u0412\u044B\u0433\u0440\u0443\u0436\u0430\u0439 \u043F\u043E\u0447\u0442\u0443.
      \u042F \u043E\u0441\u0432\u0435\u0449\u0443 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443,
      \u043F\u043E\u043A\u0430 \u0442\u044B \u043B\u0430\u0442\u0430\u0435\u0448\u044C
      \u0448\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362929
    m_Localized: "\u0411\u0440\u0430\u0442 \u043F\u043E\u0432\u044F\u0437\u0430\u043B
      \u043A\u0440\u0430\u0441\u043D\u0443\u044E \u043D\u0438\u0442\u043A\u0443 \u043D\u0430
      \u043A\u0440\u0430\u043D. \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0441\u043D\u0438\u043C\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u043E\u0442 \u0446\u0435\u043B\u044B\u0439
      \u0434\u0435\u043D\u044C \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362930
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E.
      \u041F\u043E\u043A\u0430\u0436\u0438 \u0435\u043C\u0443 \u043D\u043E\u0432\u044B\u0439
      \u0432\u0435\u043D\u0442\u0438\u043B\u044C, \u0432\u0434\u0440\u0443\u0433
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362931
    m_Localized: "\u041A\u043E\u0440\u043D\u0438 \u043C\u0435\u0448\u0430\u044E\u0442
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C\u0443 \u0441\u043F\u0443\u0441\u043A\u0443.
      \u041D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0440\u0435\u0437\u0430\u0442\u044C
      \u0436\u0438\u0432\u043E\u0439 \u043A\u043E\u0440\u0435\u043D\u044C \u0440\u0430\u0434\u0438
      \u043F\u0430\u0440\u044B \u043C\u0438\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362932
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E \u0432\u043D\u0435\u0448\u043D\u0435\u043C\u0443
      \u043A\u0430\u043D\u0430\u0442\u0443. \u041F\u043E\u0441\u043B\u0435\u0434\u0438\u0448\u044C
      \u0437\u0430 \u0432\u0435\u0442\u043A\u043E\u0439 \u0443 \u043C\u0435\u043D\u044F
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362933
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043E\u0431\u0435\u0449\u0430\u043B
      \u043F\u0440\u0438\u0439\u0442\u0438. \u0421\u0442\u0430\u043C\u0435\u0441\u043A\u0443
      \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0435\u043C\u0443 \u0443 \u043C\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362934
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0441\u0432\u0435\u0442\u0438\u043C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u043A \u0435\u0433\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0443. \u0415\u043C\u0443
      \u043D\u0430\u0434\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0442\u0440\u0435\u0449\u0438\u043D\u0443
      \u0441 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362935
    m_Localized: "\u0411\u0430\u043D\u043A\u0438 \u0434\u043B\u044F \u0411\u0435\u043D\u0430
      \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u044B. \u0427\u0435\u0440\u0435\u0437
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u043D\u0435 \u0434\u043E\u043D\u0435\u0441\u0442\u0438,
      \u043D\u0443\u0436\u043D\u0430 \u0442\u0435\u043B\u0435\u0436\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362936
    m_Localized: "\u041E\u0441\u0432\u0435\u0449\u0443 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0436\u043A\u0443. \u041F\u043E\u043A\u0430 \u0412\u0430\u043B\u044C\u0442\u0435\u0440
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435,
      \u0431\u0430\u043D\u043A\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043C \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362937
    m_Localized: "\u0412 \u0437\u0430\u043F\u0438\u0441\u0438: \xAB\u041E\u0431\u0438\u0432\u043A\u0430
      \u0434\u043B\u044F \u043B\u0438\u043D\u0437\u044B. \u041F\u0443\u0441\u0442\u043E\u0439
      \u044F\u0449\u0438\u043A \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043D\u0430 \u043C\u0430\u044F\u043A\xBB. \u0427\u0442\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0443\u043A\u0430\u0437\u0430\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362938
    m_Localized: "\u0423 \u041D\u043E\u0440\u044B \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A \u0434\u043B\u044F
      \u0433\u0440\u0443\u0436\u0451\u043D\u043E\u0433\u043E \u044F\u0449\u0438\u043A\u0430.
      \u041F\u0435\u0440\u0435\u043F\u0438\u0448\u0443 \u0435\u0439 \u044D\u0442\u0443
      \u0437\u0430\u043F\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362939
    m_Localized: "\u041F\u0442\u0438\u0446\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u0441\u0432\u0435\u0442\u043B\u043E\u043C\u0443 \u0434\u0435\u0440\u0435\u0432\u0443.
      \u0410 \u044F \u0445\u043E\u0442\u0435\u043B\u0430 \u0441\u043D\u044F\u0442\u044C
      \u0432\u0441\u0435 \u043F\u043B\u043E\u0434\u044B \u043D\u0430 \u0440\u044B\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362940
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u0432\u0435\u0442\u043A\u0435
      \u0445\u0432\u0430\u0442\u0438\u0442 \u0438 \u043D\u0430\u043C, \u0438 \u0433\u043D\u0435\u0437\u0434\u0443.
      \u0412\u0435\u0440\u0445\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362941
    m_Localized: "\u041A\u043E\u043D\u0432\u0435\u0440\u0442 \u0431\u0435\u0437 \u0430\u0434\u0440\u0435\u0441\u0430.
      \u041C\u043E\u0433\u043B\u0430 \u0431\u044B \u0443\u0433\u0430\u0434\u0430\u0442\u044C:
      \u0431\u0443\u043C\u0430\u0433\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362942
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438 \u043D\u0430 \u043F\u043E\u043B\u043A\u0443
      \u0432\u044B\u0434\u0430\u0447\u0438. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043C,
      \u0447\u044C\u0451 \u043E\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362943
    m_Localized: "\xAB\u041F\u0435\u0440\u0435\u0432\u0435\u0437\u0442\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0420\u0435\u043B\u0435 \u043D\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0442\u044C\xBB.
      \u0421\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0434\u043B\u044F \u0410\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362944
    m_Localized: "\u0410\u0434\u0430 \u0443\u0447\u0438\u043B\u0430 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0442\u044C
      \u0438\u0445 \u043F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043E\u043C
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430. \u042D\u0442\u043E
      \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u0438\u043B\u0438 \u0442\u0432\u043E\u044F
      \u043A\u043E\u043F\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362945
    m_Localized: "\u0422\u0435\u043B\u0435\u0433\u0430 \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u043C \u043A\u0440\u0430\u044E.
      \u0421 \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0438\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362946
    m_Localized: "\u0412\u0441\u0442\u0430\u043D\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u0435\u043B\u0435\u0433\u043E\u0439. \u041E\u0441\u0432\u0435\u0449\u0443
      \u043A\u0440\u0430\u0439, \u0447\u0442\u043E\u0431\u044B \u0442\u044B \u0443\u0432\u0438\u0434\u0435\u043B\u0430,
      \u0433\u0434\u0435 \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0435\u0442
      \u043A\u043E\u043B\u0435\u0441\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362947
    m_Localized: "\u0412\u0441\u0451 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E
      \u043C\u0430\u0440\u043A\u0443. \u041B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C
      \u0434\u0430\u0442\u044C \u041A\u043B\u0430\u0440\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362948
    m_Localized: "\u041C\u0430\u0440\u043A\u0430 \u0440\u043E\u0432\u043D\u043E.
      \u041F\u043E\u0441\u0438\u0436\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0437\u0430\u0431\u0435\u0440\u0443\u0442
      \u043A\u043E\u0440\u0437\u0438\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362949
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438
      \u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441 \u0447\u0430\u0441\u0430\u043C\u0438
      \u0411\u0435\u043D\u0430. \u042F\u0449\u0438\u043A \u043B\u0435\u0442\u0435\u043B
      \u0434\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u0431\u0443\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362950
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u0432\u0435\u0434\u0451\u0442 \u0436\u0443\u0440\u043D\u0430\u043B
      \u043B\u043E\u0434\u043E\u043A. \u0421\u043F\u0440\u043E\u0441\u0438\u043C,
      \u0432\u0438\u0434\u0435\u043B\u0430 \u043B\u0438 \u043E\u043D\u0430 \u0442\u043E\u0442
      \u0440\u0435\u0439\u0441 \u0443 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u043A\u0430\u043D\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362951
    m_Localized: "\u041D\u043E\u0440\u0430 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0430
      \u043F\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043B\u043E\u0434\u043A\u0443.
      \u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C.
      \u041D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432
      \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362952
    m_Localized: "\u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0441 \u043B\u043E\u0434\u043A\u043E\u0439.
      \u0410 \u0432\u044B \u043E\u0431\u0435 \u043F\u043E\u0431\u0443\u0434\u044C\u0442\u0435
      \u043D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362953
    m_Localized: "\u0412 \u0436\u0443\u0440\u043D\u0430\u043B\u0435: \u043E\u0433\u043D\u0438
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438, \u043F\u043E\u0442\u043E\u043C
      \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u043B \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F
      \u044F\u0449\u0438\u043A. \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0433\u043E\u0440\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362954
    m_Localized: "\u041E\u0442\u043C\u0435\u0442\u044C \u044D\u0442\u0443 \u0437\u0430\u043F\u0438\u0441\u044C
      \u0434\u043B\u044F \u0410\u0434\u044B. \u0415\u0441\u043B\u0438 \u044D\u0442\u043E
      \u0412\u044B\u0441\u0448\u0438\u0439 \u0424\u043E\u043D\u0430\u0440\u044C,
      \u0441\u0430\u043C \u043E\u0433\u043E\u043D\u044C \u043F\u0435\u0440\u0435\u0436\u0438\u043B
      \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362955
    m_Localized: "\u041C\u0430\u043B\u044B\u0439 \u043F\u0430\u0440\u0443\u0441 \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C. \u041C\u0430\u043C\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u0440\u0438\u0433\u0438\u0431\u0430\u043B\u0430 \u0435\u0433\u043E \u043F\u043E\u0434
      \u0431\u0430\u043B\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362956
    m_Localized: "\u0413\u0434\u0435 \u043E\u043D\u0430 \u043F\u0440\u0438\u0433\u0438\u0431\u0430\u043B\u0430
      \u043F\u0430\u0440\u0443\u0441? \u041E\u0441\u0442\u0430\u0432\u0438\u043C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043B\u043E\u0434\u043A\u0435
      \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362957
    m_Localized: "\u0424\u0435\u043B\u0438\u043A\u0441 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0432\u0435\u0441\u043D\u0443 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B
      \u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C
      \u043E\u0433\u043D\u0435. \u0414\u0443\u043C\u0430\u043B\u0430, \u0443\u0436\u0435
      \u043C\u0430\u0445\u043D\u0443\u043B \u0440\u0443\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362958
    m_Localized: "\u0415\u0433\u043E \u0437\u0430\u043C\u0435\u0440\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C?
      \u0425\u043E\u0447\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044C, \u0433\u0434\u0435
      \u043E\u043D \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043E\u0433\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362959
    m_Localized: "\u041D\u043E\u0440\u0430 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0439\u0442\u0438
      \u043D\u0430 \u0443\u0436\u0438\u043D. \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0447\u0442\u043E\u0432\u0443\u044E
      \u0441\u0443\u043C\u043A\u0443 \u0434\u043E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362960
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0435\u0439 \u0441\u0435\u0439\u0447\u0430\u0441?
      \u041E\u043D\u0430 \u0435\u0449\u0451 \u043D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362961
    m_Localized: "\u0412\u043E\u0442 \u0437\u0430\u0436\u0430\u0442\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430.
      \u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0439 \u0434\u0432\u0435\u0440\u044C,
      \u043D\u0435 \u0442\u044F\u043D\u0438 \u0437\u0430 \u0431\u0443\u043C\u0430\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362962
    m_Localized: "\u041A\u0440\u0430\u0439 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.
      \u041D\u0430\u0434\u043F\u0438\u0441\u044C \u0435\u0449\u0451 \u043C\u043E\u0436\u043D\u043E
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362963
    m_Localized: "\u041A\u043B\u044E\u0447 \u0431\u044B\u043B \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435.
      \u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043E\u0442 \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362964
    m_Localized: "\u041F\u0440\u0438\u0432\u044F\u0436\u0435\u043C \u043A \u0436\u0443\u0440\u043D\u0430\u043B\u0443?
      \u0422\u044B \u0432\u0435\u0434\u044C \u043F\u0435\u0440\u0432\u044B\u043C
      \u0434\u0435\u043B\u043E\u043C \u0438\u0441\u043A\u0430\u043B \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362965
    m_Localized: "\u0412\u043E\u0442: \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u043B\u0438\u043D\u0437\u044B.
      \u041D\u043E\u043C\u0435\u0440 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u0410\u0434\u044B, \u0438\u043C\u044F \u0424\u0435\u043B\u0438\u043A\u0441\u0430.
      \u0421\u0430\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u043E\u043D\u0430
      \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362966
    m_Localized: "\u041D\u043E \u041D\u043E\u0440\u0430 \u0432\u0435\u0437\u043B\u0430
      \u0433\u043E\u0440\u044F\u0449\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u041E\u043D\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0430 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
      \u0438 \u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362967
    m_Localized: "\u041A\u043B\u0430\u0440\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0444\u043E\u043D\u0430\u0440\u0438. \u0424\u0435\u043B\u0438\u043A\u0441
      \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B \u043F\u043B\u0430\u043D \u043B\u0438\u043D\u0437.
      \u041D\u0430 \u043E\u0431\u043E\u0438\u0445 \u0410\u0434\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430:
      \xAB\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362968
    m_Localized: "\u0418 \u0434\u0430\u0442\u044B \u043F\u0435\u0440\u0435\u043F\u0438\u0448\u0438.
      \u0425\u043E\u0447\u0443 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0410\u0434\u0443,
      \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u043F\u0440\u043E\u0448\u0435\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362969
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0431\u0443\u0440\u0438 \u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u043D\u0435 \u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B.
      \u041F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u2014
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0440\u0443\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362970
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u0441 \u041B\u044E\u043C\u0438. \u0415\u0441\u043B\u0438 \u0441\u0442\u0430\u0440\u044B\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0438\u0441\u0447\u0435\u0437, \u0442\u0430\u043A
      \u0438 \u043E\u0442\u043C\u0435\u0442\u0438\u043C \u043D\u0430 \u043A\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362971
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0441\u044F. \u041F\u043E \u043F\u0430\u043C\u044F\u0442\u0438
      \u044F \u043F\u043E\u0432\u0435\u043B\u0430 \u0431\u044B \u043D\u0430\u0441
      \u043F\u0440\u044F\u043C\u043E \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362972
    m_Localized: "\u041E\u0442\u043C\u0435\u0442\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      \u041E\u0441\u043A\u0430\u0440\u0430: \u043F\u0440\u043E\u0445\u043E\u0434\u0430
      \u043D\u0435\u0442. \u041F\u043E\u0439\u0434\u0451\u043C \u043D\u043E\u0432\u043E\u0439
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362973
    m_Localized: "\u041D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u043F\u0440\u044F\u0436\u043A\u0443.
      \u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0432\u0437\u044F\u043B\u0430\u0441\u044C
      \u0437\u0430 \u0442\u0432\u043E\u0439 \u043A\u0430\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362974
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043A\u0430\u043D\u0430\u0442,
      \u0431\u0435\u0440\u0438 \u043E\u0434\u0435\u044F\u043B\u043E. \u0417\u0434\u0435\u0441\u044C
      \u043C\u044B \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B.
      \u041F\u043E\u0434\u043E\u0436\u0434\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362975
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0435\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0446\u0435\u043B\u043E. \u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430 \u0441\u043D\u0438\u0437\u0443,
      \u043D\u0435 \u0441 \u0445\u0440\u0435\u0431\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362976
    m_Localized: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043D\u0438\u043C.
      \u0423\u0447\u0442\u0443 \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u043E\u0442
      \u0438 \u0441\u043F\u0443\u0449\u0443 \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362977
    m_Localized: "\u0423\u043B\u043E\u0436\u0438\u043B\u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0435
      \u043E\u0434\u0435\u044F\u043B\u043E \u043D\u0430\u0434 \u0442\u043E\u043F\u043B\u0438\u0432\u043E\u043C.
      \u0422\u0443\u0442 \u0441\u0443\u0445\u043E. \u0421\u043D\u0430\u0440\u0443\u0436\u0438
      \u043C\u0435\u0442\u0451\u0442, \u0430 \u043F\u0435\u0447\u044C \u0443\u0436\u0435
      \u0442\u0451\u043F\u043B\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362978
    m_Localized: "\u041E\u0442\u043C\u0435\u0447\u0443 \u043F\u0440\u0438\u044E\u0442.
      \u0411\u0435\u043D \u0437\u0430\u0445\u043E\u0447\u0435\u0442 \u0443\u0437\u043D\u0430\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u0434\u043E\u0448\u043B\u0430 \u0435\u0433\u043E
      \u043F\u043E\u0441\u044B\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362979
    m_Localized: "\u0412 \u043E\u0442\u0432\u0435\u0442 \u0434\u0432\u0435 \u0432\u0441\u043F\u044B\u0448\u043A\u0438.
      \u0410\u0434\u0430 \u0432\u0438\u0434\u0438\u0442 \u0442\u0435\u0431\u044F.
      \u041E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0443 \u043E\u043A\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362980
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438 \u0440\u0443\u0447\u043D\u043E\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C. \u0415\u0449\u0451 \u043E\u0434\u043D\u043E
      \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u2014 \u0438
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362981
    m_Localized: "\u0423\u0432\u0438\u0434\u0435\u043B\u0430 \u0442\u0432\u043E\u0439
      \u0441\u0432\u0435\u0442 \u0438 \u0447\u0443\u0442\u044C \u043D\u0435 \u0448\u0430\u0433\u043D\u0443\u043B\u0430
      \u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u0441\u0442.
      \u041F\u0440\u0438\u0432\u044B\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362982
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F \u0443 \u043F\u0435\u0440\u0438\u043B,
      \u0431\u0430\u0431\u0443\u0448\u043A\u0430. \u041F\u043E\u0434\u0430\u043C
      \u0437\u043D\u0430\u043A, \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044E
      \u043E\u0431\u0430 \u043A\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362983
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439
      \u043B\u0438\u043D\u0437\u044B, \u043A\u043B\u044E\u0447 \u0443 \u0424\u0435\u043B\u0438\u043A\u0441\u0430.
      \u041E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0432\u0430
      \u043B\u0438\u0441\u0442\u0430: \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0440\u0430\u0431\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362984
    m_Localized: "\u041D\u043E\u0440\u0430 \u0432\u0438\u0434\u0435\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u043F\u0438\u044E \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0438.
      \u042D\u0442\u0438 \u0434\u0432\u0430 \u043B\u0438\u0441\u0442\u0430 \u0443\u0448\u043B\u0438
      \u0441 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362985
    m_Localized: "\u041D\u0435\u0442. \u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u0440\u0435\u043B\u0435 \u2014 \u043F\u0435\u0440\u0432\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u0422\u043E\u0442,
      \u043A\u0442\u043E \u044D\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B,
      \u0435\u0451 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362986
    m_Localized: "\u0412\u0430\u043B\u044C\u0442\u0435\u0440 \u043D\u0430\u0448\u0451\u043B
      \u043B\u0430\u0442\u0443\u043D\u044C \u043D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445.
      \u041E\u043D\u0430 \u043C\u043E\u0433\u043B\u0430 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u0434\u043B\u044F \u043B\u0438\u043D\u0437\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557184
    m_Localized: "\u0422\u043E\u043D\u043A\u0438\u0439 \u043B\u0443\u0447 \u0438\u0437
      \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u0438. \u0421\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u0430\u044F
      \u043B\u0438\u043D\u0437\u0430 \u043F\u043E\u0439\u043C\u0430\u0435\u0442 \u0435\u0433\u043E
      \u043F\u0440\u0438 \u0432\u0435\u0440\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435
      \u0440\u044F\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557185
    m_Localized: "\u0421\u0442\u0430\u0432\u044C \u043B\u0438\u043D\u0437\u0443 \u0437\u0434\u0435\u0441\u044C.
      \u041F\u043E\u0434\u0432\u0435\u0434\u0443 \u0440\u044F\u0434 \u043A \u044D\u0442\u043E\u043C\u0443
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557186
    m_Localized: "\u042F \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u043F\u0443\u0442\u044C. \u0410 \u041A\u043B\u0430\u0440\u0430 \u0445\u043E\u0434\u0438\u043B\u0430
      \u0438\u043C \u0431\u0435\u0437 \u043E\u0433\u043D\u0435\u0439. \u041D\u0430\u0434\u043E
      \u0431\u044B\u043B\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C,
      \u043A\u0430\u043A \u0435\u0439 \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557187
    m_Localized: "\u0418 \u043F\u0440\u043E \u043A\u0430\u043D\u0430\u043B \u0441\u043F\u0440\u043E\u0441\u0438.
      \u0422\u0430\u043C \u043D\u0438\u0437\u043A\u0430\u044F \u0431\u0430\u043B\u043A\u0430,
      \u0437\u0430 \u043D\u0435\u0451 \u0446\u0435\u043F\u043B\u044F\u043B\u0441\u044F
      \u043C\u0430\u043C\u0438\u043D \u043F\u0430\u0440\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557188
    m_Localized: "\u0421\u0438\u0433\u043D\u0430\u043B \u0440\u043E\u0432\u043D\u044B\u0439.
      \u0411\u0435\u043D \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B \u0442\u0430\u043A\u0443\u044E
      \u0436\u0435 \u043F\u043E\u043B\u043E\u043C\u043A\u0443 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435.
      \u0415\u0433\u043E \u0440\u044B\u0447\u0430\u0433 \u0442\u0443\u0442 \u043D\u0438
      \u043F\u0440\u0438 \u0447\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557189
    m_Localized: "\u0417\u0430\u043F\u0438\u0448\u0438 \u044D\u0442\u043E \u043D\u0430
      \u0435\u0433\u043E \u0441\u0445\u0435\u043C\u0435. \u041E\u043D \u0434\u043E
      \u0441\u0438\u0445 \u043F\u043E\u0440 \u0434\u0443\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0441\u043B\u043E\u043C\u0430\u043B \u0432\u0441\u044E
      \u0446\u0435\u043F\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557190
    m_Localized: "\u041D\u043E\u0440\u0430 \u0432\u0438\u0434\u0438\u0442 \u0442\u0451\u043C\u043D\u044B\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A. \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u043B\u0443\u0447 \u043A\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F \u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0434\u043E \u0446\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557191
    m_Localized: "\u041D\u0438\u0436\u043D\u0435\u0435 \u0440\u0435\u043B\u0435 \u2014
      \u0442\u0443\u0434\u0430. \u041D\u043E\u0440\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442
      \u0435\u0449\u0451 \u0440\u0430\u0437, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0442\u0440\u043E\u043D\u0435\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557192
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u043F\u0438\u0441\u044C\u043C\u0430
      \u044F \u0443\u0436\u0435 \u0437\u043D\u0430\u043B. \u041F\u043E\u0441\u043B\u0430\u043B
      \u0442\u043E, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F
      \u043A\u043E\u043B\u0435\u0441\u0430. \u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E
      \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u0438 \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557193
    m_Localized: "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435.
      \u041F\u043E\u043B\u043E\u0436\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0445\u0435\u043C\u043E\u0439.
      \u041F\u0440\u043E\u0447\u0442\u0443, \u043F\u043E\u043A\u0430 \u0442\u044B
      \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557194
    m_Localized: "\u041F\u0438\u043B\u043E\u0442 \u0443 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430.
      \u042F \u043D\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B \u0440\u0435\u043B\u0435
      \u0440\u0430\u0434\u0438 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u043B\u0443\u0447\u0430. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0435\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557195
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0442\u043A\u0443, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0441\u043D\u043E\u0432\u0430 \u0435\u0433\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E\u0442 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A.
      \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0441\u0438\u0433\u043D\u0430\u043B\u043E\u043C
      \u041D\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557196
    m_Localized: "\u041D\u043E\u0440\u0430 \u0432\u0438\u0434\u0438\u0442 \u0447\u0438\u0441\u0442\u044B\u0439
      \u043F\u0443\u0442\u044C. \u041A\u043B\u0430\u0440\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
      \u043E\u0433\u043D\u0438 \u043D\u0430 \u0432\u043E\u0434\u0435. \u041C\u043E\u0436\u043D\u043E
      \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557197
    m_Localized: "\u041F\u043E \u043C\u043E\u0435\u043C\u0443 \u0441\u0438\u0433\u043D\u0430\u043B\u0443.
      \u0410\u0434\u0430 \u0443 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0430.
      \u041D\u043E\u0440\u0430, \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u0440\u043E\u0432\u0435\u0440\u044C
      \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u043E\u0433\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557198
    m_Localized: "\u0422\u0432\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u0440\u0438\u0448\u043B\u043E
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0442\u0435\u0431\u044F. \u042F \u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u0435\u0433\u043E \u0440\u044F\u0434\u043E\u043C \u0441 \u0444\u043E\u043D\u0430\u0440\u0451\u043C
      \u0443 \u043E\u043A\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557199
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C
      \u0438\u0445 \u0438\u043C\u0435\u043D\u0430. \u0425\u043E\u0447\u0443 \u0432\u0430\u0441
      \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557200
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u041B\u044E\u043C\u0438
      \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0448\u043A\u0430\u0444\u043E\u043C.
      \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u0442\u0430\u043A \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044E \u043F\u0443\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557201
    m_Localized: "\u041E\u0441\u0442\u0440\u043E\u0432\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435,
      \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u0435 \u0433\u0440\u0443\u0437\u044B
      \u2014 \u0444\u0438\u0433\u0443\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557202
    m_Localized: "\u0414\u0440\u0443\u0433\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
      \u043D\u0430\u0448\u0435\u0433\u043E \u043D\u0435\u0431\u0430. \u0417\u0434\u0435\u0441\u044C
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B \u0435\u0449\u0451 \u0436\u0434\u0443\u0442
      \u0441\u0432\u043E\u0435\u0433\u043E \u0440\u0435\u043C\u043E\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557203
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u0442\u043E, \u0447\u0435\u043C\u0443 \u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C.
      \u041D\u043E \u0437\u0434\u0435\u0448\u043D\u0438\u0435 \u043C\u043E\u0441\u0442\u044B
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0430\u0434\u043E
      \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557204
    m_Localized: "\u0422\u0435 \u0436\u0435 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u2026
      \u043D\u043E \u0442\u0430\u043C, \u0433\u0434\u0435 \u0431\u044B\u043B\u0438
      \u0444\u0438\u0433\u0443\u0440\u044B, \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0438\u0441\u044F\u0442 \u0431\u0443\u043A\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557205
    m_Localized: "\u041F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E. \u0417\u0434\u0435\u0441\u044C \u0433\u0440\u0443\u0437
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432
      \u0441\u043B\u043E\u0432\u0430, \u0438 \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0441\u0432\u043E\u0451 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557206
    m_Localized: "\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u043C\u043D\u044E.
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442 \u044D\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044F
      \u043D\u0430\u0448\u0435\u0433\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557207
    m_Localized: "\u0424\u0438\u0433\u0443\u0440\u044B \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0431\u0443\u043A\u0432\u0430\u043C\u0438! \u0411\u0443\u0434\u0442\u043E
      \u0434\u0432\u0430 \u043D\u0430\u0448\u0438\u0445 \u043D\u0435\u0431\u0430
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557208
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u0443\u0442\u044C,
      \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u0432\u0438\u0434\u0430\u043C\u0438
      \u0433\u0440\u0443\u0437\u0430. \u0417\u043D\u0430\u043A\u043E\u043C\u044B\u0435
      \u043B\u0438\u0446\u0430 \u0435\u0449\u0451 \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0437\u0430\u0433\u0430\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557209
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0411\u0443\u0434\u0435\u043C
      \u0438\u0441\u043A\u0430\u0442\u044C \u043D\u043E\u0432\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
      \u0430 \u043D\u0435 \u0438\u0434\u0442\u0438 \u043F\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0441\u0442\u0430\u0440\u044B\u043C \u0441\u043B\u0435\u0434\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557210
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u0444\u0438\u0433\u0443\u0440\u044B.
      \u042F \u0443\u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0438\u0437\u0433\u0438\u0431
      \u043C\u043E\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557211
    m_Localized: "\u0422\u0432\u043E\u0451 \u043C\u0435\u0441\u0442\u043E \u0437\u0434\u0435\u0441\u044C.
      \u0414\u0440\u0443\u0433\u043E\u0435 \u043D\u0435\u0431\u043E \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442,
      \u043F\u043E\u043A\u0430 \u043C\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043C
      \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0435\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557212
    m_Localized: "\u041C\u044B \u0441\u043D\u043E\u0432\u0430 \u0441\u0440\u0435\u0434\u0438
      \u0431\u0443\u043A\u0432. \u042F \u043F\u043E\u043C\u043D\u044E, \u0433\u0434\u0435
      \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557213
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0431\u043E\u0439\u0434\u0451\u043C\u0441\u044F
      \u0431\u0435\u0437 \u043D\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432.
      \u0423 \u043D\u0430\u0441 \u0435\u0449\u0451 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043D\u0435\u0434\u043E\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557214
    m_Localized: "\u0411\u0443\u043A\u0432\u044B \u0438 \u0444\u0438\u0433\u0443\u0440\u044B
      \u0441\u043D\u043E\u0432\u0430 \u0432\u043C\u0435\u0441\u0442\u0435. \u042D\u0442\u043E
      \u0442\u043E\u0442 \u043F\u0443\u0442\u044C, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043C\u044B \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984206557215
    m_Localized: "\u0422\u0432\u043E\u0439 \u0444\u043E\u043D\u0430\u0440\u044C \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0441\u0432\u0435\u0442\u0438\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1807274946322432
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0432\u0445\u043E\u0434
      \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u0438\u043B\u0438
      \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u0435 \u0435\u0433\u043E \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1807274950516736
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u0432\u0445\u043E\u0434\u0430 \u0438\u0441\u0442\u0435\u043A\u043B\u043E.
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1807274950516737
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0439\u0442\u0438.
      \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1807274950516738
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1827980845244416
    m_Localized: "\u041F\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1827980849438720
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0443\u0436\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043D\u0430\u0434 \u043F\u0438\u043B\u043E\u0439.
      \u041E\u043D\u0430 \u0441\u043F\u0438\u043B\u0438\u0442 \u0432\u0435\u0442\u043A\u0443
      \u0438 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1827980849438721
    m_Localized: "\u041F\u043E\u0434\u0432\u0435\u0434\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043A \u043F\u0438\u043B\u0435. \u041E\u043D\u0430
      \u0441\u043F\u0438\u043B\u0438\u0442 \u0432\u0435\u0442\u043A\u0443 \u0438
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u043E\u0431\u043C\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1828625455243264
    m_Localized: "\u0412\u0435\u0442\u043A\u0430 {0} \u0441\u043F\u0438\u043B\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1838801105182720
    m_Localized: "\u041B\u044E\u0431\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442:
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 2 \u0437\u0432\u0435\u0437\u0434\u044B.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C {0}/2 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439
      \u043D\u0430 \u044D\u0442\u0430\u043F\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377024
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u044D\u0442\u0430\u043F\u0435
      \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B
      \u0434\u0432\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430.
      \u041C\u043E\u0436\u043D\u043E \u0441\u043D\u043E\u0432\u0430 \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u044D\u0442\u0430\u043F\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377025
    m_Localized: "\u041B\u0430\u043C\u043F\u043E\u0447\u043A\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0445\u043E\u0434, \u0430 \u0434\u0435\u043B\u0430\u0435\u0448\u044C \u0435\u0433\u043E
      \u0442\u044B. \u0421\u0447\u0451\u0442\u0447\u0438\u043A \u2014 \u043D\u0430
      \u044D\u0442\u043E\u0442 \u044D\u0442\u0430\u043F. \u041A\u043E\u0433\u0434\u0430
      \u043E\u043D \u043F\u0443\u0441\u0442, \u0437\u0430 \u0432\u0438\u0434\u0435\u043E
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0435\u0449\u0451 \u043E\u0434\u043D\u0443 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377026
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0445\u043E\u0434\u044B \u043D\u0430 \u044D\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435.
      \u0421\u043B\u0435\u0434\u0443\u0439 \u0437\u0430 \u0440\u0443\u043A\u043E\u0439:
      \u0444\u0438\u0433\u0443\u0440\u044B \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0448\u044C
      \u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377027
    m_Localized: "\u041B\u0443\u043F\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u044F\u0434 \u043F\u043E\u0441\u043B\u0435 \u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u044D\u0444\u0444\u0435\u043A\u0442\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0434\u043E\u0441\u043A\u0438.
      \u0424\u0438\u0433\u0443\u0440\u044B \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377028
    m_Localized: "\u0424\u043E\u043D\u0430\u0440\u044C \u0434\u0435\u043B\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0445\u043E\u0434 \u0437\u0430 \u0442\u0435\u0431\u044F. \u0420\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D \u0444\u043E\u043D\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377029
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u0432\u0443\u0445 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0445
      \u043E\u0442\u043C\u0435\u043D \u043A\u0430\u0442\u0443\u0448\u043A\u0430 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442
      \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0445\u043E\u0434 \u043D\u0430
      \u044D\u0442\u043E\u0439 \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377030
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u0434\u043E\u0441\u043A\u0443: \u0440\u044F\u0434 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377031
    m_Localized: "\u0421\u0443\u043C\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0438 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.
      \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0435\u0433\u043E. \u041D\u0430 \u044D\u0442\u0430\u043F \u2014 \u0434\u0432\u0430
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F; \u043B\u044E\u0431\u043E\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043E\u0446\u0435\u043D\u043A\u0443 \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0432\u0443\u043C\u044F
      \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377032
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377033
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377034
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377035
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0432\u0438\u0434\u0435\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043E\u0434\u0438\u043D
      \u0445\u043E\u0434. \u0425\u043E\u0434 \u0434\u0435\u043B\u0430\u0435\u0448\u044C
      \u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377036
    m_Localized: "\u0412\u0438\u0434\u0435\u043E: +1 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377037
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0433\u043E\u0442\u043E\u0432\u0430.
      \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377038
    m_Localized: "\u0412\u0438\u0434\u0435\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E.
      \u0415\u0441\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438, \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0441\u044F
      \u0438\u043C\u0438; \u0438\u043D\u0430\u0447\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u043E\u0442\u043C\u0435\u043D\u0443 \u0438\u043B\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1838801109377039
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0438\u0437 \u0441\u0443\u043D\u0434\u0443\u043A\u043E\u0432.
      \u041D\u0435\u043B\u044C\u0437\u044F \u043A\u0443\u043F\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
