      \u0431\u0443\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476316
    m_Localized: "\u042D\u0442\u0438 \u043F\u043E\u043B\u043A\u0438 \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F
      \u043F\u0430\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476317
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E
      \u043D\u0430 \u043E\u0431\u0430 \u043A\u0440\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476318
    m_Localized: "\u0412\u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476319
    m_Localized: "\u041C\u0430\u044F\u043A \u0434\u0430\u043B\u0435\u043A\u043E.
      \u041D\u043E \u043C\u044B \u0437\u043D\u0430\u0435\u043C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476320
    m_Localized: "\u041A\u0430\u043F\u043B\u044F \u0434\u043E\u0436\u0434\u044F \u0443\u043F\u0430\u043B\u0430
      \u043D\u0430 \u043B\u0438\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476321
    m_Localized: "\u041C\u043E\u0439 \u0448\u0430\u0440\u0444 \u0435\u0433\u043E
      \u0443\u043A\u0440\u043E\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476322
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u043C\u043D\u0435 \u0437\u0430\u043F\u0438\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476323
    m_Localized: "\u0425\u0432\u0430\u0442\u0438\u0442 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u0448\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476324
    m_Localized: "\u041C\u043E\u0438 \u043B\u0430\u043F\u043A\u0438 \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49797246476325
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0432\u0438\u0436\u0443
      \u0442\u0451\u043F\u043B\u0443\u044E \u043B\u0430\u043C\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670592
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u0430\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0434\u043E\u043C\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670593
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u043C \u0441\u0442\u0443\u043F\u0435\u043D\u0438
      \u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670594
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u0430\u0440\u043A\u0430
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u0435\u0441\u044C \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670595
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0434\u0443\u043C\u0430\u044E
      \u043E \u043F\u043E\u0441\u0430\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670596
    m_Localized: "\u041F\u0438\u043F \u043F\u043E\u0441\u043B\u0430\u043B \u043D\u0430\u043C
      \u043E\u0434\u0435\u044F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670597
    m_Localized: "\u041E\u043D \u043F\u043E\u043C\u043D\u0438\u0442, \u0447\u0442\u043E
      \u044F \u043C\u0451\u0440\u0437\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670598
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670599
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u0432\u0438\u0436\u0443
      \u043C\u0430\u044F\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670600
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u043E\u0441\u0442
      \u043E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670601
    m_Localized: "\u041C\u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E.
      \u041D\u043E \u0434\u0440\u0443\u0437\u044C\u044F \u0441\u043E \u043C\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670602
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0443 \u0444\u043E\u043D\u0430\u0440\u0435\u0439
      \u043D\u0443\u0436\u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670603
    m_Localized: "\u042F \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043E\u0441\u043E\u043A. \u0418 \u044D\u0442\u0443 \u0441\u043C\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670604
    m_Localized: "\u041E\u0433\u043E\u043D\u0451\u043A \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670605
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0438\u0434\u0451\u0442 \u043E\u0434\u0438\u043D \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49797250670606
    m_Localized: "\u042F \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u0430 \u043D\u0430\u0448
