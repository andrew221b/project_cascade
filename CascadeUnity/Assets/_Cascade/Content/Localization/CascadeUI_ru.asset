    m_Localized: "{0} \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489219325952
    m_Localized: "\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489240297472
    m_Localized: "\u0423\u0441\u043B\u043E\u0432\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489240297473
    m_Localized: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489240297474
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u0430 \u0441\u0430\u0439\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489240297475
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1590489240297476
    m_Localized: "\u0414\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u043A \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0443. \u041C\u043E\u043D\u0435\u0442\u044B
      \u043D\u0435 \u0442\u0440\u0430\u0442\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1619703867891712
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984198168576
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u0430\u044F\u043A \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442,
      \u043D\u0435 \u0445\u043E\u0434\u0438 \u043F\u043E \u0432\u0435\u0440\u0445\u043D\u0438\u043C
      \u043C\u043E\u0441\u0442\u0430\u043C. \u042F \u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u0441\u0432\u0435\u0442 \u0432 \u043E\u043A\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362880
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0431\u0430\u0431\u0443\u0448\u043A\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u0430\u044F\u043A \u043F\u043E\u0433\u0430\u0441.
      \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362881
    m_Localized: "\u0413\u0440\u0443\u0437\u043E\u0432\u044B\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u043D\u0438\u043A\u0438
      \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442. \u041D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u0441\u043F\u0443\u0441\u043A\u0435 \u0433\u0440\u0443\u0437
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442 \u043F\u043E \u043C\u0435\u0442\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362882
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u044F \u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0443
      \u0433\u0440\u0443\u0437 \u043F\u043E \u043F\u0443\u0442\u0438 \u0432\u043D\u0438\u0437,
      \u0430 \u0442\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u0448\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362883
    m_Localized: "\u0414\u0430. \u041F\u0440\u0438\u0451\u043C\u043D\u0438\u043A
      \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442 \u0433\u0440\u0443\u0437
      \u0432\u0440\u0430\u0437\u043D\u043E\u0431\u043E\u0439. \u0410 \u0441\u0442\u0430\u0440\u044B\u0435
      \u0434\u043E\u0441\u043A\u0438 \u0434\u043E\u043B\u0433\u043E \u043D\u0435
      \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362884
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0438 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0432\u043D\u0438\u0437\u0443. \u042F \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044E
      \u0442\u0435\u0431\u0435 \u043F\u0435\u0440\u0432\u0443\u044E \u043F\u0430\u0440\u0442\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362885
    m_Localized: "\u042F \u0420\u0438\u043D. \u0411\u0430\u0431\u0443\u0448\u043A\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0443 \u043F\u043E\u0433\u0430\u0441\u0448\u0435\u0433\u043E
      \u043C\u0430\u044F\u043A\u0430. \u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043A \u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362886
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u0434\u0435\u0440\u0436\u0438\u0442 \u0433\u0440\u0443\u0437 \u0438 \u043D\u0435
      \u0442\u0435\u0447\u0451\u0442. \u041D\u043E\u0440\u0430 \u0437\u0430\u0431\u0435\u0440\u0451\u0442
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0438 \u043C\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0431\u0440\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362887
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u043E\u0440? \u0421
      \u0442\u0430\u043A\u043E\u0439 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439
      \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.
      \u042F \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u044E \u0437\u0430
      \u043B\u043E\u0434\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362888
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0443 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0438\u0445. \u0410 \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044E
      \u0441\u0432\u043E\u0451 \u043F\u0438\u0441\u044C\u043C\u043E \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362889
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u043C
      \u0435\u0433\u043E \u0432 \u043D\u0443\u0436\u043D\u0443\u044E \u0441\u0443\u043C\u043A\u0443.
      \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0433\u0440\u0443\u0437, \u043F\u043E\u043A\u0430 \u0432\u0435\u0442\u0435\u0440
      \u043D\u0435 \u0443\u0441\u0438\u043B\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362890
    m_Localized: "\u041A\u043E\u043F\u0438\u044F \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u0447\u0438\u043A\u0430.
      \u041F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u0438 \u0433\u0440\u0443\u0437\u0435.
      \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430 \u043F\u0435\u0447\u0430\u0442\u044C
      \u0410\u0434\u044B \u0438 \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430,
      \u0437\u0430\u0447\u0435\u043C \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0440\u0435\u043B\u0435 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362891
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u043B\u0430\u0433\u0443\u043D\u044B
      \u0433\u043E\u0442\u043E\u0432\u044B. \u041C\u043E\u044F \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F
      \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u044F\u0449\u0438\u043A \u043D\u0430
      \u0441\u0435\u0432\u0435\u0440 \u0434\u043E \u0431\u0443\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362892
    m_Localized: "\u041A\u043D\u0438\u0433\u0443 \u0432\u043E\u0437\u044C\u043C\u0438
      \u0441 \u0441\u043E\u0431\u043E\u0439. \u041F\u043E\u043F\u0440\u043E\u0441\u0438\u043C
      \u041A\u043B\u0430\u0440\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u044D\u0442\u0443 \u0437\u0430\u043F\u0438\u0441\u044C \u043D\u0430 \u043F\u0440\u0438\u0447\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362893
    m_Localized: "\u041F\u0440\u0438\u0447\u0430\u043B \u0434\u0435\u0440\u0436\u0438\u0442.
      \u041F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u041D\u043E\u0440\u0443
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F. \u041E\u043D\u0430 \u0441\u043D\u044F\u043B\u0430
      \u0441\u0443\u043C\u043A\u0443, \u0435\u0449\u0451 \u043D\u0435 \u0434\u043E\u0441\u043B\u0443\u0448\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362894
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0437\u0430\u0436\u0433\u0443 \u0438
      \u0444\u043E\u043D\u0430\u0440\u044C \u0443 \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438.
      \u0421\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u043F\u0438\u0441\u044C\u043C\u043E \u041D\u043E\u0440\u044B, \u043D\u0435
      \u0434\u0435\u0440\u0436\u0430 \u043C\u043E\u0439 \u0432 \u043B\u0430\u043F\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362895
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0441\u043D\u0435\u0433\u043E\u0432
      \u0433\u043E\u0442\u043E\u0432\u0430. \u0423 \u043F\u0443\u0441\u0442\u043E\u0433\u043E
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043C\u043E\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044C.
      \u041B\u044E\u043C\u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441
      \u0441\u0432\u043E\u0438\u043C \u0437\u0430\u043C\u0435\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362896
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u043D\u0443 \u043A\u043E\u043F\u0438\u0438
      \u043E\u0442 \u0432\u043E\u0434\u044B. \u041B\u044E\u043C\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u0430 \u0442\u0435\u0431\u0435
      \u0432\u0435\u0440\u043D\u0451\u043C \u043A\u0430\u0440\u0442\u0443 \u0441
      \u0435\u0451 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362897
    m_Localized: "\u041F\u0435\u0440\u0435\u0447\u043D\u044F \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442. \u0423 \u0410\u0434\u044B
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430 \u043E \u0432\u044B\u0434\u0430\u0447\u0435
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F, \u043F\u043E
      \u043D\u0435\u0439 \u043D\u0430\u0439\u0434\u0451\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0440\u0430\u0431\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362898
    m_Localized: "\u0410\u0434\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.
      \u0424\u043E\u043D\u0430\u0440\u0438 \u043C\u043E\u0441\u0442\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0438\u0434\u043D\u044B \u0438\u0437 \u0435\u0451 \u043E\u043A\u043D\u0430,
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u0442 \u043D\u0430\u0441
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362899
    m_Localized: "\u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435.
      \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u043F\u0435\u0440\u0435\u0432\u0430\u043B,
      \u0435\u0439 \u043D\u0430\u0434\u043E \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C,
      \u043A\u0430\u043A\u0438\u0435 \u0442\u0440\u043E\u043F\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362900
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0439 \u043A\u043E\u043D\u0435\u0446
      \u043E\u0441\u0442\u0430\u0432\u044C \u0441\u0435\u0431\u0435. \u0415\u0441\u043B\u0438
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C \u043D\u0430
      \u043F\u043E\u043B\u043F\u0443\u0442\u0438, \u0436\u0434\u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u0430.
      \u042F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362901
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0436\u0434\u0451\u0442 \u0442\u0430\u043C.
      \u0421\u043E\u0435\u0434\u0438\u043D\u044E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0440\u0435\u043B\u0435 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044E
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362902
    m_Localized: "\u041D\u0430 \u043D\u0438\u0436\u043D\u0435\u0439 \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u043E\u0439
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435 \u0442\u0435\u043C\u043D\u043E.
      \u0417\u0430\u0436\u0433\u0438 \u0444\u043E\u043D\u0430\u0440\u044C, \u0447\u0442\u043E\u0431\u044B
      \u044F \u0437\u0430\u043C\u0435\u043D\u0438\u043B \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043D\u043D\u044B\u0435
      \u043F\u0435\u0440\u0438\u043B\u0430. {0} \u0421\u043F\u0443\u0441\u043A \u0441\u043B\u043E\u0436\u043D\u0435\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E, \u0432 \u0442\u0440\u0438
      \u044D\u0442\u0430\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1626984202362903
    m_Localized: "\u041F\u043E\u0434 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
