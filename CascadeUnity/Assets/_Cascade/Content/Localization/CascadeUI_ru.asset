    m_Metadata:
      m_Items: []
  - m_Id: 371952031096844
    m_Localized: "\u041A \u0443\u0440\u043E\u0432\u043D\u044E {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096845
    m_Localized: "\u0417\u0430\u0436\u0438\u0433\u0430\u0439 \u043E\u0433\u043E\u043D\u044C\u043A\u0438
      \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u0434\u0435\u0442\u0430\u043B\u0438
      \u0434\u043B\u044F \u0442\u0440\u043E\u0444\u0435\u0435\u0432 \u041C\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096846
    m_Localized: "\u041C\u043E\u0438 \u0432\u0435\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096847
    m_Localized: "\u0412 \u044D\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B \u0443\u0436\u0435 \u043D\u0435\u0442.
      \u041C\u043E\u0436\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0438\u0433\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096848
    m_Localized: "\u041D\u0430\u0447\u0430\u043B\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096849
    m_Localized: "\u0414\u043E \u0431\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096850
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043E\u0433\u043E\u043D\u0451\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096851
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0434\u043E\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096852
    m_Localized: "\u041A \u043A\u0430\u0440\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096853
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0441\u043B\u0435\u0434\u0438\u043B\u0430
      \u0437\u0430 \u0411\u043E\u043B\u044C\u0448\u0438\u043C \u043C\u0430\u044F\u043A\u043E\u043C.
      \u0415\u0433\u043E \u0441\u0432\u0435\u0442 \u043F\u043E\u043C\u043E\u0433\u0430\u043B
      \u0432\u0441\u0435\u043C \u043D\u0430\u0439\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096854
    m_Localized: "\u0411\u0443\u0440\u044F \u0441\u043B\u043E\u043C\u0430\u043B\u0430
      \u043C\u043E\u0441\u0442\u044B \u0438 \u043F\u043E\u0433\u0430\u0441\u0438\u043B\u0430
      \u043C\u0430\u044F\u043A. \u041C\u0438\u043A\u0430 \u0443\u0441\u043F\u0435\u043B\u0430
      \u0441\u043F\u0430\u0441\u0442\u0438 \u043E\u0434\u0438\u043D \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096855
    m_Localized: "\u041C\u0438\u043A\u0430: \u042F \u0434\u043E\u043D\u0435\u0441\u0443
      \u043E\u0433\u043E\u043D\u0451\u043A, \u0431\u0430\u0431\u0443\u0448\u043A\u0430.
      \u041F\u043E\u0447\u0438\u043D\u0438\u043C \u043C\u043E\u0441\u0442\u044B,
      \u043F\u043E\u043C\u043E\u0436\u0435\u043C \u0434\u0440\u0443\u0437\u044C\u044F\u043C
      \u0438 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0436\u0436\u0451\u043C
      \u043C\u0430\u044F\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096856
    m_Localized: "\u041D\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u0411\u043E\u043B\u044C\u0448\u043E\u0439
      \u043C\u0430\u044F\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096857
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 404348818415616
    m_Localized: "\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0445
      \u043F\u0430\u0443\u0437. \u0418 \u0442\u0440\u043E\u0444\u0435\u0438 \u0434\u043B\u044F
      \u041C\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609920
    m_Localized: "\u0422\u0440\u043E\u0444\u0435\u0438 \u043C\u043E\u0436\u043D\u043E
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0432 \u0438\u0433\u0440\u0435.
      \u041F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0447\u0442\u043E-\u043B\u0438\u0431\u043E
      \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609921
    m_Localized: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435
      \u043F\u0430\u0443\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609922
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0437\u0430\u043A\u0440\u044B\u0442.
      \u0412\u0441\u0451 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609923
    m_Localized: "\u041E\u0434\u043D\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0430
      \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435
      \u043F\u0430\u0443\u0437\u044B. \u0412\u0438\u0434\u0435\u043E \u0437\u0430
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443 \u2014 \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609924
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435 \u043F\u0430\u0443\u0437\u044B
      \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u044B. \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0437\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 \u0438\u0433\u0440\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609925
    m_Localized: "\u0416\u0434\u0451\u043C \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043D\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0443. \u041C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0438\u0433\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609926
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437 \u0438\u043B\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
      \u043F\u043E\u043A\u0443\u043F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609927
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043F\u043E\u043A\u0443\u043F\u043A\u0443.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609928
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609929
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609930
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043F\u043E\u043A\u0443\u043F\u043A\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609931
    m_Localized: "\u0421\u043A\u043E\u0440\u043E \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609932
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043F\u043E\u043A\u0443\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 404348822609933
    m_Localized: "\u041A \u0438\u0433\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 449412512866304
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0435\u0449\u0451 \u0440\u0430\u0437."
