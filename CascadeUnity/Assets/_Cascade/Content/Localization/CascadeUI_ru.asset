  - m_Id: 1266322150252545
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C: +100 \u043E\u0447\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252546
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u0444\u0438\u0433\u0443\u0440\u0443
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u043E\u0431\u0435 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u043C\u0435\u043D \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252547
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0443\u0436\u043D\u0443\u044E
      \u0444\u0438\u0433\u0443\u0440\u0443 \u043D\u0430\u0434 \u044F\u0449\u0438\u043A\u043E\u043C.
      \u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u0442
      \u0435\u0449\u0451 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0434\u043E\u0432,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043E
      \u043D\u0430 \u044F\u0449\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252548
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0443\u0436\u043D\u0443\u044E
      \u0444\u0438\u0433\u0443\u0440\u0443 \u043D\u0430\u0434 \u043A\u043B\u044E\u0447\u043E\u043C.
      \u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F \u0441\u0432\u044F\u0437\u044C
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252549
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0443\u0436\u043D\u0443\u044E
      \u0444\u0438\u0433\u0443\u0440\u0443 \u043D\u0430\u0434 \u0431\u043E\u043C\u0431\u043E\u0439
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043E\u0442\u0441\u0447\u0451\u0442\u0430.
      \u0412\u0437\u0440\u044B\u0432 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252550
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043B\u0435\u043D\u0442\u0443
      \u043D\u0443\u0436\u043D\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u043E\u0439.
      \u0417\u0430\u0442\u0435\u043C \u043E\u0434\u0438\u043D \u0440\u0430\u0437
      \u043E\u0431\u043C\u0435\u043D\u044F\u0439 \u0434\u0432\u0435 \u0444\u0438\u0433\u0443\u0440\u044B
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u0434\u043E
      \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252551
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u043E\u043B\u0431\u0443
      \u0445\u043E\u043B\u043E\u0434\u0430. \u0411\u043E\u043C\u0431\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442
      \u0434\u0432\u0430 \u043E\u0431\u043C\u0435\u043D\u0430, \u043D\u043E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252552
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0443\u0436\u043D\u0443\u044E
      \u0444\u0438\u0433\u0443\u0440\u0443 \u043D\u0430\u0434 \u043F\u0435\u0447\u0430\u0442\u044C\u044E:
      \u044D\u0442\u043E \u0434\u0430\u0441\u0442 100 \u043E\u0447\u043A\u043E\u0432.
      \u0412\u043D\u0438\u0437\u0443 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u044B\u0439
      \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252553
    m_Localized: "\u042D\u0442\u0430 \u0441\u0432\u044F\u0437\u044C \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437. \u041F\u0440\u043E\u0434\u0443\u043C\u0430\u0439
      \u0440\u044F\u0434 \u0437\u0430\u0440\u0430\u043D\u0435\u0435: \u043F\u043E\u0441\u043B\u0435
      \u043E\u0431\u043C\u0435\u043D\u0430 \u043E\u043D\u0430 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252554
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0439 \u043E\u0434\u043D\u0443
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u0430\u0440\u0443
      \u2014 \u043E\u0431\u0435 \u043F\u0430\u0440\u044B \u043F\u043E\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
      \u0432\u043C\u0435\u0441\u0442\u0435. \u041E\u0434\u0438\u043D \u0445\u043E\u0434
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0447\u0435\u0442\u044B\u0440\u0435 \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252555
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0443\u044E
      \u0441\u0432\u044F\u0437\u044C \u0442\u0440\u0430\u0442\u0438\u0442 \u0434\u0432\u0435
      \u0435\u0434\u0438\u043D\u0438\u0446\u044B \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438
      \u0432\u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252556
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0437\u0430\u043A\u0440\u044B\u0442\u0443\u044E
      \u0441\u0432\u044F\u0437\u044C \u043E\u0431\u043C\u0435\u043D \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D.
      \u0421\u043F\u0443\u0441\u0442\u0438\u0441\u044C \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443
      \u0441 \u043D\u0443\u0436\u043D\u044B\u043C\u0438 \u0441\u0432\u044F\u0437\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252557
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435
      \u0440\u044F\u0434 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0437\u0430\u0434\u043E\u043C \u043D\u0430\u043F\u0435\u0440\u0451\u0434.
      \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0434
      \u0441\u043F\u0443\u0441\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252558
    m_Localized: "\u041F\u0440\u0438 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0438
      \u0432\u0435\u0441\u044C \u0440\u044F\u0434 \u0441\u0434\u0432\u0438\u043D\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E \u043F\u043E
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435. \u041A\u0440\u0430\u0439\u043D\u044F\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430 \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u0442
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1266322150252559
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E
      \u0447\u0438\u0441\u043B\u0430 \u043E\u0431\u043C\u0435\u043D\u043E\u0432 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0434\u0432\u0438\u043D\u0435\u0442 \u0432\u0435\u0441\u044C \u0440\u044F\u0434
      \u043D\u0430 \u043E\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E. \u0423\u0447\u0442\u0438
      \u044D\u0442\u043E \u0432 \u0441\u0432\u043E\u0451\u043C \u043F\u043B\u0430\u043D\u0435."
