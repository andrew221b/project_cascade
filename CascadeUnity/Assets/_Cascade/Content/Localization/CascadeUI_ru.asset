  - m_Id: 371952031096834
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096835
    m_Localized: "\u0412\u043E \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u043C
      \u0438\u0433\u0440\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096836
    m_Localized: "\u041F\u0443\u0442\u044C \u041C\u0438\u043A\u0438. \u0424\u0438\u0433\u0443\u0440\u044B
      \u0438 \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096837
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0444\u0438\u0433\u0443\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096838
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0441\u043B\u043E\u0432\u043E
      \u0438\u0437 \u0431\u0443\u043A\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096839
    m_Localized: "\u0424\u0438\u0433\u0443\u0440\u044B \u0438 \u0431\u0443\u043A\u0432\u044B
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096840
    m_Localized: "\u0423\u0440\u043E\u0432\u043D\u0438: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096841
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043D\u043E\u043C\u0435\u0440.
      \u041B\u0438\u0441\u0442\u0430\u0439 \u0443\u0440\u043E\u0432\u043D\u0438 \u0441\u0432\u0430\u0439\u043F\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096842
    m_Localized: "\u041B\u0438\u0441\u0442 {0} \u0438\u0437 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 371952031096843
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C: \u0443\u0440\u043E\u0432\u0435\u043D\u044C
